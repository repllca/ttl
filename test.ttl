; ==============================================================================
; Tera Term 4.0x系互換：起動時保存先ポップアップ選択 ＆ 踏み台多段SSH収集マクロ
; ==============================================================================

getdir BASE_DIR
sprintf '%s\config.ini' BASE_DIR
INI_FILE = inputstr
sprintf '%s\hosts.csv' BASE_DIR
HOST_FILE = inputstr
sprintf '%s\commands.txt' BASE_DIR
CMD_FILE = inputstr

; --- 1. config.ini から設定読み込み（getinistr 不使用の4.0x互換パース） ---
call load_config_ini

; SaveDir が空欄ならマクロ配下の logs を初期値にする
strlen DEF_LOG_DIR
if result = 0 then
    sprintf '%s\logs' BASE_DIR
    DEF_LOG_DIR = inputstr
endif

; --- 2. 毎回起動時に保存先ディレクトリをポップアップで選択・入力 ---
inputbox 'ログを保存するディレクトリのフルパスを入力してください（存在しない場合は自動作成されます）:' 'ログ保存先ディレクトリの選択' DEF_LOG_DIR
LOG_DIR = inputstr

; キャンセルまたは空欄でOKされた場合は安全に終了
strlen LOG_DIR
if result = 0 then
    messagebox '保存先が指定されなかったため処理を中断します。' '中断'
    end
endif

; 末尾に '\' が付いていたら除去する（パス結合の二重スラッシュ防止）
strlen LOG_DIR
DIR_LEN = result
strcopy LOG_DIR DIR_LEN 1 LAST_CHAR
strcompare LAST_CHAR '\'
if result = 0 then
    strcopy LOG_DIR 1 DIR_LEN - 1 LOG_DIR
endif

; 指定されたフォルダが存在しない場合に備えて Windows の mkdir で自動作成（4.0x互換）
sprintf 'cmd.exe /c if not exist "%s" mkdir "%s"' LOG_DIR LOG_DIR
exec inputstr
mpause 500

; 実行IDとサマリCSVの初期化（書き込みテストも兼ねる）
getdate RUN_ID '%Y%m%d_%H%M%S'
sprintf '%s\summary_%s.csv' LOG_DIR RUN_ID
SUMMARY_FILE = inputstr

fileopen sum_fh SUMMARY_FILE 0
if sum_fh = -1 then
    sprintf '指定された保存先ディレクトリを作成できないか、書き込み権限がありません:\n%s' LOG_DIR
    messagebox inputstr 'フォルダエラー'
    end
endif
filewriteln sum_fh 'Timestamp,Hostname,IP,FinalPrompt,Status,Detail'
fileclose sum_fh

; hosts.csv オープン
fileopen host_fh HOST_FILE 0 1
if host_fh = -1 then
    messagebox 'hosts.csv が見つかりません。' 'エラー'
    end
endif

enablekeyb 0

; --- 3. 踏み台モードの場合、最初に踏み台サーバーへ1回だけログイン ---
strcompare USE_BASTION '1'
if result = 0 then
    sprintf '%s:%s /ssh2 /nosecuritywarning /auth=password /user=%s /passwd=%s' BASTION_HOST BASTION_PORT BASTION_USER BASTION_PASS
    CONN_STR = inputstr
    connect CONN_STR
    if result <> 2 then
        fileclose host_fh
        enablekeyb 1
        messagebox '踏み台サーバーへの接続に失敗しました。' '踏み台エラー'
        end
    endif

    timeout = 15
    wait BASTION_PROMPT '$' '#' '>'
    if result = 0 then
        disconnect 0
        fileclose host_fh
        enablekeyb 1
        messagebox '踏み台サーバーのプロンプト待機でタイムアウトしました。' '踏み台エラー'
        end
    endif
endif

; ------------------------------------------------------------------------------
; 4. メインループ：hosts.csv を1行ずつ処理
; ------------------------------------------------------------------------------
while 1
    filereadln host_fh line
    if result = 1 then
        break
    endif

    strlen line
    LINE_LEN = result
    strscan line '#'
    COMMENT_POS = result

    if LINE_LEN > 0 and COMMENT_POS <> 1 then
        CSV_SRC = line
        call parse_csv_5

        if CSV_OK = 1 then
            IP_ADDR  = CSV_COL1
            HOSTNAME = CSV_COL2
            USER     = CSV_COL3
            PASS     = CSV_COL4
            EN_PASS  = CSV_COL5

            call process_node
        endif
    endif
endwhile

fileclose host_fh

; 踏み台接続中なら最後に踏み台からもログアウトして切断
strcompare USE_BASTION '1'
if result = 0 then
    sendln 'exit'
    mpause 500
    disconnect 0
endif

enablekeyb 1
sprintf 'すべての機器のログ取得が完了しました。\n保存先: %s' LOG_DIR
messagebox inputstr '完了'
end


; ==============================================================================
; サブルーチン：config.ini 読み込み（Tera Term 4.0.1 互換・getinistr代替）
; ==============================================================================
:load_config_ini
    USE_BASTION    = '0'
    BASTION_HOST   = ''
    BASTION_PORT   = '22'
    BASTION_USER   = ''
    BASTION_PASS   = ''
    BASTION_PROMPT = '$'
    DEF_LOG_DIR    = ''

    fileopen ini_fh INI_FILE 0 1
    if ini_fh = -1 then
        messagebox 'config.ini が見つかりません。' '設定エラー'
        end
    endif

    while 1
        filereadln ini_fh ini_line
        if result = 1 then
            break
        endif

        strlen ini_line
        INI_LEN = result

        if INI_LEN > 0 then
            strcopy ini_line 1 1 FIRST_CHAR
            strcompare FIRST_CHAR ';'
            IS_CMT = result
            strcompare FIRST_CHAR '['
            IS_SEC = result

            if IS_CMT <> 0 and IS_SEC <> 0 then
                strscan ini_line '='
                EQ_POS = result
                if EQ_POS > 1 then
                    strcopy ini_line 1 EQ_POS - 1 INI_KEY
                    VAL_LEN = INI_LEN - EQ_POS
                    if VAL_LEN > 0 then
                        strcopy ini_line EQ_POS + 1 VAL_LEN INI_VAL
                    else
                        INI_VAL = ''
                    endif

                    strcompare INI_KEY 'UseBastion'
                    if result = 0 then
                        USE_BASTION = INI_VAL
                    endif
                    strcompare INI_KEY 'Host'
                    if result = 0 then
                        BASTION_HOST = INI_VAL
                    endif
                    strcompare INI_KEY 'Port'
                    if result = 0 then
                        BASTION_PORT = INI_VAL
                    endif
                    strcompare INI_KEY 'User'
                    if result = 0 then
                        BASTION_USER = INI_VAL
                    endif
                    strcompare INI_KEY 'Pass'
                    if result = 0 then
                        BASTION_PASS = INI_VAL
                    endif
                    strcompare INI_KEY 'Prompt'
                    if result = 0 then
                        BASTION_PROMPT = INI_VAL
                    endif
                    strcompare INI_KEY 'SaveDir'
                    if result = 0 then
                        DEF_LOG_DIR = INI_VAL
                    endif
                endif
            endif
        endif
    endwhile

    fileclose ini_fh
return


; ==============================================================================
; サブルーチン：カンマ区切りCSVを5つに分割
; ==============================================================================
:parse_csv_5
    CSV_OK = 0
    CSV_COL1 = ''
    CSV_COL2 = ''
    CSV_COL3 = ''
    CSV_COL4 = ''
    CSV_COL5 = ''
    WORK_STR = CSV_SRC

    strscan WORK_STR ','
    if result = 0 then
        return
    endif
    POS = result
    strcopy WORK_STR 1 POS - 1 CSV_COL1
    strlen WORK_STR
    strcopy WORK_STR POS + 1 result - POS WORK_STR

    strscan WORK_STR ','
    if result = 0 then
        return
    endif
    POS = result
    strcopy WORK_STR 1 POS - 1 CSV_COL2
    strlen WORK_STR
    strcopy WORK_STR POS + 1 result - POS WORK_STR

    strscan WORK_STR ','
    if result = 0 then
        return
    endif
    POS = result
    strcopy WORK_STR 1 POS - 1 CSV_COL3
    strlen WORK_STR
    strcopy WORK_STR POS + 1 result - POS WORK_STR

    strscan WORK_STR ','
    if result = 0 then
        return
    endif
    POS = result
    strcopy WORK_STR 1 POS - 1 CSV_COL4
    strlen WORK_STR
    REM_LEN = result - POS
    if REM_LEN > 0 then
        strcopy WORK_STR POS + 1 REM_LEN CSV_COL5
    endif

    CSV_OK = 1
return


; ==============================================================================
; サブルーチン：1台ごとの接続（踏み台経由 / 直結両対応）〜ログ取得〜離脱
; ==============================================================================
:process_node
    STATUS = 'NG'
    DETAIL = ''
    FINAL_SYM = 'Unknown'
    IS_LOG_OPEN = 0

    strcompare USE_BASTION '1'
    if result = 0 then
        ; --- 【A】踏み台経由での多段SSHログイン ---
        testlink
        if result = 0 then
            DETAIL = 'Bastion Session Lost'
            call write_summary
            return
        endif

        sprintf 'ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null %s@%s' USER IP_ADDR
        sendln inputstr

        timeout = 15
        wait 'assword:' 'yes/no' 'refused' 'timed out' 'No route' 'Permission denied' '>' '#' '$' ']'
        if result = 1 then
            sendln PASS
        elseif result = 2 then
            sendln 'yes'
            wait 'assword:'
            sendln PASS
        elseif result >= 3 and result <= 6 then
            DETAIL = 'Hop SSH Connect Failed'
            wait BASTION_PROMPT '$' '#'
            call write_summary
            return
        elseif result = 0 then
            DETAIL = 'Hop SSH Timeout'
            send #3
            wait BASTION_PROMPT '$' '#'
            call write_summary
            return
        endif
    else
        ; --- 【B】直結モードでのSSHログイン ---
        sprintf '%s:22 /ssh2 /nosecuritywarning /auth=password /user=%s /passwd=%s' IP_ADDR USER PASS
        CONN_STR = inputstr
        connect CONN_STR
        if result <> 2 then
            DETAIL = 'Direct SSH Connect Failed'
            call write_summary
            return
        endif
    endif

    ; --- 2. 全パターン網羅の特権昇格＆ページ送り無効化 ---
    call ensure_privileged_mode
    if PREP_OK = 0 then
        call safe_logout
        call write_summary
        return
    endif

    ; --- 3. クリーンログ取得開始 ---
    sprintf '%s\%s_%s.log' LOG_DIR RUN_ID HOSTNAME
    DEV_LOG = inputstr
    logopen DEV_LOG 0 0
    IS_LOG_OPEN = 1

    ; --- 4. commands.txt を1行ずつ実行 ---
    fileopen cmd_fh CMD_FILE 0 1
    if cmd_fh = -1 then
        DETAIL = 'commands.txt Not Found'
        call safe_logout
        call cleanup_and_summary
        return
    endif

    CMD_OK = 1
    while 1
        filereadln cmd_fh cmd_line
        if result = 1 then
            break
        endif

        strlen cmd_line
        CMD_LEN = result
        strscan cmd_line ';'
        CMD_CMT = result

        if CMD_LEN > 0 and CMD_CMT <> 1 then
            sprintf #13#10'==================== [ %s ] ====================' #13#10 cmd_line
            logwrite inputstr

            sendln cmd_line

            while 1
                timeout = 30
                wait FINAL_SYM '--More--' '-- More --' '---(more)---' 'Press any key'
                if result = 1 then
                    break
                elseif result >= 2 and result <= 5 then
                    send ' '
                else
                    DETAIL = 'Command Output Timeout'
                    CMD_OK = 0
                    break
                endif
            endwhile

            if CMD_OK = 0 then
                break
            endif
        endif
    endwhile
    fileclose cmd_fh

    ; --- 5. 多段階ログアウト・切断 ---
    call safe_logout

    if CMD_OK = 1 then
        STATUS = 'OK'
        DETAIL = 'Success'
    endif

    call cleanup_and_summary
return


; ==============================================================================
; サブルーチン：全パターンを突破して特権モード＆ページャー無効化する
; ==============================================================================
:ensure_privileged_mode
    PREP_OK = 0

    ; 【関門1】初期画面突破
    timeout = 15
    while 1
        wait '>' '#' '$' '%' ']' 'User:' 'login:' 'assword:' 'Press any key' '(y/n)'
        if result >= 1 and result <= 5 then
            INIT_SYM_IDX = result
            break
        elseif result = 6 or result = 7 then
            sendln USER
        elseif result = 8 then
            sendln PASS
        elseif result = 9 then
            sendln ''
        elseif result = 10 then
            sendln 'n'
        else
            DETAIL = 'Initial Prompt Timeout'
            return
        endif
    endwhile

    ; 【関門2】特権モードへの昇格
    if INIT_SYM_IDX <> 2 then
        sendln 'enable'
        timeout = 5
        wait 'assword:' '#' 'Invalid' 'Unknown' 'not found' 'Error' 'syntax' '>' '$'
        
        if result = 1 then
            strlen EN_PASS
            if result > 0 then
                sendln EN_PASS
            else
                sendln ''
            endif
            
            timeout = 5
            wait '#' ']' 'assword:' 'denied' 'Invalid' 'failed' '>'
            if result <> 1 and result <> 2 then
                DETAIL = 'Enable Authentication Failed'
                return
            endif

        elseif result = 2 then
            ; パスワードなしで '#' 昇格完了
        elseif result >= 3 and result <= 7 then
            wait '>' '$' '%' ']' '#'
            strlen EN_PASS
            if result > 0 then
                sendln 'administrator'
                timeout = 3
                wait 'assword:' '#' 'Error' 'Invalid' '>'
                if result = 1 then
                    sendln EN_PASS
                    wait '#' '>'
                endif
            endif
        elseif result = 0 then
            DETAIL = 'Enable Command Timeout'
            return
        endif
    endif

    ; 【関門3】ページ送り無効化の総当たり
    timeout = 2

    sendln 'terminal length 0'
    wait '#' '>' '$' '%' ']'

    sendln 'set cli screen-length 0'
    wait '#' '>' '$' '%' ']'

    sendln 'screen-length 0 temporary'
    wait '#' '>' '$' '%' ']'

    sendln 'console lines infinity'
    wait '#' '>' '$' '%' ']'

    sendln 'config paging disable'
    wait '#' '>' '$' '%' ']'

    ; 最終プロンプト記号の確定
    timeout = 5
    sendln ''
    wait '#' '>' '$' '%' ']'
    if result = 0 then
        DETAIL = 'Final Prompt Check Failed'
        return
    endif

    if result = 1 then
        FINAL_SYM = '#'
    elseif result = 2 then
        FINAL_SYM = '>'
    elseif result = 3 then
        FINAL_SYM = '$'
    elseif result = 4 then
        FINAL_SYM = '%'
    elseif result = 5 then
        FINAL_SYM = ']'
    endif

    PREP_OK = 1
return


; ==============================================================================
; サブルーチン：確実ログアウト（踏み台モード時は踏み台セッションを殺さない）
; ==============================================================================
:safe_logout
    send #3
    mpause 200

    strcompare USE_BASTION '1'
    IS_BASTION = result

    for i 1 3
        if IS_BASTION <> 0 then
            testlink
            if result = 0 then
                break
            endif
        endif

        if i = 1 then
            sendln 'exit'
        elseif i = 2 then
            sendln 'quit'
        else
            sendln 'logout'
        endif

        timeout = 2
        if IS_BASTION = 0 then
            wait BASTION_PROMPT 'Save' 'save' '(y/n)' '[y/n]' 'Are you sure' '>' '#' '$' ']'
            if result = 1 then
                break
            elseif result = 2 or result = 3 then
                sendln 'n'
                mpause 300
            elseif result >= 4 and result <= 6 then
                sendln 'y'
                mpause 300
            endif
        else
            wait 'Save' 'save' '(y/n)' '[y/n]' 'Are you sure' '>' '#' '$' ']'
            if result = 1 or result = 2 then
                sendln 'n'
                mpause 300
            elseif result >= 3 and result <= 5 then
                sendln 'y'
                mpause 300
            endif
        endif
    next

    if IS_BASTION = 0 then
        sendln ''
        mpause 200
        send '~.'
        mpause 500
        sendln ''
        wait BASTION_PROMPT '$' '#'
    else
        testlink
        if result <> 0 then
            disconnect 0
            mpause 300
        endif
    endif
return


; ==============================================================================
; ユーティリティ群
; ==============================================================================
:cleanup_and_summary
    if IS_LOG_OPEN = 1 then
        logclose
    endif
    call write_summary
return

:write_summary
    getdate TS '%Y/%m/%d %H:%M:%S'
    fileopen sum_fh SUMMARY_FILE 1
    sprintf '%s,%s,%s,%s,%s,%s' TS HOSTNAME IP_ADDR FINAL_SYM STATUS DETAIL
    filewriteln sum_fh inputstr
    fileclose sum_fh
return
