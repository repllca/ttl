; ==============================================================================
; ネットワーク機器・サーバ 参照系ログ自動収集マクロ [分割版 / Tera Term 5.x (5.4.1対応)]
; ==============================================================================
; 構成 (役割ごとにモジュール分割・各ファイル約65〜350行):
;   runner.ttl            … 本ファイル（ユーザー設定・全体フロー・device.csvループ・結果記録）
;   lib\init.ttl          … 起動設定・パス解決・ログフォルダ/CSV準備・踏み台SSH接続
;   lib\auth.ttl          … 認証候補選択 (device.csv / credentials.csv)・SSH/Telnet 2段階ログイン
;   lib\exec_device.ttl   … 特権昇格(enable/administrator)・ページング解除・コマンド実行・切断
;   lib\abort_bastion.ttl … 認証失敗/タイムアウト時の安全な踏み台復帰 (SSH/Telnet)
; ==============================================================================

; --- 1. ユーザー設定 ---
BASTION_HOST   = '192.168.1.1'
BASTION_PORT   = '22'
BASTION_USER   = 'bastion_user'
BASTION_PROMPT = '$'

SSH_EXTRA_OPTS = '-o ConnectTimeout=5'
DEF_CSV_NAME   = 'device.csv'
DEF_CRED_NAME  = 'credentials.csv'
DEF_LOG_NAME   = 'logs'
DEF_CMD_NAME   = 'commands_universal.txt'

FALLBACK_TO_CRED_FILE    = 0        ; 1: device.csv固有PW失敗時にcredentials.csvも試行
FALLBACK_TO_BASTION_CRED = 0        ; 0: 空欄時に踏み台ユーザーを自動流用しない(推奨)
LOGIN_TIMEOUT       = 12            ; ログイン待機最大秒数
CMD_TIMEOUT         = 30            ; コマンド応答待機最大秒数
AUTH_RETRY_INTERVAL = 1             ; 認証失敗後の再試行間隔(秒)
DEVICE_INTERVAL     = 1             ; 機器間の待機間隔(秒)

; 共通定数 & ライブラリパス定義
getdir BASE_DIR
CRLF = #13#10
TRIM_WS = ' '
strconcat TRIM_WS #9#13#10
TRIM_FIELD = TRIM_WS
strconcat TRIM_FIELD '"'
CMT_CHARS  = '#;'
VALID_ENDS = '#>$]'
BAD_STARTS = '%!^'
HDR_DEV    = '|ホスト名|ホスト|機器名|hostname|host|'
HDR_CRED   = '|ユーザー名|ユーザ名|username|user|'

sprintf2 LIB_INIT  '%s\lib\init.ttl'          BASE_DIR
sprintf2 LIB_AUTH  '%s\lib\auth.ttl'          BASE_DIR
sprintf2 LIB_EXEC  '%s\lib\exec_device.ttl'   BASE_DIR
sprintf2 LIB_ABORT '%s\lib\abort_bastion.ttl' BASE_DIR

; --- 2. 起動初期化・踏み台接続 (lib\init.ttl) ---
include LIB_INIT

; --- 3. 機器一覧CSV (device.csv) メインループ ---
TOTAL_COUNT = 0
OK_COUNT    = 0
NG_COUNT    = 0
DEV_NAME    = '(起動中)'
DEV_IP      = '-'
DEV_PROTO   = '-'
DEV_STATUS  = 'NG'
DEV_DETAIL  = '-'
F_CRED_OPEN = 0
IS_LOG_OPEN = 0
IS_DEVICE_LOGGED_IN = 0
BASTION_LOST = 0

fileopen f_csv CSV_FILE 0 1
if f_csv = -1 then
    messagebox '機器一覧CSVを開けませんでした。' 'エラー'
    if ALREADY_CONNECTED = 0 then
        sendln 'exit'
        disconnect 0
    endif
    end
endif
CSV_EOF = 0

:read_csv_loop
testlink
if result <> 2 goto bastion_disconnected
if CSV_EOF = 1 goto end_csv_loop
line = ''
filereadln f_csv line
if result = 1 then
    CSV_EOF = 1
    strlen line
    if result = 0 goto end_csv_loop
endif

; BOM除去・空白トリム・コメント行スキップ
call clean_csv_line
if CL_SKIP = 1 goto read_csv_loop

; 7列一括分解 & 各列トリム
strsplit line ',' 7
DEV_NAME   = groupmatchstr1
DEV_IP     = groupmatchstr2
DEV_USER   = groupmatchstr3
DEV_PASS   = groupmatchstr4
DEV_ENPASS = groupmatchstr5
DEV_PROTO  = groupmatchstr6
DEV_CMD    = groupmatchstr7
strtrim DEV_NAME   TRIM_FIELD
strtrim DEV_IP     TRIM_FIELD
strtrim DEV_USER   TRIM_FIELD
strtrim DEV_PASS   TRIM_FIELD
strtrim DEV_ENPASS TRIM_FIELD
CMT_VAL = DEV_PROTO
call strip_comment
DEV_PROTO = CMT_VAL
CMT_VAL = DEV_CMD
call strip_comment
DEV_CMD = CMT_VAL

; 4列短縮形式 (ホスト名,IP,ssh,commands_xxx.txt) の自動救済
strlen DEV_ENPASS
L5 = result
strlen DEV_PROTO
L6 = result
strlen DEV_CMD
L7 = result
if L5 = 0 && L6 = 0 && L7 = 0 then
    NORM_PROTO = DEV_USER
    call normalize_proto
    strlen NORM_PROTO
    if result > 0 then
        C4_OK = 0
        strlen DEV_PASS
        if result = 0 then
            C4_OK = 1
        else
            strscan DEV_PASS '.txt'
            if result > 0 then
                C4_OK = 1
            endif
        endif
        if C4_OK = 1 then
            DEV_PROTO = NORM_PROTO
            DEV_CMD   = DEV_PASS
            DEV_USER  = ''
            DEV_PASS  = ''
        endif
    endif
endif

; ヘッダ行・IP空欄スキップ
tolower H_NAME DEV_NAME
sprintf2 H_CHK '|%s|' H_NAME
strscan HDR_DEV H_CHK
if result > 0 goto read_csv_loop
strlen DEV_IP
if result = 0 goto read_csv_loop

TOTAL_COUNT = TOTAL_COUNT + 1
strlen DEV_NAME
if result = 0 then
    DEV_NAME = DEV_IP
endif

; プロトコル・コマンドファイル解決
NORM_PROTO = DEV_PROTO
call normalize_proto
ORIG_DEV_PROTO = NORM_PROTO
strlen ORIG_DEV_PROTO
if result = 0 then
    HAS_ORIG_PROTO = 0
    DEV_PROTO = 'ssh'
else
    HAS_ORIG_PROTO = 1
    DEV_PROTO = ORIG_DEV_PROTO
endif

strlen DEV_CMD
if result = 0 then
    DEV_CMD = DEFAULT_CMD
else
    strscan DEV_CMD '\'
    if result = 0 then
        strscan DEV_CMD '/'
        if result = 0 then
            strscan DEV_CMD ':'
            if result = 0 then
                sprintf2 DEV_CMD '%s\%s' BASE_DIR DEV_CMD
            endif
        endif
    endif
endif

; 機器処理用ステート初期化
DEV_STATUS       = 'NG'
DEV_DETAIL       = 'Unknown'
LAST_FAIL_DETAIL = ''
FINAL_PROMPT     = '?'
PROMPT_SYMBOL    = '?'
IS_LOG_OPEN      = 0
IS_DEVICE_LOGGED_IN = 0
LOGIN_SUCCESS    = 0
INIT_PROMPT_IDX  = 0
AUTH_ATTEMPT     = 0
F_CRED_OPEN      = 0
F_CRED_TRIED     = 0
PROTO_DUAL_PHASE = 0
SKIP_RETRY_WAIT  = 0
SSH_PORT_DEAD    = 0
TELNET_PORT_DEAD = 0
SSH_LEGACY_MODE  = 0
ENABLE_FAILED    = 0
BASTION_LOST     = 0
ACTIVE_USER      = ''
ACTIVE_PASS      = ''
ACTIVE_ENPASS    = ''

; --- 4. 認証・ログイン実行 (lib\auth.ttl) ---
include LIB_AUTH
if BASTION_LOST = 1 goto bastion_disconnected

; --- 5. ログイン成功時: 昇格・ページング解除・コマンド実行・切断 (lib\exec_device.ttl) ---
if LOGIN_SUCCESS = 1 then
    include LIB_EXEC
    if BASTION_LOST = 1 goto bastion_disconnected
endif

; --- 6. 結果サマリ記録 ---
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif
strcompare DEV_STATUS 'OK'
if result = 0 then
    OK_COUNT = OK_COUNT + 1
    fileopen f_res RESOLVED_FILE 1
    if f_res <> -1 then
        sprintf2 RES_LINE '%s,%s,%s,%s,%s' DEV_NAME DEV_IP DEV_USER DEV_PROTO DEV_STATUS
        filewriteln f_res RES_LINE
        fileclose f_res
    endif
else
    NG_COUNT = NG_COUNT + 1
    DEV_USER = '-'
endif

getdate TS '%Y/%m/%d %H:%M:%S'
fileopen f_sum SUMMARY_FILE 1
if f_sum <> -1 then
    sprintf2 SUM_LINE '%s,%s,%s,%s,%s,%s,%s,%s' TS DEV_NAME DEV_IP DEV_PROTO PROMPT_SYMBOL DEV_STATUS DEV_DETAIL DEV_USER
    filewriteln f_sum SUM_LINE
    fileclose f_sum
endif
fileopen f_att ATTEMPT_LOG_FILE 1
if f_att <> -1 then
    sprintf2 ATT_LINE '%s,%s,%s,#%d,%s,%s,-,%s (%s)' TS DEV_NAME DEV_IP AUTH_ATTEMPT DEV_PROTO DEV_USER DEV_STATUS DEV_DETAIL
    filewriteln f_att ATT_LINE
    fileclose f_att
endif

if DEVICE_INTERVAL > 0 then
    pause DEVICE_INTERVAL
else
    mpause 300
endif
goto read_csv_loop

; --- 7. 全機器完了・異常終了ハンドラ ---
:end_csv_loop
if F_CRED_OPEN = 1 then
    fileclose f_cred
endif
fileclose f_csv
if paramcnt < 3 then
    closesbox
    settitle 'ログ自動収集 - 完了'
endif
if ALREADY_CONNECTED = 0 then
    testlink
    if result = 2 then
        sendln 'exit'
        mpause 500
    endif
    disconnect 0
endif
sprintf2 END_MSG '全機器の処理が完了しました。%s対象: %d台 (OK: %d / NG: %d)%s保存先: %s' CRLF TOTAL_COUNT OK_COUNT NG_COUNT CRLF LOG_DIR
messagebox END_MSG '完了'
end

:bastion_disconnected
if IS_LOG_OPEN = 1 then
    logclose
endif
if F_CRED_OPEN = 1 then
    fileclose f_cred
endif
fileclose f_csv
if paramcnt < 3 then
    closesbox
endif
sprintf2 ERR_MSG '踏み台サーバとの通信が切断されました。%s中断時の対象: %s (%s)%s途中までのログは保存されています。' CRLF DEV_NAME DEV_IP CRLF
messagebox ERR_MSG '踏み台切断エラー'
end

; --- 8. メイン用ローカルサブルーチン ---
:clean_csv_line
    CL_SKIP = 0
    strlen line
    if result >= 3 then
        strcopy line 1 3 B3
        strcompare B3 #239#187#191
        if result = 0 then
            strlen line
            B_REM = result - 3
            if B_REM > 0 then
                strcopy line 4 B_REM line
            else
                line = ''
            endif
        endif
    endif
    strtrim line TRIM_WS
    strlen line
    if result = 0 then
        CL_SKIP = 1
        return
    endif
    strcopy line 1 1 CL_FC
    strscan CMT_CHARS CL_FC
    if result > 0 then
        CL_SKIP = 1
    endif
return

:strip_comment
    strsplit CMT_VAL ',' 2
    CMT_VAL = groupmatchstr1
    strsplit CMT_VAL '#' 2
    CMT_VAL = groupmatchstr1
    strsplit CMT_VAL ';' 2
    CMT_VAL = groupmatchstr1
    strtrim CMT_VAL TRIM_FIELD
return

:normalize_proto
    tolower NP_LOW NORM_PROTO
    NP_SSH = 0
    NP_TEL = 0
    strscan NP_LOW 'ssh'
    if result > 0 then
        NP_SSH = 1
    endif
    strcompare NP_LOW '22'
    if result = 0 then
        NP_SSH = 1
    endif
    strscan NP_LOW 'telnet'
    if result > 0 then
        NP_TEL = 1
    endif
    strcompare NP_LOW '23'
    if result = 0 then
        NP_TEL = 1
    endif
    if NP_SSH = 1 && NP_TEL = 0 then
        NORM_PROTO = 'ssh'
    elseif NP_TEL = 1 && NP_SSH = 0 then
        NORM_PROTO = 'telnet'
    else
        NORM_PROTO = ''
    endif
return
