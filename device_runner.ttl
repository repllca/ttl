; ========================================================
; Tera Term 4.x 対応 TTLマクロ (マルチベンダー完全自動適応版)
; 概要: 事前に機器種別が不明な機器群に対しても、踏み台サーバ経由で
;       自動判定・自動昇格・ページング抑止を行い安全に参照系ログを収集する
;
; 特徴:
;   1. ログイン前機器不明対応:
;      SSH/Telnet問わず、認証プロンプト(User/Password)、ホスト鍵確認(yes/no)、
;      各種バナー(Enter/any key)を自動検知してログイン突破
;   2. 特権昇格(enable)の自動適応:
;      - プロンプト(#, $, %, ])から昇格不要機器(Linux/Juniper等)を自動判定
;      - 一般プロンプト(>)では enable を試行し、Yamaha等の場合は administrator へフォールバック
;      - 失敗しても通常権限で安全にコマンド実行を継続
;   3. ページ送り抑止の総当たり:
;      - 主要ベンダー向けページング解除コマンドを自動送信
;      - コマンド実行中に --More-- や 続く 等が出た場合も自動でスペース送信
;   4. コマンドファイルの自動フォールバック:
;      - CSVでコマンドファイル未指定時は commands_universal.txt を自動適用
;   5. 安全な多段離脱と実行サマリCSV出力
; ========================================================

; --------------------------------------------------------
; 1. 踏み台サーバおよび全体設定
; --------------------------------------------------------
BASTION_HOST   = '192.168.1.1'      ; 踏み台サーバのIPまたはホスト名
BASTION_PORT   = '22'               ; 踏み台サーバのSSHポート
BASTION_USER   = 'bastion_user'     ; 踏み台サーバのログインユーザ名
BASTION_PROMPT = '$'                ; 踏み台サーバのプロンプト記号 ($, # 等)

CSV_FILE       = 'device.csv'       ; 機器リストCSVファイル名
DEFAULT_CMD    = 'commands_universal.txt' ; コマンド未指定時の汎用ファイル

; 踏み台サーバのパスワード入力ダイアログ
passwordbox '踏み台サーバのパスワードを入力してください:' '踏み台認証情報'
BASTION_PASS = inputstr

strlen BASTION_PASS
if result = 0 then
    messagebox 'パスワードが入力されなかったため終了します。' '中断'
    end
endif

; 実行開始時刻とサマリCSVの準備
getdate RUN_ID '%Y%m%d_%H%M%S'
SUMMARY_FILE = 'summary_'
strconcat SUMMARY_FILE RUN_ID
strconcat SUMMARY_FILE '.csv'

fileopen f_sum SUMMARY_FILE 0
if f_sum <> -1 then
    filewriteln f_sum 'Timestamp,Hostname,IP,Protocol,Prompt,Status,Detail'
    fileclose f_sum
endif

; --------------------------------------------------------
; 2. 踏み台サーバへのSSH接続
; --------------------------------------------------------
COMMAND = BASTION_HOST
strconcat COMMAND ':'
strconcat COMMAND BASTION_PORT
strconcat COMMAND ' /ssh /2 /auth=password /user='
strconcat COMMAND BASTION_USER
strconcat COMMAND ' /passwd='
strconcat COMMAND BASTION_PASS

connect COMMAND

if result <> 2 then
    messagebox '踏み台サーバへの接続に失敗しました。' 'エラー'
    end
endif

timeout = 30
wait BASTION_PROMPT '$' '#' '>'
if result = 0 then
    messagebox '踏み台サーバのプロンプト待機がタイムアウトしました。' 'エラー'
    disconnect 0
    end
endif

; --------------------------------------------------------
; 3. device.csv の読み込みループ
; --------------------------------------------------------
fileopen f_csv CSV_FILE 0
if f_csv = -1 then
    messagebox 'device.csv を開くことができませんでした。' 'エラー'
    sendln 'exit'
    disconnect 0
    end
endif

:read_csv_loop
filereadln f_csv line
if result = 1 goto end_csv_loop     ; ファイル末尾(EOF)到達

strlen line
if result = 0 goto read_csv_loop

; コメント行(#)のスキップ
strcopy line 1 1 first_char
strcompare first_char '#'
if result = 0 goto read_csv_loop

; カンマ区切り分解 (7カラム)
; groupmatchstr1: ホスト名
; groupmatchstr2: IPアドレス
; groupmatchstr3: ユーザー名
; groupmatchstr4: パスワード
; groupmatchstr5: 管理者パスワード (enable等)
; groupmatchstr6: プロトコル (ssh / telnet)
; groupmatchstr7: コマンドファイルパス
strsplit line ',' 7
DEV_NAME   = groupmatchstr1
DEV_IP     = groupmatchstr2
DEV_USER   = groupmatchstr3
DEV_PASS   = groupmatchstr4
DEV_ENPASS = groupmatchstr5
DEV_PROTO  = groupmatchstr6
DEV_CMD    = groupmatchstr7

; ヘッダ行スキップ
strcompare DEV_NAME 'ホスト名'
if result = 0 goto read_csv_loop
strcompare DEV_NAME 'hostname'
if result = 0 goto read_csv_loop

; IPアドレス空チェック
strlen DEV_IP
if result = 0 goto read_csv_loop

; ホスト名未指定時はIPアドレスで代替
strlen DEV_NAME
if result = 0 then
    DEV_NAME = DEV_IP
endif

; --- 欠損値の自動補完 ---
; 1) プロトコル未記載時は ssh
strlen DEV_PROTO
if result = 0 then
    DEV_PROTO = 'ssh'
endif

; 2) ユーザ名未記載時は踏み台ユーザ名
strlen DEV_USER
if result = 0 then
    DEV_USER = BASTION_USER
endif

; 3) 機器パスワード未記載時は踏み台パスワード
strlen DEV_PASS
if result = 0 then
    DEV_PASS = BASTION_PASS
endif

; 4) 管理者パスワード未記載時は通常パスワード
strlen DEV_ENPASS
if result = 0 then
    DEV_ENPASS = DEV_PASS
endif

; 5) コマンドファイル未指定時は汎用コマンドファイル
strlen DEV_CMD
if result = 0 then
    DEV_CMD = DEFAULT_CMD
endif

; ログファイル名 (例: RT-01_20261116_093000.log)
getdate DATE_STR '%Y%m%d_%H%M%S'
LOG_FILE = DEV_NAME
strconcat LOG_FILE '_'
strconcat LOG_FILE DATE_STR
strconcat LOG_FILE '.log'
logopen LOG_FILE 0 0

DEV_STATUS = 'NG'
DEV_DETAIL = 'Unknown'
FINAL_PROMPT = '?'

; --------------------------------------------------------
; 4. 踏み台から対象機器へ接続コマンド発行
; --------------------------------------------------------
strcompare DEV_PROTO 'telnet'
if result = 0 goto do_telnet
strcompare DEV_PROTO 'TELNET'
if result = 0 goto do_telnet

; --- SSH接続コマンド ---
SEND_CMD = 'ssh -o StrictHostKeyChecking=no '
strlen DEV_USER
if result > 0 then
    strconcat SEND_CMD DEV_USER
    strconcat SEND_CMD '@'
endif
strconcat SEND_CMD DEV_IP
sendln SEND_CMD
goto login_negotiate_loop

; --- Telnet接続コマンド ---
:do_telnet
SEND_CMD = 'telnet '
strconcat SEND_CMD DEV_IP
sendln SEND_CMD

; --------------------------------------------------------
; 5. ログイン交渉ループ (機器種別不明・バナー・多段認証を自動突破)
; --------------------------------------------------------
:login_negotiate_loop
LOGIN_SUCCESS = 0
INIT_PROMPT_IDX = 0

while 1
    timeout = 15
    ; wait 引数は最大10個厳守
    ; 1:>, 2:#, 3:$, 4:%, 5:], 6:yes/no, 7:ogin:, 8:ser:, 9:assword:, 10:BASTION_PROMPT
    wait '>' '#' '$' '%' ']' 'yes/no' 'ogin:' 'ser:' 'assword:' BASTION_PROMPT
    if result >= 1 and result <= 5 then
        ; ログイン完了！プロンプト到達
        LOGIN_SUCCESS = 1
        INIT_PROMPT_IDX = result
        break
    elseif result = 6 then
        ; SSHホスト鍵フィンガープリント確認
        sendln 'yes'
    elseif result = 7 or result = 8 then
        ; ログイン名/ユーザ名要求
        sendln DEV_USER
    elseif result = 9 then
        ; パスワード要求
        sendln DEV_PASS
    elseif result = 10 or result = 0 then
        ; 踏み台に戻ってしまった、またはタイムアウト
        if result = 0 then
            ; バナー等の画面待ちの可能性があるため Enter を一度試行
            sendln ''
            timeout = 5
            wait '>' '#' '$' '%' ']' 'assword:' BASTION_PROMPT
            if result >= 1 and result <= 5 then
                LOGIN_SUCCESS = 1
                INIT_PROMPT_IDX = result
                break
            elseif result = 6 then
                sendln DEV_PASS
            else
                DEV_DETAIL = 'Login Timeout'
                goto cleanup_device
            endif
        else
            DEV_DETAIL = 'Login Failed or Rejected'
            goto cleanup_device
        endif
    endif
endwhile

if LOGIN_SUCCESS = 0 then
    DEV_DETAIL = 'Login Failed'
    goto cleanup_device
endif

; --------------------------------------------------------
; 6. 特権モード(管理者昇格)の自動適応
; --------------------------------------------------------
; 初期プロンプトがすでに対象特権(#, ], $, %)の場合は昇格処理不要
if INIT_PROMPT_IDX >= 2 and INIT_PROMPT_IDX <= 5 goto disable_paging

; 初期プロンプトが一般モード (>) の場合のみ昇格を試行
sendln 'enable'
timeout = 5
; 1:assword:, 2:#, 3:], 4:Invalid, 5:Unknown, 6:not found, 7:Error, 8:syntax, 9:>, 10:$
wait 'assword:' '#' ']' 'Invalid' 'Unknown' 'not found' 'Error' 'syntax' '>' '$'

if result = 1 then
    ; Cisco等: 管理者パスワード送信
    sendln DEV_ENPASS
    timeout = 5
    wait '#' ']' '>' '$'
elseif result >= 4 and result <= 8 then
    ; enable が拒否された場合（Yamahaルータ等の可能性）
    sendln 'administrator'
    timeout = 5
    wait 'assword:' '#' '>' '$'
    if result = 1 then
        sendln DEV_ENPASS
        timeout = 5
        wait '#' '>' '$'
    endif
endif
; 昇格に失敗した場合や最初から不要な場合でも、エラー中断せず通常モードで続行

; --------------------------------------------------------
; 7. ページ送り抑止の総当たり送信 (マルチベンダー対応)
; --------------------------------------------------------
:disable_paging
timeout = 2
; Cisco / Allied / Alaxala / Fortinet
sendln 'terminal length 0'
wait '#' '>' '$' '%' ']'

; Juniper
sendln 'set cli screen-length 0'
wait '#' '>' '$' '%' ']'

; Huawei
sendln 'screen-length 0 temporary'
wait '#' '>' '$' '%' ']'

; Yamaha
sendln 'console lines infinity'
wait '#' '>' '$' '%' ']'

; WLC
sendln 'config paging disable'
wait '#' '>' '$' '%' ']'

; 最終プロンプト記号の確定
timeout = 5
sendln ''
wait '#' '>' '$' '%' ']'
if result = 1 then
    FINAL_PROMPT = '#'
elseif result = 2 then
    FINAL_PROMPT = '>'
elseif result = 3 then
    FINAL_PROMPT = '$'
elseif result = 4 then
    FINAL_PROMPT = '%'
elseif result = 5 then
    FINAL_PROMPT = ']'
else
    FINAL_PROMPT = '#'
endif

; --------------------------------------------------------
; 8. コマンドファイルの実行 (ページング自動検知・スペース送信)
; --------------------------------------------------------
fileopen f_cmd DEV_CMD 0
if f_cmd = -1 then
    DEV_DETAIL = 'Command File Not Found'
    goto cleanup_device
endif

CMD_EXEC_OK = 1
while 1
    filereadln f_cmd cmd_line
    if result = 1 break             ; コマンドファイル終了(EOF)

    strlen cmd_line
    if result = 0 goto next_cmd_line

    ; コメント行(;)スキップ
    strcopy cmd_line 1 1 c_char
    strcompare c_char ';'
    if result = 0 goto next_cmd_line
    strcompare c_char '#'
    if result = 0 goto next_cmd_line

    ; ログ内にコマンド見出しを明記
    HEADER_STR = #13#10'==================== [ '
    strconcat HEADER_STR cmd_line
    strconcat HEADER_STR ' ] ===================='#13#10
    logwrite HEADER_STR

    ; コマンド送信
    sendln cmd_line

    ; 実行待機ループ (ページャー自動解消)
    while 1
        timeout = 30
        ; wait 最大10引数
        ; 1:FINAL_PROMPT, 2:--More--, 3:-- More --, 4:---(more, 5:More:, 6:続く, 7:RETURN, 8:any key
        wait FINAL_PROMPT '--More--' '-- More --' '---(more' 'More:' '続く' 'RETURN' 'any key'
        if result = 1 then
            ; コマンド完了
            break
        elseif result >= 2 and result <= 6 then
            ; ページ送り (スペースキー送信)
            send ' '
        elseif result >= 7 and result <= 8 then
            ; 改行要求
            sendln ''
        else
            ; タイムアウト時は次のコマンドへ進む
            break
        endif
    endwhile

    :next_cmd_line
endwhile

fileclose f_cmd
DEV_STATUS = 'OK'
DEV_DETAIL = 'Success'

; --------------------------------------------------------
; 9. 安全な多段階ログアウト (踏み台プロンプト復帰)
; --------------------------------------------------------
:cleanup_device
; exit 送信
timeout = 3
sendln 'exit'
wait BASTION_PROMPT 'Save' '(y/n)' '[y/n]' '>' '#' '$' ']'
if result = 1 goto logout_complete
if result >= 2 and result <= 4 then
    sendln 'n'
endif

; enable やサブモード抜けのため再度 exit
sendln 'exit'
timeout = 3
wait BASTION_PROMPT 'Save' '(y/n)' '[y/n]'
if result = 1 goto logout_complete
if result >= 2 and result <= 4 then
    sendln 'n'
endif

; Juniper / WLC 向けの quit
sendln 'quit'
timeout = 3
wait BASTION_PROMPT
if result = 1 goto logout_complete

; 強制切断 (Ctrl+C 送信後に exit、さらに SSH エスケープ ~.)
send #3
mpause 200
sendln 'exit'
timeout = 3
wait BASTION_PROMPT
if result = 1 goto logout_complete

send '~.'
mpause 500
sendln ''
wait BASTION_PROMPT

:logout_complete
logclose

; サマリCSVに結果行を追記
getdate TS '%Y/%m/%d %H:%M:%S'
fileopen f_sum SUMMARY_FILE 1
if f_sum <> -1 then
    SUM_LINE = TS
    strconcat SUM_LINE ','
    strconcat SUM_LINE DEV_NAME
    strconcat SUM_LINE ','
    strconcat SUM_LINE DEV_IP
    strconcat SUM_LINE ','
    strconcat SUM_LINE DEV_PROTO
    strconcat SUM_LINE ','
    strconcat SUM_LINE FINAL_PROMPT
    strconcat SUM_LINE ','
    strconcat SUM_LINE DEV_STATUS
    strconcat SUM_LINE ','
    strconcat SUM_LINE DEV_DETAIL
    filewriteln f_sum SUM_LINE
    fileclose f_sum
endif

pause 1
goto read_csv_loop

; --------------------------------------------------------
; 10. 全機器終了処理
; --------------------------------------------------------
:end_csv_loop
fileclose f_csv

; 踏み台サーバからログアウト
sendln 'exit'
disconnect 0

MSG = 'すべての機器のログ収集が完了しました。'#13#10'結果サマリ: '
strconcat MSG SUMMARY_FILE
messagebox MSG '完了'
end
