; ==============================================================================
; Tera Term 4.0x系 完全互換 TTLマクロ (マルチベンダー自動ログ収集マクロ)
; ==============================================================================
;
; 【このマクロの概要】
;   1. 踏み台サーバ（Linux等）にSSH接続します。
;   2. CSVファイル（device.csv等）から機器一覧（IPアドレス・認証情報等）を1行ずつ読み込みます。
;   3. 踏み台サーバを経由して各対象機器（Cisco, Yamaha, Juniper, Linux, Telnet等）へSSH/Telnet接続します。
;   4. 機種に応じたログイン・特権昇格（enable/administrator）・ページャー無効化を自動判別して行います。
;   5. コマンド定義ファイル（commands_*.txt）の内容を順次投入し、個別ログファイルに記録します。
;   6. 実行結果のサマリ（成功/失敗/プロンプト等）をCSV（summary_YYYYMMDD_HHMMSS.csv）に出力します。
;
; 【Tera Term 4.02 互換性保証】
;   - 新しいバージョン（4.53+）で追加されたコマンド（strsplit, break, continue, sprintf2,
;     filenamebox, dirnamebox 等）を一切使用せず、古いTera Term 4.02でもそのまま動作します。
;   - すべての wait コマンドの引数を「最大10個」以内に厳格制限しています。
;
; ------------------------------------------------------------------------------
; 【プログラムの目次】
;   1. 基準ディレクトリの設定 (相対パスのズレを完全防止)
;   2. ★【ユーザー設定エリア】 (環境に合わせてここを書き換えてください)
;   3. ★【対話ポップアップ】 (CSVファイル、ログ保存先、パスワードの選択・入力)
;   4. ログ保存先フォルダ作成 & サマリCSVの準備
;   5. 踏み台サーバへのSSH接続
;   6. CSVファイルの順次読み込みループ
;   7. 踏み台から対象機器への接続コマンド発行 (SSH / Telnet)
;   8. ログイン交渉ループ (プロンプト検知・バナー処理・パスワード自動入力)
;   9. 特権モード(管理者昇格)の自動適応 (Cisco enable / Yamaha administrator)
;  10. ページ送り抑止コマンドの送信 (terminal length 0 等)
;  11. クリーンログ取得開始 (logopen)
;  12. コマンドファイルの順次実行 (ページャー自動検知・スペース送信)
;  13. 対象機器からの安全切断 (踏み台セッション保護)
;  14. サマリCSVへの結果書き込み
;  15. 全機器終了処理 & 踏み台ログアウト
;  サブルーチン: CSV行パーサー (カンマ区切り解析)
; ==============================================================================


; ==============================================================================
; 1. 基準ディレクトリの設定 (相対パス解決)
; ==============================================================================
; Tera Term起動時のカレントディレクトリが「C:\Program Files (x86)\teraterm」等に
; なっている場合でも、このマクロと同じフォルダを基準に動作するよう固定します。
getdir BASE_DIR
setdir BASE_DIR


; ==============================================================================
; 2. ★【ユーザー設定エリア】
;    ご利用の環境に合わせて、必要に応じて以下の値を変更してください。
; ==============================================================================

; --- 踏み台サーバの接続設定 ---
BASTION_HOST   = '192.168.1.1'      ; 踏み台サーバのIPアドレスまたはホスト名
BASTION_PORT   = '22'               ; 踏み台サーバのSSHポート番号 (通常は 22)
BASTION_USER   = 'bastion_user'     ; 踏み台サーバのログインユーザ名
BASTION_PROMPT = '$'                ; 踏み台サーバのシェルプロンプト記号 ($, #, % 等)

; --- デフォルトのファイル・フォルダ名 ---
; （ポップアップが出たときに初期値として入力欄にあらかじめ入る名前です）
DEF_CSV_NAME   = 'device.csv'       ; 読み込む機器一覧CSVファイル名
DEF_LOG_NAME   = 'logs'             ; ログを保存するフォルダ名
DEF_CMD_NAME   = 'commands_universal.txt' ; CSV側でコマンド未指定時の汎用コマンドファイル

; --- タイムアウト設定 (単位: 秒) ---
LOGIN_TIMEOUT  = 15                 ; 機器へのログイン応答を待つ最大秒数
CMD_TIMEOUT    = 30                 ; 各コマンドの実行結果を待つ最大秒数


; ==============================================================================
; 3. ★【対話ポップアップ】(ファイル・フォルダ・パスワードの選択と入力)
; ==============================================================================

; 共通パスの初期値を組み立て
sprintf '%s\%s' BASE_DIR DEF_CSV_NAME
DEF_CSV_PATH = inputstr

sprintf '%s\%s' BASE_DIR DEF_LOG_NAME
DEF_LOG_PATH = inputstr

sprintf '%s\%s' BASE_DIR DEF_CMD_NAME
DEFAULT_CMD = inputstr

; コマンドライン引数の有無をチェック
; 引数なし(通常実行): ポップアップダイアログを表示して対話的に選択
; 引数あり(自動テスト/CI): ポップアップを省略して自動実行
if paramcnt >= 3 then
    ; 自動テストモード (引数から受け取り)
    LOG_DIR = param2
    BASTION_PASS = param3
    if paramcnt >= 4 then
        CSV_FILE = param4
    else
        CSV_FILE = DEF_CSV_PATH
    endif
else
    ; ----------------------------------------------------
    ; ポップアップ①: 機器一覧CSVファイルの選択
    ; ----------------------------------------------------
    ; 初期値としてマクロ配置フォルダの device.csv が入っています。
    ; そのまま「OK」を押すか、別のCSVファイル名・フルパスを入力できます。
    inputbox '読み込む機器一覧CSVファイル名（またはフルパス）を入力してください:' '機器一覧CSVの選択' DEF_CSV_PATH
    CSV_FILE = inputstr

    ; 空欄でOKされた場合は初期値を使用
    strlen CSV_FILE
    if result = 0 then
        CSV_FILE = DEF_CSV_PATH
    endif

    ; 相対パス（\ や / や : を含まない場合）は BASE_DIR を補完
    strscan CSV_FILE '\'
    if result = 0 then
        strscan CSV_FILE '/'
        if result = 0 then
            strscan CSV_FILE ':'
            if result = 0 then
                sprintf '%s\%s' BASE_DIR CSV_FILE
                CSV_FILE = inputstr
            endif
        endif
    endif

    ; CSVファイルが存在するか事前にチェック（存在しない場合はエラー表示して終了）
    fileopen f_chk CSV_FILE 0 1
    if f_chk = -1 then
        sprintf '指定された機器一覧CSVファイルが見つかりません:\n%s\n\nファイル名や配置場所をご確認ください。' CSV_FILE
        messagebox inputstr 'エラー: ファイル不存在'
        end
    endif
    fileclose f_chk

    ; ----------------------------------------------------
    ; ポップアップ②: ログ保存先フォルダの指定
    ; ----------------------------------------------------
    ; 初期値としてマクロ配置フォルダ内の logs フォルダが入っています。
    ; 存在しないフォルダ名を入力した場合でも、マクロが自動作成します。
    inputbox 'ログ保存先フォルダのパスを入力してください（存在しない場合は自動作成されます）:' 'ログ保存先フォルダ設定' DEF_LOG_PATH
    LOG_DIR = inputstr

    ; 空欄でOKされた場合は初期値を使用
    strlen LOG_DIR
    if result = 0 then
        LOG_DIR = DEF_LOG_PATH
    endif

    ; 相対パスなら BASE_DIR を補完
    strscan LOG_DIR '\'
    if result = 0 then
        strscan LOG_DIR '/'
        if result = 0 then
            strscan LOG_DIR ':'
            if result = 0 then
                sprintf '%s\%s' BASE_DIR LOG_DIR
                LOG_DIR = inputstr
            endif
        endif
    endif

    ; ----------------------------------------------------
    ; ポップアップ③: 踏み台サーバのログインパスワード入力
    ; ----------------------------------------------------
    sprintf '踏み台サーバ [%s@%s] のパスワードを入力してください:' BASTION_USER BASTION_HOST
    passwordbox inputstr '踏み台認証情報'
    BASTION_PASS = inputstr

    strlen BASTION_PASS
    if result = 0 then
        messagebox 'パスワードが入力されなかったため、処理を中断します。' '中断'
        end
    endif
endif

; パス末尾の余分なスラッシュ/バックスラッシュを除去して正規化
strlen LOG_DIR
DIR_LEN = result
strcopy LOG_DIR DIR_LEN 1 LAST_CHAR
strcompare LAST_CHAR '\'
if result = 0 then
    CUT_LEN = DIR_LEN - 1
    strcopy LOG_DIR 1 CUT_LEN LOG_DIR
endif
strcompare LAST_CHAR '/'
if result = 0 then
    CUT_LEN = DIR_LEN - 1
    strcopy LOG_DIR 1 CUT_LEN LOG_DIR
endif


; ==============================================================================
; 4. ログ保存先フォルダ作成 & サマリCSVの準備
; ==============================================================================
; ログフォルダが存在しない場合は自動作成
sprintf 'cmd.exe /c if not exist "%s" mkdir "%s"' LOG_DIR LOG_DIR
exec inputstr 'hide'
mpause 500

; 実行開始時刻をサフィックスにしたサマリCSVファイルを準備
getdate RUN_ID '%Y%m%d_%H%M%S'
sprintf '%s\summary_%s.csv' LOG_DIR RUN_ID
SUMMARY_FILE = inputstr

; サマリCSVを開いて書き込みテスト（書き込めない場合はマクロ直下に自動退避）
fileopen f_sum SUMMARY_FILE 0
if f_sum = -1 then
    LOG_DIR = BASE_DIR
    sprintf '%s\summary_%s.csv' LOG_DIR RUN_ID
    SUMMARY_FILE = inputstr
    fileopen f_sum SUMMARY_FILE 0
    if f_sum = -1 then
        messagebox 'ログ保存先フォルダへの書き込み権限がありません。実行権限を確認してください。' 'エラー'
        end
    endif
endif
; サマリCSVのヘッダ行を出力
filewriteln f_sum 'Timestamp,Hostname,IP,Protocol,Prompt,Status,Detail'
fileclose f_sum


; ==============================================================================
; 5. 踏み台サーバへのSSH接続
; ==============================================================================
; Tera Term 4.0x 完全互換の connect コマンド文字列を組み立て
sprintf '%s:%s /ssh /2 /auth=password /user=%s /passwd=%s' BASTION_HOST BASTION_PORT BASTION_USER BASTION_PASS
connect inputstr

; connect コマンドの戻り値判定 (2 = 接続成功)
if result <> 2 then
    messagebox '踏み台サーバへのSSH接続に失敗しました。IP・ポート・認証情報を確認してください。' 'エラー'
    end
endif

; 踏み台サーバのログインプロンプト待機
timeout = 30
wait BASTION_PROMPT '$' '#' '>'
if result = 0 then
    messagebox '踏み台サーバのプロンプト待機がタイムアウトしました。' 'エラー'
    disconnect 0
    end
endif


; ==============================================================================
; 6. CSVファイルの順次読み込みループ
; ==============================================================================
fileopen f_csv CSV_FILE 0 1
if f_csv = -1 then
    messagebox 'CSVファイルを開くことができませんでした。' 'エラー'
    sendln 'exit'
    disconnect 0
    end
endif

:read_csv_loop
; 踏み台との通信セッションが正常に継続しているかチェック
testlink
if result = 0 then
    messagebox '踏み台サーバとの通信が切断されたため、処理を中断します。' '通信切断'
    fileclose f_csv
    end
endif

; 機器一覧CSVから1行読み込み
filereadln f_csv line
if result = 1 goto end_csv_loop     ; ファイル終端(EOF)に達したら終了

strlen line
if result = 0 goto read_csv_loop    ; 空行はスキップ

; コメント行(# で始まる行)はスキップ
strcopy line 1 1 first_char
strcompare first_char '#'
if result = 0 goto read_csv_loop

; CSV行パーサーサブルーチンを呼び出して各列に分解
call parse_csv_line

; CSVのタイトル行(ホスト名, IP等のヘッダ)はスキップ
strcompare DEV_NAME 'ホスト名'
if result = 0 goto read_csv_loop
strcompare DEV_NAME 'hostname'
if result = 0 goto read_csv_loop

; IPアドレスが未入力の行はスキップ
strlen DEV_IP
if result = 0 goto read_csv_loop

; --- CSV内の空欄（欠損値）に対する自動フォールバック補完 ---
; 1) ホスト名未指定時: IPアドレスで代替
strlen DEV_NAME
if result = 0 then
    DEV_NAME = DEV_IP
endif

; 2) プロトコル未記載時: デフォルトは ssh
strlen DEV_PROTO
if result = 0 then
    DEV_PROTO = 'ssh'
endif

; 3) ユーザー名未記載時: 踏み台サーバのユーザ名を流用
strlen DEV_USER
if result = 0 then
    DEV_USER = BASTION_USER
endif

; 4) パスワード未記載時: 踏み台サーバのパスワードを流用
strlen DEV_PASS
if result = 0 then
    DEV_PASS = BASTION_PASS
endif

; 5) 管理者(enable)パスワード未記載時: 通常パスワードを流用
strlen DEV_ENPASS
if result = 0 then
    DEV_ENPASS = DEV_PASS
endif

; 6) コマンドファイル未指定時: 汎用コマンドファイル(commands_universal.txt)を使用
strlen DEV_CMD
if result = 0 then
    DEV_CMD = DEFAULT_CMD
endif

; コマンドファイルの相対パス解決
strscan DEV_CMD '\'
if result = 0 then
    strscan DEV_CMD '/'
    if result = 0 then
        strscan DEV_CMD ':'
        if result = 0 then
            sprintf '%s\%s' BASE_DIR DEV_CMD
            DEV_CMD = inputstr
        endif
    endif
endif

; 機器処理用の管理変数を初期化
DEV_STATUS = 'NG'
DEV_DETAIL = 'Unknown'
FINAL_PROMPT = '?'
IS_LOG_OPEN = 0
IS_DEVICE_LOGGED_IN = 0


; ==============================================================================
; 7. 踏み台から対象機器への接続コマンド発行 (SSH / Telnet)
; ==============================================================================
strcompare DEV_PROTO 'telnet'
if result = 0 goto do_telnet
strcompare DEV_PROTO 'TELNET'
if result = 0 goto do_telnet

; --- SSH接続コマンド発行 ---
; （フィンガープリント警告や known_hosts 競合による停止を防ぐオプションを付与）
SEND_CMD = 'ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null '
strlen DEV_USER
if result > 0 then
    strconcat SEND_CMD DEV_USER
    strconcat SEND_CMD '@'
endif
strconcat SEND_CMD DEV_IP
sendln SEND_CMD
goto login_negotiate_loop

; --- Telnet接続コマンド発行 ---
:do_telnet
SEND_CMD = 'telnet '
strconcat SEND_CMD DEV_IP
sendln SEND_CMD


; ==============================================================================
; 8. ログイン交渉ループ (プロンプト検知・バナー処理・パスワード自動入力)
; ==============================================================================
:login_negotiate_loop
LOGIN_SUCCESS = 0
INIT_PROMPT_IDX = 0

:login_retry_loop
timeout = LOGIN_TIMEOUT
; Tera Term 4.02の仕様制限: waitコマンドの引数は最大10個厳守
; 引数1:>, 2:#, 3:$, 4:%, 5:], 6:yes/no, 7:ogin:, 8:ser:, 9:assword:, 10:BASTION_PROMPT
wait '>' '#' '$' '%' ']' 'yes/no' 'ogin:' 'ser:' 'assword:' BASTION_PROMPT

if result >= 1 and result <= 5 then
    ; ログイン完了！機器のプロンプトに到達
    LOGIN_SUCCESS = 1
    INIT_PROMPT_IDX = result
    IS_DEVICE_LOGGED_IN = 1
    goto login_success_exit
endif

if result = 6 then
    ; 初回SSH接続時のフィンガープリント確認 (Are you sure you want to continue connecting (yes/no)?)
    sendln 'yes'
    goto login_retry_loop
endif

if result = 7 or result = 8 then
    ; ユーザー名入力要求 (login: / username: 等)
    sendln DEV_USER
    goto login_retry_loop
endif

if result = 9 then
    ; パスワード入力要求 (Password: 等)
    sendln DEV_PASS
    goto login_retry_loop
endif

if result = 10 then
    ; 踏み台プロンプトに戻ってしまった（相手機器のIPが存在しないか、ポートが閉じている）
    DEV_DETAIL = 'Connection Rejected / Host Unreachable'
    goto record_result
endif

if result = 0 then
    ; タイムアウト時：MOTDバナー等でキー入力待ちの可能性があるため、Enterを1度送信
    sendln ''
    timeout = 5
    wait '>' '#' '$' '%' ']' 'assword:' BASTION_PROMPT
    if result >= 1 and result <= 5 then
        LOGIN_SUCCESS = 1
        INIT_PROMPT_IDX = result
        IS_DEVICE_LOGGED_IN = 1
        goto login_success_exit
    endif
    if result = 6 then
        sendln DEV_PASS
        goto login_retry_loop
    endif

    ; 接続失敗時: まだ相手機器に入っていないため、Ctrl+C (#3) で安全に踏み台シェルへ復帰
    ; （※ここで exit を送ると踏み台からログアウトしてしまうため絶対に送らない）
    send #3
    mpause 300
    sendln ''
    wait BASTION_PROMPT '$' '#'
    DEV_DETAIL = 'Login Timeout'
    goto record_result
endif

:login_success_exit
if LOGIN_SUCCESS = 0 then
    DEV_DETAIL = 'Login Failed'
    goto cleanup_device
endif


; ==============================================================================
; 9. 特権モード(管理者昇格)の自動適応
; ==============================================================================
; 初期プロンプトが既に特権(#, ], $, %)の場合は昇格処理をスキップ
if INIT_PROMPT_IDX >= 2 and INIT_PROMPT_IDX <= 5 goto disable_paging

; 初期プロンプトが一般モード (>) の場合のみ特権昇格を試行
sendln 'enable'
timeout = 5
; 引数1:assword:, 2:#, 3:], 4:Invalid, 5:Unknown, 6:not found, 7:Error, 8:syntax, 9:>, 10:$
wait 'assword:' '#' ']' 'Invalid' 'Unknown' 'not found' 'Error' 'syntax' '>' '$'

if result = 1 then
    ; Cisco等: 管理者パスワード入力要求
    sendln DEV_ENPASS
    timeout = 5
    wait '#' ']' '>' '$'
elseif result >= 4 and result <= 8 then
    ; enable コマンドが拒否された場合 (Yamahaルータ等の可能性があるため administrator を試行)
    sendln 'administrator'
    timeout = 5
    wait 'assword:' '#' '>' '$'
    if result = 1 then
        sendln DEV_ENPASS
        timeout = 5
        wait '#' '>' '$'
    endif
endif


; ==============================================================================
; 10. ページ送り抑止コマンドの送信 (マルチベンダー自動適応)
; ==============================================================================
; 【変更のポイント】もし新しい機種に対応させたい場合は、ここにコマンドを追加してください。
:disable_paging
timeout = 2

; Cisco / Allied Telesis / Alaxala / Fortinet 用
sendln 'terminal length 0'
wait '#' '>' '$' '%' ']'

; Juniper JunOS 用
sendln 'set cli screen-length 0'
wait '#' '>' '$' '%' ']'

; Huawei VRP 用
sendln 'screen-length 0 temporary'
wait '#' '>' '$' '%' ']'

; Yamaha RTX 用
sendln 'console lines infinity'
wait '#' '>' '$' '%' ']'

; Cisco WLC 用
sendln 'config paging disable'
wait '#' '>' '$' '%' ']'

; コマンド完了判定に使う最終プロンプト記号を確定
timeout = 5
sendln ''
wait '#' '>' '$' '%' ']'
if result = 1 then
    FINAL_PROMPT = '#'
elseif result = 2 then
    FINAL_PROMPT = '>'
elseif result = 3 then
    FINAL_PROMPT = '$'
elseif result = 4 then
    FINAL_PROMPT = '%'
elseif result = 5 then
    FINAL_PROMPT = ']'
else
    FINAL_PROMPT = '#'
endif


; ==============================================================================
; 11. クリーンログ取得開始 (logopen)
; ==============================================================================
; ログイン・昇格・ページャー無効化の完了直後にログを開くことで、
; 認証パスワード等の機微情報が含まれない「コマンド実行結果のみ」の綺麗なログを作成します。
getdate DATE_STR '%Y%m%d_%H%M%S'
; ログファイル名形式: ホスト名_YYYYMMDD_HHMMSS.log
sprintf '%s\%s_%s.log' LOG_DIR DEV_NAME DATE_STR
LOG_FILE = inputstr

; 既存ログがあれば閉じてから新規オープン
; （※Tera Term 4.02 では logopen 直後の result が更新されないため、無条件で成功フラグを立てます）
logclose
logopen LOG_FILE 0 0
IS_LOG_OPEN = 1


; ==============================================================================
; 12. コマンドファイルの順次実行 (ページャー自動検知・スペース送信)
; ==============================================================================
fileopen f_cmd DEV_CMD 0 1
if f_cmd = -1 then
    DEV_DETAIL = 'Command File Not Found'
    goto cleanup_device
endif

:read_cmd_loop
filereadln f_cmd cmd_line
if result = 1 goto end_cmd_loop     ; コマンド定義ファイルの末尾(EOF)到達

strlen cmd_line
if result = 0 goto read_cmd_loop    ; 空行スキップ

; コメント行 (セミコロン ; または シャープ #) はスキップ
strcopy cmd_line 1 1 c_char
strcompare c_char ';'
if result = 0 goto read_cmd_loop
strcompare c_char '#'
if result = 0 goto read_cmd_loop

; ログ内に実行コマンドの見出しをわかりやすく記録
logwrite #13#10
logwrite '==================== [ '
logwrite cmd_line
logwrite ' ] ===================='
logwrite #13#10

; コマンドを機器に送信
sendln cmd_line

; コマンド実行結果の待機ループ (万一のページング表示 --More-- も自動解除)
:wait_cmd_prompt
timeout = CMD_TIMEOUT
; wait 最大10引数厳守
; 1:FINAL_PROMPT, 2:--More--, 3:-- More --, 4:---(more, 5:More:, 6:続く, 7:RETURN, 8:any key
wait FINAL_PROMPT '--More--' '-- More --' '---(more' 'More:' '続く' 'RETURN' 'any key'

if result = 1 goto read_cmd_loop    ; プロンプトに戻ったので次のコマンドへ

if result >= 2 and result <= 6 then
    ; ページャー表示(--More--等)が出現したため、スペースキーを送信して続きを表示
    send ' '
    goto wait_cmd_prompt
endif

if result >= 7 and result <= 8 then
    ; RETURN / any key 表示が出現したため、Enterキーを送信
    sendln ''
    goto wait_cmd_prompt
endif

; タイムアウト時はログを記録して次のコマンドへ進む
goto read_cmd_loop

:end_cmd_loop
fileclose f_cmd
DEV_STATUS = 'OK'
DEV_DETAIL = 'Success'


; ==============================================================================
; 13. 対象機器からの安全切断 (踏み台セッション保護)
; ==============================================================================
:cleanup_device
if IS_DEVICE_LOGGED_IN = 1 then
    ; 機器にログインしている場合のみ exit / quit を送って踏み台シェルに戻る
    timeout = 3
    sendln 'exit'
    wait BASTION_PROMPT 'Save' '(y/n)' '[y/n]' '>' '#' '$' ']'
    if result = 1 goto cleanup_done
    if result >= 2 and result <= 4 then
        sendln 'n'
    endif

    sendln 'exit'
    timeout = 3
    wait BASTION_PROMPT 'Save' '(y/n)' '[y/n]'
    if result = 1 goto cleanup_done
    if result >= 2 and result <= 4 then
        sendln 'n'
    endif

    sendln 'quit'
    timeout = 3
    wait BASTION_PROMPT
    if result = 1 goto cleanup_done

    ; 応答がない場合は Ctrl+C を送信して強制リセット
    send #3
    mpause 200
    sendln 'exit'
    timeout = 3
    wait BASTION_PROMPT
    if result = 1 goto cleanup_done

    ; SSHエスケープシーケンスによる緊急切断 (~.)
    send '~.'
    mpause 500
    sendln ''
    wait BASTION_PROMPT
endif

:cleanup_done
; 機器のログファイルが開かれていればクローズ
if IS_LOG_OPEN = 1 then
    logclose
    IS_LOG_OPEN = 0
endif


; ==============================================================================
; 14. サマリCSVへの追記
; ==============================================================================
:record_result
getdate TS '%Y/%m/%d %H:%M:%S'
fileopen f_sum SUMMARY_FILE 1
if f_sum <> -1 then
    sprintf '%s,%s,%s,%s,%s,%s,%s' TS DEV_NAME DEV_IP DEV_PROTO FINAL_PROMPT DEV_STATUS DEV_DETAIL
    filewriteln f_sum inputstr
    fileclose f_sum
endif

; 次の機器へ進む前にウェイトを挿入
mpause 500
goto read_csv_loop


; ==============================================================================
; 15. 全機器終了処理 & 踏み台ログアウト
; ==============================================================================
:end_csv_loop
fileclose f_csv

; 踏み台サーバから安全にログアウト
sendln 'exit'
disconnect 0

; 手動実行時のみ完了ポップアップを表示 (自動実行時はサイレント終了)
if paramcnt < 3 then
    sprintf 'すべての機器のログ収集が完了しました。\n\n【サマリCSV】:\n%s\n\n【ログ保存先】:\n%s' SUMMARY_FILE LOG_DIR
    messagebox inputstr 'ログ収集完了'
endif
end


; ==============================================================================
; サブルーチン: 4.0x互換 CSV行パーサー (7列対応・strsplit完全代替)
; ==============================================================================
; 【動作説明】
;   カンマの位置を strscan で探し、strcopy で各変数に切り出します。
;   Tera Term 4.67 以降の strsplit を使わず、4.02 でも確実に動作する設計です。
; ==============================================================================
:parse_csv_line
    COL1 = ''
    COL2 = ''
    COL3 = ''
    COL4 = ''
    COL5 = ''
    COL6 = ''
    COL7 = ''
    PARSE_STR = line

    ; 1列目 (ホスト名)
    strscan PARSE_STR ','
    if result = 0 goto parse_col1_only
    POS = result
    if POS = 1 then
        COL1 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL1
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 2列目 (IPアドレス)
    strscan PARSE_STR ','
    if result = 0 goto parse_col2_only
    POS = result
    if POS = 1 then
        COL2 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL2
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 3列目 (ユーザー名)
    strscan PARSE_STR ','
    if result = 0 goto parse_col3_only
    POS = result
    if POS = 1 then
        COL3 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL3
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 4列目 (パスワード)
    strscan PARSE_STR ','
    if result = 0 goto parse_col4_only
    POS = result
    if POS = 1 then
        COL4 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL4
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 5列目 (管理者パスワード)
    strscan PARSE_STR ','
    if result = 0 goto parse_col5_only
    POS = result
    if POS = 1 then
        COL5 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL5
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 6列目 (プロトコル: ssh / telnet)
    strscan PARSE_STR ','
    if result = 0 goto parse_col6_only
    POS = result
    if POS = 1 then
        COL6 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL6
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 7列目 (コマンドファイル名)
    COL7 = PARSE_STR
    goto parse_assign

    :parse_col1_only
    COL1 = PARSE_STR
    goto parse_assign

    :parse_col2_only
    COL2 = PARSE_STR
    goto parse_assign

    :parse_col3_only
    COL3 = PARSE_STR
    goto parse_assign

    :parse_col4_only
    COL4 = PARSE_STR
    goto parse_assign

    :parse_col5_only
    COL5 = PARSE_STR
    goto parse_assign

    :parse_col6_only
    COL6 = PARSE_STR

    :parse_assign
    DEV_NAME   = COL1
    DEV_IP     = COL2
    DEV_USER   = COL3
    DEV_PASS   = COL4
    DEV_ENPASS = COL5
    DEV_PROTO  = COL6
    DEV_CMD    = COL7
return
