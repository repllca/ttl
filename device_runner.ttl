; ========================================================
; Tera Term 4.0x系 完全互換 TTLマクロ (マルチベンダー完全自動適応・高信頼版)
; 概要: 事前に機器種別が不明な機器群に対しても、踏み台サーバ経由で
;       自動判定・自動昇格・ページング抑止を行い安全に参照系ログを収集する
;
; 主な信頼性向上策:
;   1. getdir / setdir による基準ディレクトリカレント化 (相対パス問題の完全解決)
;   2. 踏み台セッション保護: 接続未確立時は exit を送らず Ctrl+C で安全復帰
;   3. クリーンログ設計: ログイン・昇格・ページャー無効化の成功直後に logopen
;   4. ログ保存先エラー自動フォールバック: 指定フォルダ作成失敗時はマクロ直下に退避
;   5. Tera Term 4.02 厳格互換 (strsplit/break/continue 不使用、wait 最大10引数)
; ========================================================

; --------------------------------------------------------
; 1. 基準ディレクトリ設定 (相対パス解決)
; --------------------------------------------------------
getdir BASE_DIR
setdir BASE_DIR

; 共通ファイルパス (マクロと同じフォルダ基準)
sprintf '%s\device.csv' BASE_DIR
CSV_FILE = inputstr

DEFAULT_CMD = 'commands_universal.txt'

sprintf '%s\logs' BASE_DIR
DEF_LOG_DIR = inputstr

; --------------------------------------------------------
; 2. 踏み台サーバおよび実行設定
; --------------------------------------------------------
BASTION_HOST   = '192.168.1.1'      ; 踏み台サーバのIPまたはホスト名
BASTION_PORT   = '22'               ; 踏み台サーバのSSHポート
BASTION_USER   = 'bastion_user'     ; 踏み台サーバのログインユーザ名
BASTION_PROMPT = '$'                ; 踏み台サーバのプロンプト記号 ($, # 等)

; 引数判定 (paramcnt >= 3 の場合は自動テスト/非対話モードとしてポップアップをバイパス)
if paramcnt >= 3 then
    LOG_DIR = param2
    BASTION_PASS = param3
else
    ; ログ保存先ディレクトリの入力ダイアログ
    inputbox 'ログ保存先ディレクトリのパスを入力してください（存在しない場合は自動作成されます）:' 'ログ保存先設定' DEF_LOG_DIR
    LOG_DIR = inputstr

    strlen LOG_DIR
    if result = 0 then
        LOG_DIR = DEF_LOG_DIR
    endif

    ; 踏み台サーバのパスワード入力ダイアログ
    passwordbox '踏み台サーバのパスワードを入力してください:' '踏み台認証情報'
    BASTION_PASS = inputstr

    strlen BASTION_PASS
    if result = 0 then
        messagebox 'パスワードが入力されなかったため終了します。' '中断'
        end
    endif
endif

; 末尾のスラッシュやバックスラッシュを除去してパスを正規化
strlen LOG_DIR
DIR_LEN = result
strcopy LOG_DIR DIR_LEN 1 LAST_CHAR
strcompare LAST_CHAR '\'
if result = 0 then
    CUT_LEN = DIR_LEN - 1
    strcopy LOG_DIR 1 CUT_LEN LOG_DIR
endif
strcompare LAST_CHAR '/'
if result = 0 then
    CUT_LEN = DIR_LEN - 1
    strcopy LOG_DIR 1 CUT_LEN LOG_DIR
endif

; 保存先ディレクトリの自動作成
sprintf 'cmd.exe /c if not exist "%s" mkdir "%s"' LOG_DIR LOG_DIR
exec inputstr 'hide'
mpause 500

; 実行開始時刻とサマリCSVの準備（書き込みテストも兼ねる）
getdate RUN_ID '%Y%m%d_%H%M%S'
sprintf '%s\summary_%s.csv' LOG_DIR RUN_ID
SUMMARY_FILE = inputstr

fileopen f_sum SUMMARY_FILE 0
if f_sum = -1 then
    ; 指定フォルダへ書き込めない場合は BASE_DIR 直下へフォールバック
    LOG_DIR = BASE_DIR
    sprintf '%s\summary_%s.csv' LOG_DIR RUN_ID
    SUMMARY_FILE = inputstr
    fileopen f_sum SUMMARY_FILE 0
    if f_sum = -1 then
        messagebox 'ログ保存先ディレクトリに書き込みできません。権限を確認してください。' 'エラー'
        end
    endif
endif
filewriteln f_sum 'Timestamp,Hostname,IP,Protocol,Prompt,Status,Detail'
fileclose f_sum

; --------------------------------------------------------
; 3. 踏み台サーバへのSSH接続 (4.0x互換構文)
; --------------------------------------------------------
sprintf '%s:%s /ssh /2 /auth=password /user=%s /passwd=%s' BASTION_HOST BASTION_PORT BASTION_USER BASTION_PASS
connect inputstr

if result <> 2 then
    messagebox '踏み台サーバへの接続に失敗しました。' 'エラー'
    end
endif

timeout = 30
wait BASTION_PROMPT '$' '#' '>'
if result = 0 then
    messagebox '踏み台サーバのプロンプト待機がタイムアウトしました。' 'エラー'
    disconnect 0
    end
endif

; --------------------------------------------------------
; 4. device.csv の読み込みループ
; --------------------------------------------------------
fileopen f_csv CSV_FILE 0 1
if f_csv = -1 then
    messagebox 'device.csv を開くことができませんでした。マクロと同じフォルダに配置されているか確認してください。' 'エラー'
    sendln 'exit'
    disconnect 0
    end
endif

:read_csv_loop
; 踏み台セッションが生きているか確認
testlink
if result = 0 then
    messagebox '踏み台サーバとの通信が切断されたため処理を中断します。' '通信切断'
    fileclose f_csv
    end
endif

filereadln f_csv line
if result = 1 goto end_csv_loop     ; ファイル末尾(EOF)到達

strlen line
if result = 0 goto read_csv_loop

; コメント行(#)のスキップ
strcopy line 1 1 first_char
strcompare first_char '#'
if result = 0 goto read_csv_loop

; 4.0x互換CSVパーサーサブルーチン呼び出し
call parse_csv_line

; ヘッダ行スキップ
strcompare DEV_NAME 'ホスト名'
if result = 0 goto read_csv_loop
strcompare DEV_NAME 'hostname'
if result = 0 goto read_csv_loop

; IPアドレス空チェック
strlen DEV_IP
if result = 0 goto read_csv_loop

; ホスト名未指定時はIPアドレスで代替
strlen DEV_NAME
if result = 0 then
    DEV_NAME = DEV_IP
endif

; --- 欠損値の自動補完 ---
; 1) プロトコル未記載時は ssh
strlen DEV_PROTO
if result = 0 then
    DEV_PROTO = 'ssh'
endif

; 2) ユーザ名未記載時は踏み台ユーザ名
strlen DEV_USER
if result = 0 then
    DEV_USER = BASTION_USER
endif

; 3) 機器パスワード未記載時は踏み台パスワード
strlen DEV_PASS
if result = 0 then
    DEV_PASS = BASTION_PASS
endif

; 4) 管理者パスワード未記載時は通常パスワード
strlen DEV_ENPASS
if result = 0 then
    DEV_ENPASS = DEV_PASS
endif

; 5) コマンドファイル未指定時は汎用コマンドファイル
strlen DEV_CMD
if result = 0 then
    DEV_CMD = DEFAULT_CMD
endif

; 相対パス（フォルダ区切りやドライブレターを持たない場合）は BASE_DIR を付与
strscan DEV_CMD '\'
if result = 0 then
    strscan DEV_CMD '/'
    if result = 0 then
        strscan DEV_CMD ':'
        if result = 0 then
            sprintf '%s\%s' BASE_DIR DEV_CMD
            DEV_CMD = inputstr
        endif
    endif
endif

; 変数初期化
DEV_STATUS = 'NG'
DEV_DETAIL = 'Unknown'
FINAL_PROMPT = '?'
IS_LOG_OPEN = 0
IS_DEVICE_LOGGED_IN = 0

; --------------------------------------------------------
; 5. 踏み台から対象機器へ接続コマンド発行
; --------------------------------------------------------
strcompare DEV_PROTO 'telnet'
if result = 0 goto do_telnet
strcompare DEV_PROTO 'TELNET'
if result = 0 goto do_telnet

; === SSH接続コマンド (KnownHostsの競合やフィンガープリント警告を防止) ===
SEND_CMD = 'ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null '
strlen DEV_USER
if result > 0 then
    strconcat SEND_CMD DEV_USER
    strconcat SEND_CMD '@'
endif
strconcat SEND_CMD DEV_IP
sendln SEND_CMD
goto login_negotiate_loop

; === Telnet接続コマンド ===
:do_telnet
SEND_CMD = 'telnet '
strconcat SEND_CMD DEV_IP
sendln SEND_CMD

; --------------------------------------------------------
; 6. ログイン交渉ループ (機器種別不明・バナー・多段認証を自動突破)
; --------------------------------------------------------
:login_negotiate_loop
LOGIN_SUCCESS = 0
INIT_PROMPT_IDX = 0

:login_retry_loop
timeout = 15
; wait 引数は最大10個厳守
; 1:>, 2:#, 3:$, 4:%, 5:], 6:yes/no, 7:ogin:, 8:ser:, 9:assword:, 10:BASTION_PROMPT
wait '>' '#' '$' '%' ']' 'yes/no' 'ogin:' 'ser:' 'assword:' BASTION_PROMPT

if result >= 1 and result <= 5 then
    ; ログイン完了！プロンプト到達
    LOGIN_SUCCESS = 1
    INIT_PROMPT_IDX = result
    IS_DEVICE_LOGGED_IN = 1
    goto login_success_exit
endif

if result = 6 then
    ; SSHホスト鍵フィンガープリント確認
    sendln 'yes'
    goto login_retry_loop
endif

if result = 7 or result = 8 then
    ; ログイン名/ユーザ名要求
    sendln DEV_USER
    goto login_retry_loop
endif

if result = 9 then
    ; パスワード要求
    sendln DEV_PASS
    goto login_retry_loop
endif

if result = 10 then
    ; 踏み台プロンプトに戻った（接続拒否または相手ホスト不在）
    DEV_DETAIL = 'Connection Rejected / Host Unreachable'
    goto record_result
endif

if result = 0 then
    ; タイムアウト時：バナー等の画面待ちの可能性があるため Enter を一度送信
    sendln ''
    timeout = 5
    wait '>' '#' '$' '%' ']' 'assword:' BASTION_PROMPT
    if result >= 1 and result <= 5 then
        LOGIN_SUCCESS = 1
        INIT_PROMPT_IDX = result
        IS_DEVICE_LOGGED_IN = 1
        goto login_success_exit
    endif
    if result = 6 then
        sendln DEV_PASS
        goto login_retry_loop
    endif

    ; 接続失敗：まだ相手に入っていないため、Ctrl+C で踏み台に戻る (exit は送らない)
    send #3
    mpause 300
    sendln ''
    wait BASTION_PROMPT '$' '#'
    DEV_DETAIL = 'Login Timeout'
    goto record_result
endif

:login_success_exit
if LOGIN_SUCCESS = 0 then
    DEV_DETAIL = 'Login Failed'
    goto cleanup_device
endif

; --------------------------------------------------------
; 7. 特権モード(管理者昇格)の自動適応
; --------------------------------------------------------
; 初期プロンプトがすでに対象特権(#, ], $, %)の場合は昇格処理不要
if INIT_PROMPT_IDX >= 2 and INIT_PROMPT_IDX <= 5 goto disable_paging

; 初期プロンプトが一般モード (>) の場合のみ昇格を試行
sendln 'enable'
timeout = 5
; 1:assword:, 2:#, 3:], 4:Invalid, 5:Unknown, 6:not found, 7:Error, 8:syntax, 9:>, 10:$
wait 'assword:' '#' ']' 'Invalid' 'Unknown' 'not found' 'Error' 'syntax' '>' '$'

if result = 1 then
    ; Cisco等: 管理者パスワード送信
    sendln DEV_ENPASS
    timeout = 5
    wait '#' ']' '>' '$'
elseif result >= 4 and result <= 8 then
    ; enable が拒否された場合（Yamahaルータ等の可能性）
    sendln 'administrator'
    timeout = 5
    wait 'assword:' '#' '>' '$'
    if result = 1 then
        sendln DEV_ENPASS
        timeout = 5
        wait '#' '>' '$'
    endif
endif

; --------------------------------------------------------
; 8. ページ送り抑止の総当たり送信 (マルチベンダー対応)
; --------------------------------------------------------
:disable_paging
timeout = 2
; Cisco / Allied / Alaxala / Fortinet
sendln 'terminal length 0'
wait '#' '>' '$' '%' ']'

; Juniper
sendln 'set cli screen-length 0'
wait '#' '>' '$' '%' ']'

; Huawei
sendln 'screen-length 0 temporary'
wait '#' '>' '$' '%' ']'

; Yamaha
sendln 'console lines infinity'
wait '#' '>' '$' '%' ']'

; WLC
sendln 'config paging disable'
wait '#' '>' '$' '%' ']'

; 最終プロンプト記号の確定
timeout = 5
sendln ''
wait '#' '>' '$' '%' ']'
if result = 1 then
    FINAL_PROMPT = '#'
elseif result = 2 then
    FINAL_PROMPT = '>'
elseif result = 3 then
    FINAL_PROMPT = '$'
elseif result = 4 then
    FINAL_PROMPT = '%'
elseif result = 5 then
    FINAL_PROMPT = ']'
else
    FINAL_PROMPT = '#'
endif

; --------------------------------------------------------
; 9. クリーンログ取得開始 (ログイン・前処理成功後のみ開く)
; --------------------------------------------------------
getdate DATE_STR '%Y%m%d_%H%M%S'
sprintf '%s\%s_%s.log' LOG_DIR DEV_NAME DATE_STR
LOG_FILE = inputstr

; 既存ログがあれば閉じてから新規オープン (4.02ではlogopenはresultを変更しないため無条件設定)
logclose
logopen LOG_FILE 0 0
IS_LOG_OPEN = 1

; --------------------------------------------------------
; 10. コマンドファイルの実行 (ページング自動検知・スペース送信)
; --------------------------------------------------------
fileopen f_cmd DEV_CMD 0 1
if f_cmd = -1 then
    DEV_DETAIL = 'Command File Not Found'
    goto cleanup_device
endif

:read_cmd_loop
filereadln f_cmd cmd_line
if result = 1 goto end_cmd_loop     ; コマンドファイル終了(EOF)

strlen cmd_line
if result = 0 goto read_cmd_loop

; コメント行(;)スキップ
strcopy cmd_line 1 1 c_char
strcompare c_char ';'
if result = 0 goto read_cmd_loop
strcompare c_char '#'
if result = 0 goto read_cmd_loop

; ログ内にコマンド見出しを明記
logwrite #13#10
logwrite '==================== [ '
logwrite cmd_line
logwrite ' ] ===================='
logwrite #13#10

; コマンド送信
sendln cmd_line

; 実行待機ループ (ページャー自動解消)
:wait_cmd_prompt
timeout = 30
; wait 最大10引数
; 1:FINAL_PROMPT, 2:--More--, 3:-- More --, 4:---(more, 5:More:, 6:続く, 7:RETURN, 8:any key
wait FINAL_PROMPT '--More--' '-- More --' '---(more' 'More:' '続く' 'RETURN' 'any key'
if result = 1 goto read_cmd_loop
if result >= 2 and result <= 6 then
    send ' '
    goto wait_cmd_prompt
endif
if result >= 7 and result <= 8 then
    sendln ''
    goto wait_cmd_prompt
endif
; タイムアウト時は次のコマンドへ進む
goto read_cmd_loop

:end_cmd_loop
fileclose f_cmd
DEV_STATUS = 'OK'
DEV_DETAIL = 'Success'

; --------------------------------------------------------
; 11. 対象機器からの安全離脱 (踏み台セッションは絶対に殺さない)
; --------------------------------------------------------
:cleanup_device
if IS_DEVICE_LOGGED_IN = 1 then
    ; 機器に入っている場合のみ exit / quit を送信して踏み台に戻る
    timeout = 3
    sendln 'exit'
    wait BASTION_PROMPT 'Save' '(y/n)' '[y/n]' '>' '#' '$' ']'
    if result = 1 goto cleanup_done
    if result >= 2 and result <= 4 then
        sendln 'n'
    endif

    sendln 'exit'
    timeout = 3
    wait BASTION_PROMPT 'Save' '(y/n)' '[y/n]'
    if result = 1 goto cleanup_done
    if result >= 2 and result <= 4 then
        sendln 'n'
    endif

    sendln 'quit'
    timeout = 3
    wait BASTION_PROMPT
    if result = 1 goto cleanup_done

    send #3
    mpause 200
    sendln 'exit'
    timeout = 3
    wait BASTION_PROMPT
    if result = 1 goto cleanup_done

    send '~.'
    mpause 500
    sendln ''
    wait BASTION_PROMPT
endif

:cleanup_done
; ログが開かれていればクローズ
if IS_LOG_OPEN = 1 then
    logclose
    IS_LOG_OPEN = 0
endif

; --------------------------------------------------------
; 12. サマリCSVへの追記
; --------------------------------------------------------
:record_result
getdate TS '%Y/%m/%d %H:%M:%S'
fileopen f_sum SUMMARY_FILE 1
if f_sum <> -1 then
    sprintf '%s,%s,%s,%s,%s,%s,%s' TS DEV_NAME DEV_IP DEV_PROTO FINAL_PROMPT DEV_STATUS DEV_DETAIL
    filewriteln f_sum inputstr
    fileclose f_sum
endif

mpause 500
goto read_csv_loop

; --------------------------------------------------------
; 13. 全機器終了処理
; --------------------------------------------------------
:end_csv_loop
fileclose f_csv

; 踏み台サーバからログアウト
sendln 'exit'
disconnect 0

; 手動実行時のみ完了ポップアップを表示 (自動実行時はサイレント終了)
if paramcnt < 3 then
    sprintf 'すべての機器のログ収集が完了しました。\n結果サマリ: %s' SUMMARY_FILE
    messagebox inputstr '完了'
endif
end


; ========================================================
; サブルーチン: 4.0x互換 CSV行パーサー (7列対応・strsplit完全代替)
; ========================================================
:parse_csv_line
    COL1 = ''
    COL2 = ''
    COL3 = ''
    COL4 = ''
    COL5 = ''
    COL6 = ''
    COL7 = ''
    PARSE_STR = line

    ; 1列目 (ホスト名)
    strscan PARSE_STR ','
    if result = 0 goto parse_col1_only
    POS = result
    if POS = 1 then
        COL1 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL1
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 2列目 (IPアドレス)
    strscan PARSE_STR ','
    if result = 0 goto parse_col2_only
    POS = result
    if POS = 1 then
        COL2 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL2
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 3列目 (ユーザー名)
    strscan PARSE_STR ','
    if result = 0 goto parse_col3_only
    POS = result
    if POS = 1 then
        COL3 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL3
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 4列目 (パスワード)
    strscan PARSE_STR ','
    if result = 0 goto parse_col4_only
    POS = result
    if POS = 1 then
        COL4 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL4
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 5列目 (管理者パスワード)
    strscan PARSE_STR ','
    if result = 0 goto parse_col5_only
    POS = result
    if POS = 1 then
        COL5 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL5
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 6列目 (プロトコル)
    strscan PARSE_STR ','
    if result = 0 goto parse_col6_only
    POS = result
    if POS = 1 then
        COL6 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL6
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 7列目 (コマンドファイル)
    COL7 = PARSE_STR
    goto parse_assign

    :parse_col1_only
    COL1 = PARSE_STR
    goto parse_assign

    :parse_col2_only
    COL2 = PARSE_STR
    goto parse_assign

    :parse_col3_only
    COL3 = PARSE_STR
    goto parse_assign

    :parse_col4_only
    COL4 = PARSE_STR
    goto parse_assign

    :parse_col5_only
    COL5 = PARSE_STR
    goto parse_assign

    :parse_col6_only
    COL6 = PARSE_STR

    :parse_assign
    DEV_NAME   = COL1
    DEV_IP     = COL2
    DEV_USER   = COL3
    DEV_PASS   = COL4
    DEV_ENPASS = COL5
    DEV_PROTO  = COL6
    DEV_CMD    = COL7
return
