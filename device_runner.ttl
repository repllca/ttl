; ==============================================================================
; Tera Term 4.x系 完全互換 TTLマクロ (マルチベンダー自動ログ収集・高信頼版)
; ==============================================================================
;
; 【このマクロの概要】
;   1. 踏み台サーバ（Linux等）へSSH接続します（既に接続済みのウィンドウからの実行も自動判別）。
;   2. CSVファイル（device.csv等）から機器一覧（IPアドレス・認証情報等）を1行ずつ読み込みます。
;   3. ユーザー名・パスワード・管理者PWが空欄の機器には、外部CSV（credentials.csv）の候補を
;      上から順に自動試行します。
;      - device.csv にプロトコル(ssh/telnet)記載あり: 一致するプロトコル候補のみ試行
;      - device.csv にプロトコル未記載(空欄): ssh と telnet の両方を自動試行
;   4. 認証失敗時は設定秒数（AUTH_RETRY_INTERVAL）のウェイトを挟み、実機のロックアウトを回避します。
;   5. 機種に応じたログイン・特権昇格（enable/administrator）・ページャー無効化を自動判別します。
;   6. 機器固有のプロンプト文字列（例: RT-CISCO-01#）を精密に検証・取得し、
;      コマンド待機タイムアウトや出力途中の誤反応を完全に防止します。
;   7. コマンド定義ファイル（commands_*.txt）を順次投入し、個別ログおよびサマリCSVを出力します。
;   8. 対象機器からの離脱時、踏み台復帰マーカー（__BASTION_RETURN__）により
;      踏み台シェルへの誤った exit 送信（巻き添え切断）を100%防止します。
;
; 【Tera Term 4.x 厳格互換性保証】
;   - 4.53+専用コマンド（strsplit, break, continue, sprintf2等）を一切不使用。
;   - すべての wait / waitln 引数を最大10個以内に厳格制限。
;   - すべてのポップアップ文字列を255バイト制限内に収め、CRLF(#13#10)で綺麗に改行。
; ==============================================================================


; ==============================================================================
; 1. 基準ディレクトリの設定 (相対パス解決 & 定数定義)
; ==============================================================================
getdir BASE_DIR
setdir BASE_DIR

; 改行文字定義 (Windows MessageBox 互換 CRLF)
CRLF = #13#10


; ==============================================================================
; 2. ★【ユーザー設定エリア】
;    ご利用の環境に合わせて、以下の初期値を自由に変更してください。
;    （※そのままでも起動時のポップアップ画面で変更・入力が可能です）
; ==============================================================================

; --- 踏み台サーバの接続設定（ポップアップの初期値になります） ---
BASTION_HOST   = '192.168.1.1'      ; 踏み台サーバのIPアドレスまたはホスト名
BASTION_PORT   = '22'               ; 踏み台サーバのSSHポート番号 (通常は 22)
BASTION_USER   = 'bastion_user'     ; 踏み台サーバのログインユーザ名
BASTION_PROMPT = '$'                ; 踏み台サーバのシェルプロンプト記号 ($, #, % 等)

; --- 古い機器向けのSSH追加オプション ---
; 【変更のポイント】古いCiscoやスイッチ等で「no matching key exchange method found」等の
; エラーが出る場合は、下のコメントアウト(;)を外して有効化してください。
SSH_EXTRA_OPTS = '-o ConnectTimeout=10'
; SSH_EXTRA_OPTS = '-o ConnectTimeout=10 -o KexAlgorithms=+diffie-hellman-group1-sha1,diffie-hellman-group14-sha1 -o HostKeyAlgorithms=+ssh-rsa'

; --- デフォルトのファイル・フォルダ名 ---
DEF_CSV_NAME          = 'device.csv'             ; 読み込む機器一覧CSVファイル名
DEF_LOG_NAME          = 'logs'                   ; ログを保存するフォルダ名
DEF_CMD_NAME          = 'commands_universal.txt' ; CSV側でコマンド未指定時の汎用コマンドファイル
DEF_CRED_NAME         = 'credentials.csv'        ; 外部パスワード一覧CSV (ユーザー名,PW,enPW,プロトコル)
FALLBACK_TO_CRED_FILE    = 0                     ; 0: device.csv 固有PW失敗時は次機器へ (安全)
                                                 ; 1: device.csv 固有PW失敗時も外部CSVを追加試行
FALLBACK_TO_BASTION_CRED = 0                     ; 0: 認証情報未指定時に踏み台ユーザー名を自動流用しない (推奨)
                                                 ; 1: 認証情報未指定時に踏み台ユーザー名/PWを自動流用する

; --- タイムアウト設定 (単位: 秒) ---
LOGIN_TIMEOUT  = 15                 ; 機器へのログイン応答を待つ最大秒数
CMD_TIMEOUT    = 30                 ; 各コマンドの実行結果を待つ最大秒数

; --- 試行・待機ウェイト設定 (単位: 秒) ---
; 【変更のポイント】実機の不正ログイン検知（ブルートフォース防御 / Quiet Mode / ロックアウト）
; やセッション枯渇を回避するため、認証失敗後の再試行間隔や、機器間の待機秒数を調整できます。
AUTH_RETRY_INTERVAL = 2             ; 認証失敗後に次の候補を試行するまでの待機秒数 (推奨: 2〜3秒)
DEVICE_INTERVAL     = 1             ; 1台の処理完了後、次の機器へ進むまでの待機秒数 (推奨: 1〜2秒)

; --- 全機器共通のフォールバック認証候補プール（オプション） ---
; パイプ (|) または セミコロン (;) 区切りで複数指定可能（空欄 '' の場合は不使用）
GLOBAL_CRED_USERS  = ''
GLOBAL_CRED_PASSES = ''


; ==============================================================================
; 3. ★【対話ポップアップ】(接続先・ファイル・フォルダの選択と入力)
; ==============================================================================

; 共通パスの初期値を組み立て
sprintf '%s\%s' BASE_DIR DEF_CSV_NAME
DEF_CSV_PATH = inputstr

sprintf '%s\%s' BASE_DIR DEF_LOG_NAME
DEF_LOG_PATH = inputstr

sprintf '%s\%s' BASE_DIR DEF_CMD_NAME
DEFAULT_CMD = inputstr

sprintf '%s\%s' BASE_DIR DEF_CRED_NAME
DEF_CRED_PATH = inputstr
CRED_FILE = ''

; デフォルトの外部パスワードCSV (credentials.csv) が存在するか確認
fileopen f_chk DEF_CRED_PATH 0 1
if f_chk <> -1 then
    fileclose f_chk
    CRED_FILE = DEF_CRED_PATH
endif

; すでにTera Termウィンドウで踏み台サーバに接続済みかどうかを確認 (2 = 接続済)
ALREADY_CONNECTED = 0
testlink
if result = 2 then
    ALREADY_CONNECTED = 1
endif

; コマンドライン引数の有無をチェック
; 引数なし(通常実行): ポップアップダイアログで対話選択
; 引数あり(自動テスト/CI): ポップアップを省略して自動実行
if paramcnt >= 3 then
    ALREADY_CONNECTED = 0
    LOG_DIR = param2
    BASTION_PASS = param3
    if paramcnt >= 4 then
        CSV_FILE = param4
    else
        CSV_FILE = DEF_CSV_PATH
    endif
    if paramcnt >= 5 then
        CRED_FILE = param5
    endif
else
    ; ----------------------------------------------------
    ; 踏み台に未接続の場合のみ、踏み台の接続先情報をポップアップで確認
    ; ----------------------------------------------------
    if ALREADY_CONNECTED = 0 then
        ; ポップアップ①: 踏み台サーバのIP / ホスト名
        inputbox '踏み台サーバのIPアドレス(またはホスト名):' '1. 踏み台サーバ接続先' BASTION_HOST
        BASTION_HOST = inputstr
        strlen BASTION_HOST
        if result = 0 then
            messagebox '踏み台サーバの接続先が未入力のため中断します。' '中断'
            end
        endif

        ; ポップアップ②: 踏み台サーバのログインユーザー名
        inputbox '踏み台サーバのログインユーザー名:' '2. 踏み台ユーザー名' BASTION_USER
        BASTION_USER = inputstr
        strlen BASTION_USER
        if result = 0 then
            messagebox 'ユーザー名が未入力のため中断します。' '中断'
            end
        endif

        ; ポップアップ③: 踏み台サーバのログインパスワード
        sprintf '踏み台 [%s@%s] のパスワード:' BASTION_USER BASTION_HOST
        passwordbox inputstr '3. 踏み台パスワード'
        BASTION_PASS = inputstr
        strlen BASTION_PASS
        if result = 0 then
            messagebox 'パスワードが未入力のため中断します。' '中断'
            end
        endif
    else
        ; すでに踏み台に接続済みの場合は共通パスワードのみ確認
        DLG_MSG = '接続中の踏み台を使用します。'
        strconcat DLG_MSG CRLF
        strconcat DLG_MSG '共通PW (不要なら空欄でOK):'
        passwordbox DLG_MSG '共通パスワード確認'
        BASTION_PASS = inputstr
    endif

    ; ----------------------------------------------------
    ; ポップアップ④: 機器一覧CSVファイルの選択
    ; ----------------------------------------------------
    inputbox '機器一覧CSVファイル (ファイル名またはフルパス):' '機器一覧CSVの選択' DEF_CSV_PATH
    CSV_FILE = inputstr

    strlen CSV_FILE
    if result = 0 then
        CSV_FILE = DEF_CSV_PATH
    endif

    ; 相対パス（\ や / や : を含まない場合）は BASE_DIR を補完
    strscan CSV_FILE '\'
    if result = 0 then
        strscan CSV_FILE '/'
        if result = 0 then
            strscan CSV_FILE ':'
            if result = 0 then
                sprintf '%s\%s' BASE_DIR CSV_FILE
                CSV_FILE = inputstr
            endif
        endif
    endif

    ; CSVファイルが存在するか事前にチェック
    fileopen f_chk CSV_FILE 0 1
    if f_chk = -1 then
        DLG_MSG = '機器一覧CSVが見つかりません:'
        strconcat DLG_MSG CRLF
        strconcat DLG_MSG CSV_FILE
        messagebox DLG_MSG 'エラー: CSV不存在'
        end
    endif
    fileclose f_chk

    ; ----------------------------------------------------
    ; ポップアップ⑤: ログ保存先フォルダの指定
    ; ----------------------------------------------------
    inputbox 'ログ保存先フォルダ (存在しない場合は自動作成):' 'ログ保存先フォルダ' DEF_LOG_PATH
    LOG_DIR = inputstr

    strlen LOG_DIR
    if result = 0 then
        LOG_DIR = DEF_LOG_PATH
    endif

    ; 相対パスなら BASE_DIR を補完
    strscan LOG_DIR '\'
    if result = 0 then
        strscan LOG_DIR '/'
        if result = 0 then
            strscan LOG_DIR ':'
            if result = 0 then
                sprintf '%s\%s' BASE_DIR LOG_DIR
                LOG_DIR = inputstr
            endif
        endif
    endif

    ; ----------------------------------------------------
    ; ポップアップ⑥: 外部パスワード一覧CSVファイル (省略可)
    ; ----------------------------------------------------
    DLG_MSG = '外部認証CSV (ユーザー,PW,enPW,プロトコル):'
    strconcat DLG_MSG CRLF
    strconcat DLG_MSG '※不要な場合は空欄のままOK'
    inputbox DLG_MSG '外部パスワードCSV選択' CRED_FILE
    CRED_FILE = inputstr

    strlen CRED_FILE
    if result > 0 then
        ; 相対パスなら BASE_DIR を補完
        strscan CRED_FILE '\'
        if result = 0 then
            strscan CRED_FILE '/'
            if result = 0 then
                strscan CRED_FILE ':'
                if result = 0 then
                    sprintf '%s\%s' BASE_DIR CRED_FILE
                    CRED_FILE = inputstr
                endif
            endif
        endif

        fileopen f_chk CRED_FILE 0 1
        if f_chk <> -1 then
            fileclose f_chk
        else
            DLG_MSG = '外部CSVが見つかりません(不使用で続行):'
            strconcat DLG_MSG CRLF
            strconcat DLG_MSG CRED_FILE
            messagebox DLG_MSG '警告: 外部CSV不存在'
            CRED_FILE = ''
        endif
    endif
endif

; パス末尾の余分なスラッシュ/バックスラッシュを除去して正規化
strlen LOG_DIR
DIR_LEN = result
if DIR_LEN > 1 then
    strcopy LOG_DIR DIR_LEN 1 LAST_CHAR
    strcompare LAST_CHAR '\'
    if result = 0 then
        CUT_LEN = DIR_LEN - 1
        strcopy LOG_DIR 1 CUT_LEN LOG_DIR
    endif
    strcompare LAST_CHAR '/'
    if result = 0 then
        CUT_LEN = DIR_LEN - 1
        strcopy LOG_DIR 1 CUT_LEN LOG_DIR
    endif
endif


; ==============================================================================
; 4. ログ保存先フォルダ作成 & サマリCSVの準備
; ==============================================================================
sprintf 'cmd.exe /c if not exist "%s" mkdir "%s"' LOG_DIR LOG_DIR
exec inputstr 'hide'
mpause 500

; 実行開始時刻をサフィックスにしたサマリCSVファイルを準備
getdate RUN_ID '%Y%m%d_%H%M%S'
sprintf '%s\summary_%s.csv' LOG_DIR RUN_ID
SUMMARY_FILE = inputstr

; サマリCSVを開いて書き込みテスト（書き込めない場合はマクロ直下に自動退避）
fileopen f_sum SUMMARY_FILE 0
if f_sum = -1 then
    LOG_DIR = BASE_DIR
    sprintf '%s\summary_%s.csv' LOG_DIR RUN_ID
    SUMMARY_FILE = inputstr
    fileopen f_sum SUMMARY_FILE 0
    if f_sum = -1 then
        messagebox 'ログ保存先への書き込み権限がありません。' 'エラー'
        end
    endif
endif
filewriteln f_sum 'Timestamp,Hostname,IP,Protocol,Prompt,Status,Detail,Auth_User'
fileclose f_sum

; ログイン成功アカウント一覧CSVの準備
sprintf '%s\resolved_accounts_%s.csv' LOG_DIR RUN_ID
RESOLVED_FILE = inputstr
fileopen f_res RESOLVED_FILE 0
if f_res <> -1 then
    filewriteln f_res 'Hostname,IP,User,Protocol,Status'
    fileclose f_res
endif

; 認証試行履歴CSVの準備 (現在どのユーザー/パスワードを試しているか後から確認可能)
sprintf '%s\attempts_%s.csv' LOG_DIR RUN_ID
ATTEMPT_LOG_FILE = inputstr
fileopen f_att ATTEMPT_LOG_FILE 0
if f_att <> -1 then
    filewriteln f_att 'Timestamp,Device,IP,Attempt,Protocol,User,Password,Result'
    fileclose f_att
endif


; ==============================================================================
; 5. 踏み台サーバへのSSH接続
; ==============================================================================
if ALREADY_CONNECTED = 0 then
    strscan BASTION_HOST ':'
    if result = 0 then
        sprintf '%s:%s /ssh /2 /auth=password /user="%s" /passwd="%s"' BASTION_HOST BASTION_PORT BASTION_USER BASTION_PASS
    else
        sprintf '%s /ssh /2 /auth=password /user="%s" /passwd="%s"' BASTION_HOST BASTION_USER BASTION_PASS
    endif
    connect inputstr

    if result <> 2 then
        sprintf '踏み台(%s)へ接続できませんでした。' BASTION_HOST
        DLG_MSG = inputstr
        strconcat DLG_MSG CRLF
        strconcat DLG_MSG 'IP・ポート・ユーザー名・PWを確認してください。'
        messagebox DLG_MSG '踏み台SSH接続エラー'
        end
    endif

    ; 踏み台サーバのログインプロンプト待機
    timeout = 30
    wait BASTION_PROMPT '$' '#' '>' '%' ']'
    if result = 0 then
        DLG_MSG = '踏み台のプロンプト待機がタイムアウトしました。'
        strconcat DLG_MSG CRLF
        strconcat DLG_MSG 'PW誤りやバナー停止を確認してください。'
        messagebox DLG_MSG '接続タイムアウト'
        disconnect 0
        end
    endif

    if result = 2 then
        BASTION_PROMPT = '$'
    elseif result = 3 then
        BASTION_PROMPT = '#'
    elseif result = 4 then
        BASTION_PROMPT = '>'
    elseif result = 5 then
        BASTION_PROMPT = '%'
    elseif result = 6 then
        BASTION_PROMPT = ']'
    endif
else
    ; すでに接続済みの場合はEnterを1回送ってプロンプトを確認
    flushrecv
    sendln ''
    timeout = 10
    wait BASTION_PROMPT '$' '#' '>' '%' ']'
    if result = 2 then
        BASTION_PROMPT = '$'
    elseif result = 3 then
        BASTION_PROMPT = '#'
    elseif result = 4 then
        BASTION_PROMPT = '>'
    elseif result = 5 then
        BASTION_PROMPT = '%'
    elseif result = 6 then
        BASTION_PROMPT = ']'
    endif
endif

; 初期状態の機器情報・集計カウンタをセット
DEV_NAME = '(1台目の接続前)'
DEV_IP = '未接続'
DEV_PROTO = '-'
DEV_STATUS = '未実行'
DEV_DETAIL = '-'
TOTAL_COUNT = 0
OK_COUNT = 0
NG_COUNT = 0


; ==============================================================================
; 6. 機器一覧CSVファイルの順次読み込みループ
; ==============================================================================
fileopen f_csv CSV_FILE 0 1
if f_csv = -1 then
    messagebox '機器一覧CSVを開けませんでした。' 'エラー'
    if ALREADY_CONNECTED = 0 then
        sendln 'exit'
        disconnect 0
    endif
    end
endif

:read_csv_loop
; 踏み台との通信セッションが継続しているかチェック (2 = 正常接続中)
testlink
if result <> 2 goto bastion_disconnected

; 機器一覧CSVから1行読み込み
filereadln f_csv line
if result = 1 goto end_csv_loop

; 行の前後の空白・改行・BOMをトリム
TRIM_VAL = line
call trim_string
line = TRIM_VAL

strlen line
if result = 0 goto read_csv_loop

; コメント行(# または ; で始まる行)はスキップ
strcopy line 1 1 first_char
strcompare first_char '#'
if result = 0 goto read_csv_loop
strcompare first_char ';'
if result = 0 goto read_csv_loop

; CSV行パーサーサブルーチンを呼び出して7列に分解
call parse_csv_line

; ヘッダ行スキップ
strcompare DEV_NAME 'ホスト名'
if result = 0 goto read_csv_loop
strcompare DEV_NAME 'hostname'
if result = 0 goto read_csv_loop
strcompare DEV_NAME 'Hostname'
if result = 0 goto read_csv_loop

; IPアドレスが空欄の行はスキップ
strlen DEV_IP
if result = 0 goto read_csv_loop

TOTAL_COUNT = TOTAL_COUNT + 1

; --- CSV内の空欄（欠損値）に対する自動補完 ---
; 1) ホスト名未指定時: IPアドレスで代替
strlen DEV_NAME
if result = 0 then
    DEV_NAME = DEV_IP
endif

; 2) プロトコル元指定の正規化と記録 (未指定時はSSH/Telnet両方試行)
NORM_PROTO = DEV_PROTO
call normalize_proto
ORIG_DEV_PROTO = NORM_PROTO

strlen ORIG_DEV_PROTO
if result = 0 then
    HAS_ORIG_PROTO = 0
    DEV_PROTO = 'ssh'
else
    HAS_ORIG_PROTO = 1
    DEV_PROTO = ORIG_DEV_PROTO
endif

; 3) コマンドファイル未指定時: 汎用コマンドファイルを使用
strlen DEV_CMD
if result = 0 then
    DEV_CMD = DEFAULT_CMD
endif

; コマンドファイルの相対パス解決
strscan DEV_CMD '\'
if result = 0 then
    strscan DEV_CMD '/'
    if result = 0 then
        strscan DEV_CMD ':'
        if result = 0 then
            sprintf '%s\%s' BASE_DIR DEV_CMD
            DEV_CMD = inputstr
        endif
    endif
endif

; 機器処理用の管理変数を初期化
DEV_STATUS = 'NG'
DEV_DETAIL = 'Unknown'
LAST_FAIL_DETAIL = ''
FINAL_PROMPT = '?'
PROMPT_SYMBOL = '?'
IS_LOG_OPEN = 0
IS_DEVICE_LOGGED_IN = 0
AUTH_ATTEMPT = 0
F_CRED_OPEN = 0
F_CRED_TRIED = 0
PROTO_DUAL_PHASE = 0
SKIP_RETRY_WAIT = 0
SSH_PORT_DEAD = 0
TELNET_PORT_DEAD = 0
ENABLE_FAILED = 0
ACTIVE_USER = ''
ACTIVE_PASS = ''
ACTIVE_ENPASS = ''

; ------------------------------------------------------
; ★【認証情報の優先順位判定】
;   1. device.csv にユーザー名/パスワード記載あり -> そちらを最優先で試行
;   2. device.csv が空欄 -> 外部パスワードCSV (credentials.csv) を順次試行
;   3. 外部CSVも未設定 -> 踏み台の認証情報で試行
; ------------------------------------------------------
HAS_DEV_CRED = 0
strlen DEV_USER
if result > 0 then
    HAS_DEV_CRED = 1
endif
strlen DEV_PASS
if result > 0 then
    HAS_DEV_CRED = 1
endif

; インラインパイプ指定用のキュー初期化
REMAIN_USERS = DEV_USER
REMAIN_PASS  = DEV_PASS
LAST_USER    = ''
LAST_PASS    = ''

; グローバル候補プールが指定されていればキュー末尾に連結
strlen GLOBAL_CRED_USERS
if result > 0 then
    strlen REMAIN_USERS
    if result > 0 then
        strconcat REMAIN_USERS '|'
        strconcat REMAIN_USERS GLOBAL_CRED_USERS
    else
        REMAIN_USERS = GLOBAL_CRED_USERS
    endif
endif
strlen GLOBAL_CRED_PASSES
if result > 0 then
    strlen REMAIN_PASS
    if result > 0 then
        strconcat REMAIN_PASS '|'
        strconcat REMAIN_PASS GLOBAL_CRED_PASSES
    else
        REMAIN_PASS = GLOBAL_CRED_PASSES
    endif
endif

; 1) device.csv に固有指定があればまずそれを試行
if HAS_DEV_CRED = 1 then
    goto try_inline_credential
endif

; 2) device.csv が空欄で外部パスワードCSVが有効なら外部CSVから試行開始
strlen CRED_FILE
if result > 0 then
    goto open_cred_csv_file
endif

; 3) 外部CSVも未設定で、グローバル候補プールがあれば試行
strlen REMAIN_USERS
R_ULEN = result
strlen REMAIN_PASS
R_PLEN = result
if R_ULEN > 0 or R_PLEN > 0 then
    goto try_inline_credential
endif

; 4) いずれも無ければ、踏み台認証流用が許可されている場合のみ試行 (デフォルトはNG終了)
if FALLBACK_TO_BASTION_CRED = 1 then
    ACTIVE_USER = BASTION_USER
    ACTIVE_PASS = BASTION_PASS
    ACTIVE_ENPASS = BASTION_PASS
    AUTH_ATTEMPT = 1
    if HAS_ORIG_PROTO = 0 then
        DEV_PROTO = 'ssh'
        PROTO_DUAL_PHASE = 1
    else
        DEV_PROTO = ORIG_DEV_PROTO
        PROTO_DUAL_PHASE = 0
    endif
    goto issue_connect_cmd
endif

DEV_STATUS = 'NG'
DEV_DETAIL = 'No Credentials (credentials.csv missing)'
goto record_result


; ==============================================================================
; 7. 対象機器への接続試行ループ
; ==============================================================================

; --- A) device.csv 側の指定（単一指定またはパイプ複数指定）から候補を取り出し ---
:try_inline_credential
call pop_next_credential
if HAS_CRED = 0 then
    ; インライン候補が尽きた場合、フォールバック許可時なら外部CSVへ移行
    strlen CRED_FILE
    if result > 0 and F_CRED_TRIED = 0 then
        if HAS_DEV_CRED = 0 or FALLBACK_TO_CRED_FILE = 1 then
            goto open_cred_csv_file
        endif
    endif
    DEV_STATUS = 'NG'
    if AUTH_ATTEMPT > 1 then
        sprintf 'All %d Auth Attempts Failed' AUTH_ATTEMPT
        DEV_DETAIL = inputstr
    else
        strlen LAST_FAIL_DETAIL
        if result > 0 then
            DEV_DETAIL = LAST_FAIL_DETAIL
        else
            DEV_DETAIL = 'Auth Failed'
        endif
    endif
    goto record_result
endif

ACTIVE_USER = CURR_USER
ACTIVE_PASS = CURR_PASS
ACTIVE_ENPASS = DEV_ENPASS
strlen ACTIVE_ENPASS
if result = 0 then
    ACTIVE_ENPASS = ACTIVE_PASS
endif

if HAS_ORIG_PROTO = 0 then
    if SSH_PORT_DEAD = 0 and TELNET_PORT_DEAD = 0 then
        DEV_PROTO = 'ssh'
        PROTO_DUAL_PHASE = 1
    elseif SSH_PORT_DEAD = 0 then
        DEV_PROTO = 'ssh'
        PROTO_DUAL_PHASE = 0
    elseif TELNET_PORT_DEAD = 0 then
        DEV_PROTO = 'telnet'
        PROTO_DUAL_PHASE = 0
    else
        DEV_STATUS = 'NG'
        DEV_DETAIL = 'Connection Refused (SSH & Telnet)'
        goto record_result
    endif
else
    DEV_PROTO = ORIG_DEV_PROTO
    PROTO_DUAL_PHASE = 0
endif

AUTH_ATTEMPT = AUTH_ATTEMPT + 1
goto issue_connect_cmd


; --- B) 外部パスワードCSVファイル (credentials.csv) から候補を取り出し ---
:open_cred_csv_file
F_CRED_TRIED = 1
fileopen f_cred CRED_FILE 0 1
if f_cred = -1 then
    if AUTH_ATTEMPT > 0 then
        DEV_STATUS = 'NG'
        goto record_result
    endif
    if FALLBACK_TO_BASTION_CRED = 1 then
        ACTIVE_USER = BASTION_USER
        ACTIVE_PASS = BASTION_PASS
        ACTIVE_ENPASS = BASTION_PASS
        AUTH_ATTEMPT = 1
        if HAS_ORIG_PROTO = 0 then
            DEV_PROTO = 'ssh'
            PROTO_DUAL_PHASE = 1
        else
            DEV_PROTO = ORIG_DEV_PROTO
            PROTO_DUAL_PHASE = 0
        endif
        goto issue_connect_cmd
    endif
    DEV_STATUS = 'NG'
    DEV_DETAIL = 'Credentials CSV Open Failed'
    goto record_result
endif
F_CRED_OPEN = 1

:read_cred_csv_loop
filereadln f_cred cred_line
if result = 1 then
    ; 外部パスワードCSVの末尾(EOF)到達（全候補失敗）
    fileclose f_cred
    F_CRED_OPEN = 0
    DEV_STATUS = 'NG'
    if AUTH_ATTEMPT > 1 then
        sprintf 'All %d Auth Attempts Failed (Password CSV exhausted)' AUTH_ATTEMPT
        DEV_DETAIL = inputstr
    elseif AUTH_ATTEMPT = 1 then
        strlen LAST_FAIL_DETAIL
        if result > 0 then
            DEV_DETAIL = LAST_FAIL_DETAIL
        else
            DEV_DETAIL = 'Auth Failed'
        endif
    else
        ; 1件も試行できなかった場合 (プロトコル一致候補なし等)
        strlen LAST_FAIL_DETAIL
        if result > 0 then
            DEV_DETAIL = LAST_FAIL_DETAIL
        else
            DEV_DETAIL = 'No Matching Credential in CSV'
        endif
    endif
    goto record_result
endif

; 行トリム
TRIM_VAL = cred_line
call trim_string
cred_line = TRIM_VAL

strlen cred_line
if result = 0 goto read_cred_csv_loop

; コメント行スキップ (# または ;)
strcopy cred_line 1 1 fc_cred
strcompare fc_cred '#'
if result = 0 goto read_cred_csv_loop
strcompare fc_cred ';'
if result = 0 goto read_cred_csv_loop

; パスワードCSV行のパース (ユーザー名, パスワード, 管理者PW, プロトコル)
PARSE_CRED_STR = cred_line
call parse_cred_line

; ヘッダ行スキップ
strcompare C_USER 'ユーザー名'
if result = 0 goto read_cred_csv_loop
strcompare C_USER 'username'
if result = 0 goto read_cred_csv_loop
strcompare C_USER 'Username'
if result = 0 goto read_cred_csv_loop

; 空行スキップ
strlen C_USER
CU_LEN = result
strlen C_PASS
CP_LEN = result
if CU_LEN = 0 and CP_LEN = 0 goto read_cred_csv_loop

if CU_LEN = 0 then
    if FALLBACK_TO_BASTION_CRED = 1 then
        C_USER = BASTION_USER
    else
        C_USER = ''
    endif
endif
if CP_LEN = 0 then
    if FALLBACK_TO_BASTION_CRED = 1 then
        C_PASS = BASTION_PASS
    else
        C_PASS = ''
    endif
endif
strlen C_ENPASS
if result = 0 then
    C_ENPASS = C_PASS
endif

; CSV第4列(プロトコル)を小文字正規化 ('ssh' / 'telnet' / '')
NORM_PROTO = C_PROTO
call normalize_proto
C_PROTO = NORM_PROTO

; --- プロトコル適合性チェック & 選択 ---
strlen C_PROTO
CP_PROTO_LEN = result

if HAS_ORIG_PROTO = 1 then
    ; device.csv でプロトコルが元々指定されている場合:
    ; credentials.csv 側にプロトコル指定があり、かつ一致しない行はスキップ
    if CP_PROTO_LEN > 0 then
        strcompare C_PROTO ORIG_DEV_PROTO
        if result <> 0 goto read_cred_csv_loop
    endif
    DEV_PROTO = ORIG_DEV_PROTO
    PROTO_DUAL_PHASE = 0
else
    ; device.csv でプロトコルが元々未指定の場合: 両方試行対応
    if CP_PROTO_LEN > 0 then
        ; credentials.csv 側で指定されているプロトコルを使用 (既に閉鎖判明済みのポートはスキップ)
        strcompare C_PROTO 'ssh'
        if result = 0 then
            if SSH_PORT_DEAD = 1 goto read_cred_csv_loop
        endif
        strcompare C_PROTO 'telnet'
        if result = 0 then
            if TELNET_PORT_DEAD = 1 goto read_cred_csv_loop
        endif
        DEV_PROTO = C_PROTO
        PROTO_DUAL_PHASE = 0
    else
        ; どちらも未指定なら両方試す (まずSSH、失敗時Telnet)
        if SSH_PORT_DEAD = 0 and TELNET_PORT_DEAD = 0 then
            DEV_PROTO = 'ssh'
            PROTO_DUAL_PHASE = 1
        elseif SSH_PORT_DEAD = 0 then
            DEV_PROTO = 'ssh'
            PROTO_DUAL_PHASE = 0
        elseif TELNET_PORT_DEAD = 0 then
            DEV_PROTO = 'telnet'
            PROTO_DUAL_PHASE = 0
        else
            ; SSHもTelnetも両方ポート拒否と判明済みなら即座に終了
            fileclose f_cred
            F_CRED_OPEN = 0
            DEV_STATUS = 'NG'
            DEV_DETAIL = 'Connection Refused (SSH & Telnet)'
            goto record_result
        endif
    endif
endif

; 直前の device.csv 固有認証と全く同一なら二重試行をスキップ
if HAS_DEV_CRED = 1 and HAS_ORIG_PROTO = 1 and AUTH_ATTEMPT = 1 then
    strcompare C_USER DEV_USER
    if result = 0 then
        strcompare C_PASS DEV_PASS
        if result = 0 goto read_cred_csv_loop
    endif
endif

AUTH_ATTEMPT = AUTH_ATTEMPT + 1
ACTIVE_USER = C_USER
ACTIVE_PASS = C_PASS
ACTIVE_ENPASS = C_ENPASS
goto issue_connect_cmd


; --- C) 接続コマンド発行 (SSH / Telnet + 踏み台復帰マーカー) ---
:issue_connect_cmd
; 2回目以降の試行時はウェイトを挿入（実機のブルートフォース防御回避。プロトコル切替時は即試行）
if AUTH_ATTEMPT > 1 and SKIP_RETRY_WAIT = 0 then
    if AUTH_RETRY_INTERVAL > 0 then
        pause AUTH_RETRY_INTERVAL
    else
        mpause 200
    endif
endif
SKIP_RETRY_WAIT = 0

; 認証試行履歴ログに現在の試行内容(ユーザー名・パスワード・プロトコル)を記録
getdate TS '%Y/%m/%d %H:%M:%S'
fileopen f_att ATTEMPT_LOG_FILE 1
if f_att <> -1 then
    sprintf '%s,%s,%s,#%d,%s,%s,%s,TRYING' TS DEV_NAME DEV_IP AUTH_ATTEMPT DEV_PROTO ACTIVE_USER ACTIVE_PASS
    filewriteln f_att inputstr
    fileclose f_att
endif

; 実行中のTera Term画面でも現在試行中のパスワード・ユーザー・プロトコルをリアルタイム表示
if paramcnt < 3 then
    sprintf '[#%d %s] %s (%s) %s' AUTH_ATTEMPT DEV_PROTO DEV_NAME DEV_IP ACTIVE_USER
    settitle inputstr

    sprintf '機器: %s (%s)' DEV_NAME DEV_IP
    DLG_MSG = inputstr
    strconcat DLG_MSG CRLF
    sprintf 'プロトコル: %s / 試行: #%d' DEV_PROTO AUTH_ATTEMPT
    strconcat DLG_MSG inputstr
    strconcat DLG_MSG CRLF
    sprintf 'ユーザー: %s' ACTIVE_USER
    strconcat DLG_MSG inputstr
    strconcat DLG_MSG CRLF
    sprintf 'パスワード: %s' ACTIVE_PASS
    strconcat DLG_MSG inputstr
    statusbox DLG_MSG '接続・認証試行中'
endif

testlink
if result <> 2 goto bastion_disconnected
flushrecv

strcompare DEV_PROTO 'telnet'
if result = 0 goto do_telnet

; --- SSH接続コマンド発行 (255バイト制限を回避するため分割送信) ---
; NumberOfPasswordPrompts=1 により、PW誤り時にSSHが即座に正常終了して踏み台へ戻ります
send 'ssh -o NumberOfPasswordPrompts=1 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null '
strlen SSH_EXTRA_OPTS
if result > 0 then
    send SSH_EXTRA_OPTS
    send ' '
endif
strlen ACTIVE_USER
if result > 0 then
    send ACTIVE_USER
    send '@'
endif
send DEV_IP
sendln ' ; echo "__BAS""TION_RETURN__"'
goto login_negotiate_loop

; --- Telnet接続コマンド発行 ---
:do_telnet
send 'telnet '
send DEV_IP
sendln ' ; echo "__BAS""TION_RETURN__"'


; ==============================================================================
; 8. 2段階ログイン交渉ループ (SSH / Telnet 完全対応・誤検知防止)
; ==============================================================================
:login_negotiate_loop
LOGIN_SUCCESS = 0
INIT_PROMPT_IDX = 0
STAGE1_USER_SENT = 0

; ------------------------------------------------------
; 【第1段階】パスワード送信前の待機 (バナー内の '#', '>', '$' に誤反応しない)
; ------------------------------------------------------
:login_stage1_loop
timeout = LOGIN_TIMEOUT
; wait引数(10個厳守):
; 1:__BASTION_RETURN__, 2:yes/no, 3:login:, 4:Login:, 5:Username:,
; 6:User:, 7:assword:, 8:no matching, 9:refused, 10:unreachable
wait '__BASTION_RETURN__' 'yes/no' 'login:' 'Login:' 'Username:' 'User:' 'assword:' 'no matching' 'refused' 'unreachable'
STAGE1_RES = result

if STAGE1_RES = 1 then
    ; SSH/Telnetがパスワード画面前に終了して踏み台に戻った
    mpause 200
    flushrecv
    strcompare DEV_PROTO 'telnet'
    if result = 0 then
        ; Telnetは接続に認証情報を使わないため、ログイン画面前に閉じた場合はTelnet非対応と確定
        TELNET_PORT_DEAD = 1
        LAST_FAIL_DETAIL = 'Telnet Not Accepted / Closed by Host'
        if HAS_ORIG_PROTO = 1 or SSH_PORT_DEAD = 1 then
            DEV_STATUS = 'NG'
            DEV_DETAIL = LAST_FAIL_DETAIL
            goto record_result
        endif
        goto check_next_credential
    endif
    LAST_FAIL_DETAIL = 'Connection Failed / Closed by Host'
    goto check_next_credential
endif

if STAGE1_RES = 2 then
    ; 初回SSH接続時のフィンガープリント確認 (yes/no)
    testlink
    if result <> 2 goto bastion_disconnected
    sendln 'yes'
    goto login_stage1_loop
endif

if STAGE1_RES >= 3 and STAGE1_RES <= 6 then
    ; ユーザー名入力要求 (login: / Login: / Username: / User:)
    STAGE1_USER_SENT = STAGE1_USER_SENT + 1
    if STAGE1_USER_SENT >= 2 then
        ; 同一接続内で2回目のユーザー名再要求 -> 認証失敗として次候補へ
        mpause 200
        flushrecv
        call abort_to_bastion
        LAST_FAIL_DETAIL = 'Auth Failed (Username Rejected)'
        goto check_next_credential
    endif
    testlink
    if result <> 2 goto bastion_disconnected
    sendln ACTIVE_USER
    goto login_stage1_loop
endif

if STAGE1_RES = 7 then
    ; パスワード入力要求 (Password:) -> パスワードを送信して【第2段階】へ進む
    testlink
    if result <> 2 goto bastion_disconnected
    sendln ACTIVE_PASS
    goto login_stage2_wait
endif

if STAGE1_RES = 8 then
    ; 古い機器でSSH鍵交換アルゴリズム等が不一致の場合
    timeout = 5
    wait '__BASTION_RETURN__'
    SSH_PORT_DEAD = 1
    LAST_FAIL_DETAIL = 'SSH Algorithm Mismatch (Check SSH_EXTRA_OPTS)'
    if PROTO_DUAL_PHASE = 1 then
        SKIP_RETRY_WAIT = 1
        goto check_next_credential
    endif
    if HAS_ORIG_PROTO = 0 and F_CRED_OPEN = 1 then
        SKIP_RETRY_WAIT = 1
        goto check_next_credential
    endif
    DEV_STATUS = 'NG'
    DEV_DETAIL = LAST_FAIL_DETAIL
    goto record_result
endif

if STAGE1_RES = 9 then
    ; Connection refused (対象ポートが閉じている)
    timeout = 5
    wait '__BASTION_RETURN__'
    strcompare DEV_PROTO 'ssh'
    if result = 0 then
        SSH_PORT_DEAD = 1
    else
        TELNET_PORT_DEAD = 1
    endif
    LAST_FAIL_DETAIL = 'Connection Refused / Unreachable'
    if HAS_ORIG_PROTO = 0 then
        ; プロトコル未指定機器なら別プロトコル(例: SSH拒否 -> Telnet)を待機なしで即試行
        if SSH_PORT_DEAD = 1 and TELNET_PORT_DEAD = 1 then
            DEV_STATUS = 'NG'
            DEV_DETAIL = 'Connection Refused (SSH & Telnet)'
            goto record_result
        endif
        SKIP_RETRY_WAIT = 1
        goto check_next_credential
    endif
    DEV_STATUS = 'NG'
    DEV_DETAIL = LAST_FAIL_DETAIL
    goto record_result
endif

if STAGE1_RES = 10 then
    ; Network is unreachable (到達不能)
    timeout = 5
    wait '__BASTION_RETURN__'
    DEV_STATUS = 'NG'
    DEV_DETAIL = 'Connection Refused / Unreachable'
    goto record_result
endif

if STAGE1_RES = 0 then
    ; タイムアウト時: 古いバナーをクリアしてからEnterを1回送り、状態を確認
    testlink
    if result <> 2 goto bastion_disconnected
    flushrecv
    sendln ''
    timeout = 5
    ; wait引数(10個厳守):
    ; 1:__BASTION_RETURN__, 2:assword:, 3:login:, 4:Login:, 5:Username:, 6:invalid, 7:>, 8:#, 9:$, 10:]
    wait '__BASTION_RETURN__' 'assword:' 'login:' 'Login:' 'Username:' 'invalid' '>' '#' '$' ']'
    if result = 1 then
        strcompare DEV_PROTO 'telnet'
        if result = 0 then
            if STAGE1_USER_SENT = 0 then
                TELNET_PORT_DEAD = 1
                LAST_FAIL_DETAIL = 'Telnet Not Accepted / Closed'
                if HAS_ORIG_PROTO = 1 or SSH_PORT_DEAD = 1 then
                    DEV_STATUS = 'NG'
                    DEV_DETAIL = LAST_FAIL_DETAIL
                    goto record_result
                endif
                goto check_next_credential
            endif
        endif
        LAST_FAIL_DETAIL = 'Connection Timed Out / Closed'
        goto check_next_credential
    endif
    if result = 2 then
        testlink
        if result <> 2 goto bastion_disconnected
        sendln ACTIVE_PASS
        goto login_stage2_wait
    endif
    if result >= 3 and result <= 5 then
        if STAGE1_USER_SENT = 0 then
            STAGE1_USER_SENT = 1
            testlink
            if result <> 2 goto bastion_disconnected
            sendln ACTIVE_USER
            goto login_stage1_loop
        endif
        mpause 200
        flushrecv
        call abort_to_bastion
        LAST_FAIL_DETAIL = 'Auth Failed (Login Prompt)'
        goto check_next_credential
    endif
    if result = 6 then
        mpause 200
        flushrecv
        call abort_to_bastion
        LAST_FAIL_DETAIL = 'Auth Failed (Invalid)'
        goto check_next_credential
    endif
    if result >= 7 and result <= 10 then
        LOGIN_SUCCESS = 1
        if result = 7 then
            INIT_PROMPT_IDX = 1
        elseif result = 8 then
            INIT_PROMPT_IDX = 2
        elseif result = 9 then
            INIT_PROMPT_IDX = 3
        else
            INIT_PROMPT_IDX = 5
        endif
        IS_DEVICE_LOGGED_IN = 1
        goto login_success_exit
    endif

    ; 応答なし -> 接続試行を安全に中断して踏み台へ復帰
    call abort_to_bastion
    strcompare DEV_PROTO 'telnet'
    if result = 0 then
        if STAGE1_USER_SENT = 0 then
            ; Telnetで一度もログイン画面が出ずにタイムアウト -> Telnet非対応と確定し以降のTelnet試行を停止
            TELNET_PORT_DEAD = 1
            LAST_FAIL_DETAIL = 'Telnet Not Accepted (Timeout)'
            if HAS_ORIG_PROTO = 1 or SSH_PORT_DEAD = 1 then
                DEV_STATUS = 'NG'
                DEV_DETAIL = LAST_FAIL_DETAIL
                goto record_result
            endif
            goto check_next_credential
        endif
    endif
    LAST_FAIL_DETAIL = 'Login Timeout'
    goto check_next_credential
endif

; ------------------------------------------------------
; 【第2段階】パスワード送信後のプロンプト待機
;   ※ 'Last login:' や 'Last failed login:' 等のログイン成功直後メッセージに
;      誤反応しないよう、具体的な認証失敗フレーズのみを判定します。
;   ※ '%' はCiscoエラーメッセージ先頭と被るため絶対に待機対象に含めません。
; ------------------------------------------------------
:login_stage2_wait
timeout = LOGIN_TIMEOUT
; wait引数(10個厳守):
; 1:__BASTION_RETURN__, 2:assword:, 3:Permission denied, 4:Login invalid,
; 5:Authentication failed, 6:incorrect, 7:Username:, 8:>, 9:#, 10:$
wait '__BASTION_RETURN__' 'assword:' 'Permission denied' 'Login invalid' 'Authentication failed' 'incorrect' 'Username:' '>' '#' '$'

if result = 1 then
    ; パスワード送信直後に切断されて踏み台へ戻った
    mpause 200
    flushrecv
    LAST_FAIL_DETAIL = 'Auth Rejected / Closed by Host'
    goto check_next_credential
endif

if result >= 2 and result <= 7 then
    ; 認証失敗: Telnetの場合のみ後続プロンプトを掃除。SSHは__BASTION_RETURN__を消さないようそのまま復帰へ
    strcompare DEV_PROTO 'telnet'
    if result = 0 then
        mpause 300
        flushrecv
    endif
    call abort_to_bastion
    LAST_FAIL_DETAIL = 'Auth Failed (Wrong Password)'
    goto check_next_credential
endif

if result >= 8 and result <= 10 then
    ; ログイン成功！対象機器のプロンプトに到達
    LOGIN_SUCCESS = 1
    if result = 8 then
        ; 一般モード (>)
        INIT_PROMPT_IDX = 1
    elseif result = 9 then
        ; 特権モード (#)
        INIT_PROMPT_IDX = 2
    else
        ; シェルモード ($)
        INIT_PROMPT_IDX = 3
    endif
    IS_DEVICE_LOGGED_IN = 1
    goto login_success_exit
endif

if result = 0 then
    ; パスワード送信後にタイムアウトした場合、古い文字を掃除してEnterを1回送り再確認
    testlink
    if result <> 2 goto bastion_disconnected
    flushrecv
    sendln ''
    timeout = 5
    ; wait引数(10個厳守):
    ; 1:__BASTION_RETURN__, 2:assword:, 3:Permission denied, 4:Login invalid,
    ; 5:Authentication failed, 6:incorrect, 7:Username:, 8:>, 9:#, 10:$
    wait '__BASTION_RETURN__' 'assword:' 'Permission denied' 'Login invalid' 'Authentication failed' 'incorrect' 'Username:' '>' '#' '$'
    if result = 1 then
        mpause 200
        flushrecv
        LAST_FAIL_DETAIL = 'Auth Rejected / Closed by Host'
        goto check_next_credential
    endif
    if result >= 2 and result <= 7 then
        strcompare DEV_PROTO 'telnet'
        if result = 0 then
            mpause 300
            flushrecv
        endif
        call abort_to_bastion
        LAST_FAIL_DETAIL = 'Auth Failed (Wrong Password)'
        goto check_next_credential
    endif
    if result >= 8 and result <= 10 then
        LOGIN_SUCCESS = 1
        if result = 8 then
            INIT_PROMPT_IDX = 1
        elseif result = 9 then
            INIT_PROMPT_IDX = 2
        else
            INIT_PROMPT_IDX = 3
        endif
        IS_DEVICE_LOGGED_IN = 1
        goto login_success_exit
    endif

    call abort_to_bastion
    LAST_FAIL_DETAIL = 'Post-Auth Timeout'
    goto check_next_credential
endif

; ------------------------------------------------------
; ★【認証失敗時の次候補判定】
; ------------------------------------------------------
:check_next_credential
; 両方試すモード (PROTO_DUAL_PHASE = 1: SSH失敗時) なら、同一認証情報でTelnetを試行
if PROTO_DUAL_PHASE = 1 then
    PROTO_DUAL_PHASE = 2
    if TELNET_PORT_DEAD = 0 then
        DEV_PROTO = 'telnet'
        AUTH_ATTEMPT = AUTH_ATTEMPT + 1
        goto issue_connect_cmd
    endif
endif
PROTO_DUAL_PHASE = 0

; 1) 外部パスワードCSVファイルがすでに開いている場合は、次の行を読む
if F_CRED_OPEN = 1 then
    goto read_cred_csv_loop
endif

; 2) インライン指定キューに残候補があれば次を取り出す
strlen REMAIN_USERS
REM_U_LEN = result
strlen REMAIN_PASS
REM_P_LEN = result
if REM_U_LEN > 0 or REM_P_LEN > 0 then
    goto try_inline_credential
endif

; 3) インライン指定が尽き、外部パスワードCSVがあり、かつフォールバック許可時なら外部ファイルを開く
strlen CRED_FILE
if result > 0 and F_CRED_TRIED = 0 then
    if HAS_DEV_CRED = 0 or FALLBACK_TO_CRED_FILE = 1 then
        goto open_cred_csv_file
    endif
endif

; すべての認証候補が尽きた場合はNGとして結果記録へ
DEV_STATUS = 'NG'
if AUTH_ATTEMPT > 1 then
    sprintf 'All %d Auth Attempts Failed' AUTH_ATTEMPT
    DEV_DETAIL = inputstr
else
    strlen LAST_FAIL_DETAIL
    if result > 0 then
        DEV_DETAIL = LAST_FAIL_DETAIL
    else
        DEV_DETAIL = 'Auth Failed'
    endif
endif
goto record_result


:login_success_exit
if LOGIN_SUCCESS = 0 then
    DEV_DETAIL = 'Login Failed'
    goto cleanup_device
endif

; 外部パスワードファイルが開いていれば即座にクローズ
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif

; 認証に成功したユーザー名・パスワードを変数に確定
DEV_USER = ACTIVE_USER
DEV_PASS = ACTIVE_PASS

; 管理者(enable)パスワードの設定
strlen ACTIVE_ENPASS
if result > 0 then
    DEV_ENPASS = ACTIVE_ENPASS
else
    strlen DEV_ENPASS
    if result = 0 then
        DEV_ENPASS = ACTIVE_PASS
    endif
endif

; ログイン直後のバナー残骸をクリア
mpause 400
flushrecv


; ==============================================================================
; 9. 特権モード(管理者昇格)の自動適応
; ==============================================================================
; 初期プロンプトが既に特権(#)やLinuxシェル($)の場合は昇格処理をスキップ
if INIT_PROMPT_IDX >= 2 goto disable_paging

testlink
if result <> 2 goto bastion_disconnected

; 初期プロンプトが一般モード (>) の場合のみ特権昇格を試行
sendln 'enable'
timeout = 5
; wait引数(10個厳守):
; 1:__BASTION_RETURN__, 2:assword:, 3:#, 4:], 5:Invalid, 6:Unknown, 7:not found, 8:Error, 9:syntax, 10:>
wait '__BASTION_RETURN__' 'assword:' '#' ']' 'Invalid' 'Unknown' 'not found' 'Error' 'syntax' '>'

if result = 1 then
    IS_DEVICE_LOGGED_IN = 0
    DEV_STATUS = 'NG'
    DEV_DETAIL = 'Disconnected During Enable'
    goto cleanup_done
elseif result = 2 then
    ; Cisco等: 管理者パスワード入力要求
    testlink
    if result <> 2 goto bastion_disconnected
    sendln DEV_ENPASS
    timeout = 5
    ; wait引数(9個): 1:__BASTION_RETURN__, 2:#, 3:], 4:>, 5:assword:, 6:denied, 7:Bad, 8:Invalid, 9:failed
    wait '__BASTION_RETURN__' '#' ']' '>' 'assword:' 'denied' 'Bad' 'Invalid' 'failed'
    if result = 1 then
        IS_DEVICE_LOGGED_IN = 0
        DEV_STATUS = 'NG'
        DEV_DETAIL = 'Disconnected During Enable Password'
        goto cleanup_done
    elseif result >= 5 and result <= 9 then
        ; 管理者パスワード誤り: パスワード待機プロンプトに残らないよう安全に解除
        ENABLE_FAILED = 1
        if result = 5 then
            send #3
            mpause 300
            testlink
            if result <> 2 goto bastion_disconnected
            sendln ''
            timeout = 3
            wait '__BASTION_RETURN__' '>' '#'
            if result = 1 then
                IS_DEVICE_LOGGED_IN = 0
                DEV_STATUS = 'NG'
                DEV_DETAIL = 'Disconnected During Enable Password'
                goto cleanup_done
            endif
        endif
    endif
elseif result >= 5 and result <= 9 then
    ; enable コマンドが拒否された場合 (Yamahaルータ等のため administrator を試行)
    mpause 200
    flushrecv
    testlink
    if result <> 2 goto bastion_disconnected
    sendln 'administrator'
    timeout = 5
    ; wait引数(5個): 1:__BASTION_RETURN__, 2:assword:, 3:#, 4:>, 5:$
    wait '__BASTION_RETURN__' 'assword:' '#' '>' '$'
    if result = 1 then
        IS_DEVICE_LOGGED_IN = 0
        DEV_STATUS = 'NG'
        DEV_DETAIL = 'Disconnected During Administrator Cmd'
        goto cleanup_done
    elseif result = 2 then
        testlink
        if result <> 2 goto bastion_disconnected
        sendln DEV_ENPASS
        timeout = 5
        ; wait引数(6個): 1:__BASTION_RETURN__, 2:#, 3:>, 4:$, 5:assword:, 6:Error
        wait '__BASTION_RETURN__' '#' '>' '$' 'assword:' 'Error'
        if result = 1 then
            IS_DEVICE_LOGGED_IN = 0
            DEV_STATUS = 'NG'
            DEV_DETAIL = 'Disconnected During Administrator Password'
            goto cleanup_done
        elseif result = 5 or result = 6 then
            ENABLE_FAILED = 1
            if result = 5 then
                send #3
                mpause 300
                testlink
                if result <> 2 goto bastion_disconnected
                sendln ''
                timeout = 3
                wait '__BASTION_RETURN__' '>' '#'
                if result = 1 then
                    IS_DEVICE_LOGGED_IN = 0
                    DEV_STATUS = 'NG'
                    DEV_DETAIL = 'Disconnected During Administrator Password'
                    goto cleanup_done
                endif
            endif
        endif
    endif
endif


; ==============================================================================
; 10. ページ送り抑止コマンド送信 & 機器プロンプト文字列の精密取得
; ==============================================================================
:disable_paging
; Linuxシェル ($) の場合はネットワーク機器用ページングコマンドをスキップ
if INIT_PROMPT_IDX = 3 goto detect_final_prompt

timeout = 3
; ※Ciscoエラー('% Invalid input...')に誤反応しないよう '%' は絶対に含めない

; 1) Cisco / Allied Telesis / Alaxala / Fortinet 用
testlink
if result <> 2 goto bastion_disconnected
sendln 'terminal length 0'
wait '__BASTION_RETURN__' 'Invalid' 'Unknown' 'Error' 'syntax' '#' '>' '$' ']'
if result = 1 then
    IS_DEVICE_LOGGED_IN = 0
    DEV_STATUS = 'NG'
    DEV_DETAIL = 'Disconnected During Paging Disable'
    goto cleanup_done
endif
if result >= 6 and result <= 9 goto detect_final_prompt
if result >= 2 and result <= 5 then
    wait '__BASTION_RETURN__' '#' '>' '$' ']'
    if result = 1 then
        IS_DEVICE_LOGGED_IN = 0
        DEV_STATUS = 'NG'
        DEV_DETAIL = 'Disconnected During Paging Disable'
        goto cleanup_done
    endif
endif

; 2) Juniper JunOS 用
testlink
if result <> 2 goto bastion_disconnected
sendln 'set cli screen-length 0'
wait '__BASTION_RETURN__' 'Invalid' 'Unknown' 'Error' 'syntax' '#' '>' '$' ']'
if result = 1 then
    IS_DEVICE_LOGGED_IN = 0
    DEV_STATUS = 'NG'
    DEV_DETAIL = 'Disconnected During Paging Disable'
    goto cleanup_done
endif
if result >= 6 and result <= 9 goto detect_final_prompt
if result >= 2 and result <= 5 then
    wait '__BASTION_RETURN__' '#' '>' '$' ']'
    if result = 1 then
        IS_DEVICE_LOGGED_IN = 0
        DEV_STATUS = 'NG'
        DEV_DETAIL = 'Disconnected During Paging Disable'
        goto cleanup_done
    endif
endif

; 3) Huawei VRP / H3C 用
testlink
if result <> 2 goto bastion_disconnected
sendln 'screen-length 0 temporary'
wait '__BASTION_RETURN__' 'Invalid' 'Unknown' 'Error' 'syntax' '#' '>' '$' ']'
if result = 1 then
    IS_DEVICE_LOGGED_IN = 0
    DEV_STATUS = 'NG'
    DEV_DETAIL = 'Disconnected During Paging Disable'
    goto cleanup_done
endif
if result >= 6 and result <= 9 goto detect_final_prompt
if result >= 2 and result <= 5 then
    wait '__BASTION_RETURN__' '#' '>' '$' ']'
    if result = 1 then
        IS_DEVICE_LOGGED_IN = 0
        DEV_STATUS = 'NG'
        DEV_DETAIL = 'Disconnected During Paging Disable'
        goto cleanup_done
    endif
endif

; 4) Yamaha RTX 用
testlink
if result <> 2 goto bastion_disconnected
sendln 'console lines infinity'
wait '__BASTION_RETURN__' '#' '>' '$' ']'
if result = 1 then
    IS_DEVICE_LOGGED_IN = 0
    DEV_STATUS = 'NG'
    DEV_DETAIL = 'Disconnected During Paging Disable'
    goto cleanup_done
endif


; ------------------------------------------------------
; 【プロンプト文字列の精密取得・妥当性検証】
;   1回目の空改行で機器プロンプトを出力させ、2回目の空改行でその行を改行終端させ、
;   waitln で「機器固有の完全プロンプト文字列（例: RT-CISCO-01#）」を取得します。
;   ※末尾文字がプロンプト記号(#, >, $, ])に一致すること・先頭がエラー記号(%, !, ^)で
;     ないことを厳密検証し、エラー文をプロンプト誤認する事故を完全に防止します。
; ------------------------------------------------------
:detect_final_prompt
mpause 500
flushrecv
testlink
if result <> 2 goto bastion_disconnected
sendln ''
mpause 400
testlink
if result <> 2 goto bastion_disconnected
sendln ''
timeout = 3
; waitln引数(4個): '%' はエラー文誤認の原因になるため絶対に含めない
waitln '#' '>' '$' ']'
WL_RES = result

PROMPT_VALID = 0
if WL_RES >= 1 and WL_RES <= 4 then
    if WL_RES = 1 then
        PROMPT_SYMBOL = '#'
    elseif WL_RES = 2 then
        PROMPT_SYMBOL = '>'
    elseif WL_RES = 3 then
        PROMPT_SYMBOL = '$'
    else
        PROMPT_SYMBOL = ']'
    endif

    TRIM_VAL = inputstr
    call trim_string
    CAND_PROMPT = TRIM_VAL

    strlen CAND_PROMPT
    P_LEN = result
    if P_LEN >= 1 and P_LEN <= 40 then
        strcopy CAND_PROMPT 1 1 P_FIRST
        strcopy CAND_PROMPT P_LEN 1 P_LAST
        strcompare P_LAST PROMPT_SYMBOL
        if result = 0 then
            P_BAD = 0
            strcompare P_FIRST '%'
            if result = 0 then
                P_BAD = 1
            endif
            strcompare P_FIRST '!'
            if result = 0 then
                P_BAD = 1
            endif
            strcompare P_FIRST '^'
            if result = 0 then
                P_BAD = 1
            endif
            if P_BAD = 0 then
                FINAL_PROMPT = CAND_PROMPT
                PROMPT_VALID = 1
            endif
        endif
    endif
endif

if PROMPT_VALID = 0 then
    ; waitln で妥当な完全プロンプトが得られなかった場合は記号フォールバック
    if WL_RES = 0 then
        if INIT_PROMPT_IDX = 1 then
            PROMPT_SYMBOL = '>'
        elseif INIT_PROMPT_IDX = 2 then
            PROMPT_SYMBOL = '#'
        elseif INIT_PROMPT_IDX = 3 then
            PROMPT_SYMBOL = '$'
        elseif INIT_PROMPT_IDX = 5 then
            PROMPT_SYMBOL = ']'
        else
            PROMPT_SYMBOL = '#'
        endif
    endif
    FINAL_PROMPT = PROMPT_SYMBOL
endif

; ログ開始前にバッファ内の残存プロンプトをクリア
mpause 300
flushrecv


; ==============================================================================
; 11. クリーンログ取得開始 (logopen)
; ==============================================================================
getdate DATE_STR '%Y%m%d_%H%M%S'
sprintf '%s\%s_%s.log' LOG_DIR DEV_NAME DATE_STR
LOG_FILE = inputstr

logclose
logopen LOG_FILE 0 0
IS_LOG_OPEN = 1

; ログの先頭にログイン成功アカウントと機器情報を記録
logwrite #13#10
logwrite '=================================================='#13#10
sprintf '# Host: %s (%s) / Protocol: %s / Logged-in User: %s' DEV_NAME DEV_IP DEV_PROTO DEV_USER
logwrite inputstr
logwrite #13#10
logwrite '=================================================='#13#10


; ==============================================================================
; 12. コマンドファイルの順次実行 (ページャー自動検知・スペース送信)
; ==============================================================================
fileopen f_cmd DEV_CMD 0 1
if f_cmd = -1 then
    DEV_DETAIL = 'Command File Not Found'
    goto cleanup_device
endif

:read_cmd_loop
filereadln f_cmd cmd_line
if result = 1 goto end_cmd_loop

; コマンド行の前後空白・BOMをトリム
TRIM_VAL = cmd_line
call trim_string
cmd_line = TRIM_VAL

strlen cmd_line
if result = 0 goto read_cmd_loop

; コメント行 (セミコロン ; または シャープ #) はスキップ
strcopy cmd_line 1 1 c_char
strcompare c_char ';'
if result = 0 goto read_cmd_loop
strcompare c_char '#'
if result = 0 goto read_cmd_loop

; ログ内に実行コマンドの見出しを記録
logwrite #13#10
logwrite '==================== [ '
logwrite cmd_line
logwrite ' ] ===================='
logwrite #13#10

; コマンドを機器に送信
testlink
if result <> 2 goto bastion_disconnected
sendln cmd_line

; コマンド実行結果の待機ループ (ページング表示 --More-- の自動解除 & 途中切断検知)
:wait_cmd_prompt
timeout = CMD_TIMEOUT
; wait 最大10引数厳守 (9個):
; 1:FINAL_PROMPT, 2:--More--, 3:-- More --, 4:---(more, 5:More:, 6:続く, 7:RETURN, 8:any key, 9:__BASTION_RETURN__
wait FINAL_PROMPT '--More--' '-- More --' '---(more' 'More:' '続く' 'RETURN' 'any key' '__BASTION_RETURN__'

if result = 1 goto read_cmd_loop

if result >= 2 and result <= 6 then
    ; ページャー表示(--More--等)が出現したため、スペースキーを送信して続きを表示
    send ' '
    goto wait_cmd_prompt
endif

if result >= 7 and result <= 8 then
    ; RETURN / any key 表示が出現したため、Enterキーを送信
    sendln ''
    goto wait_cmd_prompt
endif

if result = 9 then
    ; コマンド実行中に相手機器から切断されて踏み台に戻った場合
    fileclose f_cmd
    IS_DEVICE_LOGGED_IN = 0
    DEV_DETAIL = 'Disconnected During Command'
    goto cleanup_done
endif

; タイムアウト時: 空Enterを1回送ってプロンプト復帰を確認（モード変化時の救済）
testlink
if result <> 2 goto bastion_disconnected
sendln ''
timeout = 3
wait FINAL_PROMPT PROMPT_SYMBOL '__BASTION_RETURN__'
if result = 3 then
    fileclose f_cmd
    IS_DEVICE_LOGGED_IN = 0
    DEV_DETAIL = 'Disconnected During Command'
    goto cleanup_done
endif
goto read_cmd_loop

:end_cmd_loop
fileclose f_cmd
DEV_STATUS = 'OK'
if ENABLE_FAILED = 1 then
    DEV_DETAIL = 'Success (Enable Failed - User Mode)'
elseif AUTH_ATTEMPT > 1 then
    sprintf 'Success (Candidate #%d matched)' AUTH_ATTEMPT
    DEV_DETAIL = inputstr
else
    DEV_DETAIL = 'Success'
endif


; ==============================================================================
; 13. 対象機器からの安全切断 (踏み台セッション完全保護)
; ==============================================================================
:cleanup_device
if IS_LOG_OPEN = 1 then
    logclose
    IS_LOG_OPEN = 0
endif

if IS_DEVICE_LOGGED_IN = 1 then
    testlink
    if result <> 2 goto bastion_disconnected

    mpause 300
    flushrecv

    ; 1) 対象機器へのログアウトコマンド (exit) を送信
    sendln 'exit'
    timeout = 7
    ; wait引数(5個): 1:__BASTION_RETURN__, 2:Save new configuration ? (y/n), 3:Save? [yes/no], 4:(y/n), 5:[y/n]
    wait '__BASTION_RETURN__' 'Save new configuration ? (y/n)' 'Save? [yes/no]' '(y/n)' '[y/n]'
    if result = 1 goto cleanup_done
    if result >= 2 and result <= 5 then
        testlink
        if result <> 2 goto bastion_disconnected
        sendln 'n'
        timeout = 7
        wait '__BASTION_RETURN__'
        if result = 1 goto cleanup_done
    endif

    ; 2) exit で戻らなかった場合（Yamaha / Juniper / Huawei 等）、quit コマンドを試行
    ; ※踏み台シェルを巻き添え切断しないよう、2回目の exit は絶対に送信しません
    testlink
    if result <> 2 goto bastion_disconnected
    sendln 'quit'
    timeout = 5
    wait '__BASTION_RETURN__'
    if result = 1 goto cleanup_done

    ; 3) それでも戻らない場合、プロトコル別の安全な強制離脱を実行
    strcompare DEV_PROTO 'ssh'
    if result = 0 then
        ; OpenSSH のエスケープシーケンス (Enter + ~.) でネストSSHのみを安全に切断
        ; ※万一すでに踏み台に戻っていても bash では '~.: command not found' となるだけで無害
        testlink
        if result <> 2 goto bastion_disconnected
        sendln ''
        mpause 200
        send '~.'
        timeout = 3
        wait '__BASTION_RETURN__'
        if result = 1 goto cleanup_done
    endif
    call abort_to_bastion
endif

:cleanup_done
IS_DEVICE_LOGGED_IN = 0
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif

mpause 200
flushrecv

if IS_LOG_OPEN = 1 then
    logclose
    IS_LOG_OPEN = 0
endif


; ==============================================================================
; 14. サマリCSVへの追記
; ==============================================================================
:record_result
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif

strcompare DEV_STATUS 'OK'
if result = 0 then
    OK_COUNT = OK_COUNT + 1
    fileopen f_res RESOLVED_FILE 1
    if f_res <> -1 then
        sprintf '%s,%s,%s,%s,%s' DEV_NAME DEV_IP DEV_USER DEV_PROTO DEV_STATUS
        filewriteln f_res inputstr
        fileclose f_res
    endif
else
    NG_COUNT = NG_COUNT + 1
    DEV_USER = '-'
endif

getdate TS '%Y/%m/%d %H:%M:%S'
fileopen f_sum SUMMARY_FILE 1
if f_sum <> -1 then
    sprintf '%s,%s,%s,%s,%s,%s,%s,%s' TS DEV_NAME DEV_IP DEV_PROTO PROMPT_SYMBOL DEV_STATUS DEV_DETAIL DEV_USER
    filewriteln f_sum inputstr
    fileclose f_sum
endif

fileopen f_att ATTEMPT_LOG_FILE 1
if f_att <> -1 then
    sprintf '%s,%s,%s,#%d,%s,%s,-,%s (%s)' TS DEV_NAME DEV_IP AUTH_ATTEMPT DEV_PROTO DEV_USER DEV_STATUS DEV_DETAIL
    filewriteln f_att inputstr
    fileclose f_att
endif

; 次の機器へ進む前にウェイトを挿入
if DEVICE_INTERVAL > 0 then
    pause DEVICE_INTERVAL
else
    mpause 300
endif
goto read_csv_loop


; ==============================================================================
; 15. 全機器終了処理 & 完了サマリ通知 (全メッセージ255バイト制限厳守)
; ==============================================================================
:end_csv_loop
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif
fileclose f_csv

if ALREADY_CONNECTED = 0 then
    sendln 'exit'
    disconnect 0
endif

if paramcnt < 3 then
    closesbox
    if NG_COUNT = 0 then
        DLG_MSG = 'ログ収集完了 (全件成功)'
        strconcat DLG_MSG CRLF
        sprintf '結果: 全 %d 台 (成功 %d / 失敗 %d)' TOTAL_COUNT OK_COUNT NG_COUNT
        strconcat DLG_MSG inputstr
        strconcat DLG_MSG CRLF
        strconcat DLG_MSG 'サマリCSV:'
        strconcat DLG_MSG CRLF
        strconcat DLG_MSG SUMMARY_FILE
        messagebox DLG_MSG '完了 (全件成功)'
    else
        DLG_MSG = 'ログ収集完了 (一部エラーあり)'
        strconcat DLG_MSG CRLF
        sprintf '結果: 全 %d 台 (成功 %d / 失敗 %d)' TOTAL_COUNT OK_COUNT NG_COUNT
        strconcat DLG_MSG inputstr
        strconcat DLG_MSG CRLF
        strconcat DLG_MSG '失敗理由はサマリCSVのDetail列を確認:'
        strconcat DLG_MSG CRLF
        strconcat DLG_MSG SUMMARY_FILE
        messagebox DLG_MSG '完了 (要確認あり)'
    endif
endif
end


; ==============================================================================
; 【異常系ハンドラ】踏み台サーバとの通信セッション切断時 (255バイト制限厳守)
; ==============================================================================
:bastion_disconnected
if IS_LOG_OPEN = 1 then
    logclose
    IS_LOG_OPEN = 0
endif
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif
fileclose f_csv

if paramcnt < 3 then
    closesbox
endif

ERROR_MSG = '踏み台サーバとの接続が切断されました。'
strconcat ERROR_MSG CRLF
sprintf '対象: %s (%s)' DEV_NAME DEV_IP
strconcat ERROR_MSG inputstr
strconcat ERROR_MSG CRLF
strconcat ERROR_MSG '原因: 無通信切断(TMOUT)や通信断等'
strconcat ERROR_MSG CRLF
strconcat ERROR_MSG '途中結果:'
strconcat ERROR_MSG CRLF
strconcat ERROR_MSG SUMMARY_FILE

messagebox ERROR_MSG '踏み台切断エラー'
end


; ==============================================================================
; サブルーチン0: 認証失敗・タイムアウト時の安全な踏み台復帰 (SSH / Telnet両対応)
; ==============================================================================
:abort_to_bastion
    ; 1) SSHは終了待ち1秒で即復帰。Telnetは自然終了しないことが多いため即座にCtrl+]へ進む
    strcompare DEV_PROTO 'telnet'
    if result <> 0 then
        timeout = 1
        wait '__BASTION_RETURN__'
        if result = 1 then
            mpause 100
            flushrecv
            return
        endif
    endif

    ; 2) まだ接続が残っている場合、プロトコルに応じた安全な切断コマンドを送信
    strcompare DEV_PROTO 'telnet'
    if result = 0 then
        ; Telnet: まず Ctrl+] (#29) を送り、'telnet>' プロンプトが出た場合のみ 'quit' を送信
        ; (すでに終了していた場合に 'quit' をbashへ誤送信しないための安全策)
        flushrecv
        send #29
        timeout = 2
        wait 'telnet>' '__BASTION_RETURN__'
        if result = 1 then
            testlink
            if result <> 2 goto bastion_disconnected
            sendln 'quit'
            timeout = 3
            wait '__BASTION_RETURN__'
            if result = 1 then
                mpause 200
                flushrecv
                return
            endif
        elseif result = 2 then
            mpause 200
            flushrecv
            return
        endif

        ; 'telnet>' が出ない場合 (Trying... 中でハングしている場合等) は Ctrl+C (#3) で中断
        send #3
        mpause 300
        timeout = 2
        wait '__BASTION_RETURN__'
        if result = 1 then
            mpause 200
            flushrecv
            return
        endif
    else
        ; SSH は Ctrl+C (#3) で認証試行を中断
        send #3
        mpause 300
        timeout = 2
        wait '__BASTION_RETURN__'
        if result = 1 then
            mpause 200
            flushrecv
            return
        endif
    endif

    ; 3) 踏み台復帰マーカーと衝突しない別マーカー (__BASTION_SYNC__) で踏み台シェル復帰を確認
    testlink
    if result <> 2 goto bastion_disconnected
    flushrecv
    sendln 'echo "__BAS""TION_SYNC__"'
    timeout = 3
    wait '__BASTION_SYNC__'
    mpause 200
    flushrecv
return


; ==============================================================================
; サブルーチン1: 4.0x互換 CSV行パーサー (7列対応・空末尾完全対応・前後空白除去)
; ==============================================================================
:parse_csv_line
    COL1 = ''
    COL2 = ''
    COL3 = ''
    COL4 = ''
    COL5 = ''
    COL6 = ''
    COL7 = ''
    PARSE_STR = line

    ; 1列目 (ホスト名)
    strscan PARSE_STR ','
    if result = 0 goto parse_col1_only
    POS = result
    if POS = 1 then
        COL1 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL1
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    if REM_LEN > 0 then
        strcopy PARSE_STR START_POS REM_LEN PARSE_STR
    else
        PARSE_STR = ''
    endif

    ; 2列目 (IPアドレス)
    strscan PARSE_STR ','
    if result = 0 goto parse_col2_only
    POS = result
    if POS = 1 then
        COL2 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL2
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    if REM_LEN > 0 then
        strcopy PARSE_STR START_POS REM_LEN PARSE_STR
    else
        PARSE_STR = ''
    endif

    ; 3列目 (ユーザー名)
    strscan PARSE_STR ','
    if result = 0 goto parse_col3_only
    POS = result
    if POS = 1 then
        COL3 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL3
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    if REM_LEN > 0 then
        strcopy PARSE_STR START_POS REM_LEN PARSE_STR
    else
        PARSE_STR = ''
    endif

    ; 4列目 (パスワード)
    strscan PARSE_STR ','
    if result = 0 goto parse_col4_only
    POS = result
    if POS = 1 then
        COL4 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL4
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    if REM_LEN > 0 then
        strcopy PARSE_STR START_POS REM_LEN PARSE_STR
    else
        PARSE_STR = ''
    endif

    ; 5列目 (管理者パスワード)
    strscan PARSE_STR ','
    if result = 0 goto parse_col5_only
    POS = result
    if POS = 1 then
        COL5 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL5
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    if REM_LEN > 0 then
        strcopy PARSE_STR START_POS REM_LEN PARSE_STR
    else
        PARSE_STR = ''
    endif

    ; 6列目 (プロトコル: ssh / telnet)
    strscan PARSE_STR ','
    if result = 0 goto parse_col6_only
    POS = result
    if POS = 1 then
        COL6 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL6
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    if REM_LEN > 0 then
        strcopy PARSE_STR START_POS REM_LEN PARSE_STR
    else
        PARSE_STR = ''
    endif

    ; 7列目 (コマンドファイル名)
    COL7 = PARSE_STR
    goto parse_assign

    :parse_col1_only
    COL1 = PARSE_STR
    goto parse_assign

    :parse_col2_only
    COL2 = PARSE_STR
    goto parse_assign

    :parse_col3_only
    COL3 = PARSE_STR
    goto parse_assign

    :parse_col4_only
    COL4 = PARSE_STR
    goto parse_assign

    :parse_col5_only
    COL5 = PARSE_STR
    goto parse_assign

    :parse_col6_only
    COL6 = PARSE_STR

    :parse_assign
    TRIM_VAL = COL1
    call trim_string
    DEV_NAME = TRIM_VAL

    TRIM_VAL = COL2
    call trim_string
    DEV_IP = TRIM_VAL

    TRIM_VAL = COL3
    call trim_string
    DEV_USER = TRIM_VAL

    TRIM_VAL = COL4
    call trim_string
    DEV_PASS = TRIM_VAL

    TRIM_VAL = COL5
    call trim_string
    DEV_ENPASS = TRIM_VAL

    TRIM_VAL = COL6
    call trim_string
    DEV_PROTO = TRIM_VAL

    TRIM_VAL = COL7
    call trim_string
    DEV_CMD = TRIM_VAL
return


; ==============================================================================
; サブルーチン2: 文字列前後トリム処理 (空白・タブ・CR・LF・クォート・UTF-8 BOM除去)
; ==============================================================================
:trim_string
    ; UTF-8 BOM (EF BB BF) が先頭に付いていれば除去
    strlen TRIM_VAL
    if result >= 3 then
        strcopy TRIM_VAL 1 3 T_BOM
        strcompare T_BOM #239#187#191
        if result = 0 then
            strlen TRIM_VAL
            T_REM = result - 3
            if T_REM > 0 then
                strcopy TRIM_VAL 4 T_REM TRIM_VAL
            else
                TRIM_VAL = ''
            endif
        endif
    endif

    :trim_lead_loop
    strlen TRIM_VAL
    T_LEN = result
    if T_LEN = 0 goto trim_str_done
    strcopy TRIM_VAL 1 1 T_CHAR
    strcompare T_CHAR ' '
    if result = 0 goto cut_lead
    strcompare T_CHAR #9
    if result = 0 goto cut_lead
    strcompare T_CHAR #13
    if result = 0 goto cut_lead
    strcompare T_CHAR #10
    if result = 0 goto cut_lead
    strcompare T_CHAR '"'
    if result = 0 goto cut_lead
    goto trim_tail_str_loop

    :cut_lead
    if T_LEN = 1 then
        TRIM_VAL = ''
        goto trim_str_done
    endif
    T_REM = T_LEN - 1
    strcopy TRIM_VAL 2 T_REM TRIM_VAL
    goto trim_lead_loop

    :trim_tail_str_loop
    strlen TRIM_VAL
    T_LEN = result
    if T_LEN = 0 goto trim_str_done
    strcopy TRIM_VAL T_LEN 1 T_CHAR
    strcompare T_CHAR ' '
    if result = 0 goto cut_tail
    strcompare T_CHAR #9
    if result = 0 goto cut_tail
    strcompare T_CHAR #13
    if result = 0 goto cut_tail
    strcompare T_CHAR #10
    if result = 0 goto cut_tail
    strcompare T_CHAR '"'
    if result = 0 goto cut_tail
    goto trim_str_done

    :cut_tail
    if T_LEN = 1 then
        TRIM_VAL = ''
        goto trim_str_done
    endif
    T_REM = T_LEN - 1
    strcopy TRIM_VAL 1 T_REM TRIM_VAL
    goto trim_tail_str_loop

    :trim_str_done
return


; ==============================================================================
; サブルーチン3: 認証情報キューから次の (ユーザー名, パスワード) ペアを取り出す
; 入力: REMAIN_USERS, REMAIN_PASS, LAST_USER, LAST_PASS
; 出力: CURR_USER, CURR_PASS, LAST_USER, LAST_PASS, HAS_CRED (0:なし, 1:あり)
; ==============================================================================
:pop_next_credential
    HAS_CRED = 0
    NEXT_U = ''
    NEXT_P = ''

    ; --- ユーザー名キューから1件取り出し ---
    strlen REMAIN_USERS
    if result > 0 then
        strscan REMAIN_USERS '|'
        if result = 0 then
            strscan REMAIN_USERS ';'
        endif
        if result > 0 then
            POP_POS = result
            POP_CUT = POP_POS - 1
            if POP_CUT > 0 then
                strcopy REMAIN_USERS 1 POP_CUT NEXT_U
            else
                NEXT_U = ''
            endif
            strlen REMAIN_USERS
            POP_REM = result - POP_POS
            POP_START = POP_POS + 1
            if POP_REM > 0 then
                strcopy REMAIN_USERS POP_START POP_REM REMAIN_USERS
            else
                REMAIN_USERS = ''
            endif
        else
            NEXT_U = REMAIN_USERS
            REMAIN_USERS = ''
        endif
    endif

    ; --- パスワードキューから1件取り出し ---
    strlen REMAIN_PASS
    if result > 0 then
        strscan REMAIN_PASS '|'
        if result = 0 then
            strscan REMAIN_PASS ';'
        endif
        if result > 0 then
            POP_POS = result
            POP_CUT = POP_POS - 1
            if POP_CUT > 0 then
                strcopy REMAIN_PASS 1 POP_CUT NEXT_P
            else
                NEXT_P = ''
            endif
            strlen REMAIN_PASS
            POP_REM = result - POP_POS
            POP_START = POP_POS + 1
            if POP_REM > 0 then
                strcopy REMAIN_PASS POP_START POP_REM REMAIN_PASS
            else
                REMAIN_PASS = ''
            endif
        else
            NEXT_P = REMAIN_PASS
            REMAIN_PASS = ''
        endif
    endif

    TRIM_VAL = NEXT_U
    call trim_string
    NEXT_U = TRIM_VAL

    TRIM_VAL = NEXT_P
    call trim_string
    NEXT_P = TRIM_VAL

    strlen NEXT_U
    U_LEN = result
    strlen NEXT_P
    P_LEN = result
    if U_LEN = 0 and P_LEN = 0 then
        HAS_CRED = 0
        return
    endif

    ; NEXT_U 内に "user:pass" または "user/pass" 形式のペアが含まれているか判定
    HAS_PAIR = 0
    strscan NEXT_U ':'
    if result > 0 then
        POP_POS = result
        POP_CUT = POP_POS - 1
        if POP_CUT > 0 then
            strcopy NEXT_U 1 POP_CUT CURR_USER
        else
            CURR_USER = ''
        endif
        strlen NEXT_U
        POP_REM = result - POP_POS
        POP_START = POP_POS + 1
        if POP_REM > 0 then
            strcopy NEXT_U POP_START POP_REM CURR_PASS
        else
            CURR_PASS = ''
        endif
        HAS_PAIR = 1
    else
        strscan NEXT_U '/'
        if result > 0 then
            POP_POS = result
            POP_CUT = POP_POS - 1
            if POP_CUT > 0 then
                strcopy NEXT_U 1 POP_CUT CURR_USER
            else
                CURR_USER = ''
            endif
            strlen NEXT_U
            POP_REM = result - POP_POS
            POP_START = POP_POS + 1
            if POP_REM > 0 then
                strcopy NEXT_U POP_START POP_REM CURR_PASS
            else
                CURR_PASS = ''
            endif
            HAS_PAIR = 1
        endif
    endif

    if HAS_PAIR = 0 then
        CURR_USER = NEXT_U
        CURR_PASS = NEXT_P
    endif

    TRIM_VAL = CURR_USER
    call trim_string
    CURR_USER = TRIM_VAL

    TRIM_VAL = CURR_PASS
    call trim_string
    CURR_PASS = TRIM_VAL

    strlen CURR_USER
    if result = 0 then
        strlen LAST_USER
        if result > 0 then
            CURR_USER = LAST_USER
        elseif FALLBACK_TO_BASTION_CRED = 1 then
            CURR_USER = BASTION_USER
        else
            CURR_USER = ''
        endif
    else
        LAST_USER = CURR_USER
    endif

    strlen CURR_PASS
    if result = 0 then
        strlen LAST_PASS
        if result > 0 then
            CURR_PASS = LAST_PASS
        elseif FALLBACK_TO_BASTION_CRED = 1 then
            CURR_PASS = BASTION_PASS
        else
            CURR_PASS = ''
        endif
    else
        LAST_PASS = CURR_PASS
    endif

    HAS_CRED = 1
return


; ==============================================================================
; サブルーチン4: 外部パスワードCSV行パーサー (ユーザー名, パスワード, 管理者PW, プロトコル)
; 入力: PARSE_CRED_STR
; 出力: C_USER, C_PASS, C_ENPASS, C_PROTO
; ==============================================================================
:parse_cred_line
    C_USER = ''
    C_PASS = ''
    C_ENPASS = ''
    C_PROTO = ''

    ; 1列目 (ユーザー名)
    strscan PARSE_CRED_STR ','
    if result = 0 then
        C_USER = PARSE_CRED_STR
        goto parse_cred_assign
    endif
    PC_POS = result
    PC_CUT = PC_POS - 1
    if PC_CUT > 0 then
        strcopy PARSE_CRED_STR 1 PC_CUT C_USER
    else
        C_USER = ''
    endif
    strlen PARSE_CRED_STR
    PC_REM = result - PC_POS
    PC_START = PC_POS + 1
    if PC_REM > 0 then
        strcopy PARSE_CRED_STR PC_START PC_REM PARSE_CRED_STR
    else
        PARSE_CRED_STR = ''
    endif

    ; 2列目 (パスワード)
    strscan PARSE_CRED_STR ','
    if result = 0 then
        C_PASS = PARSE_CRED_STR
        goto parse_cred_assign
    endif
    PC_POS = result
    PC_CUT = PC_POS - 1
    if PC_CUT > 0 then
        strcopy PARSE_CRED_STR 1 PC_CUT C_PASS
    else
        C_PASS = ''
    endif
    strlen PARSE_CRED_STR
    PC_REM = result - PC_POS
    PC_START = PC_POS + 1
    if PC_REM > 0 then
        strcopy PARSE_CRED_STR PC_START PC_REM PARSE_CRED_STR
    else
        PARSE_CRED_STR = ''
    endif

    ; 3列目 (管理者パスワード) & 4列目 (プロトコル)
    strscan PARSE_CRED_STR ','
    if result = 0 then
        C_ENPASS = PARSE_CRED_STR
        goto parse_cred_assign
    endif
    PC_POS = result
    PC_CUT = PC_POS - 1
    if PC_CUT > 0 then
        strcopy PARSE_CRED_STR 1 PC_CUT C_ENPASS
    else
        C_ENPASS = ''
    endif
    strlen PARSE_CRED_STR
    PC_REM = result - PC_POS
    PC_START = PC_POS + 1
    if PC_REM > 0 then
        strcopy PARSE_CRED_STR PC_START PC_REM C_PROTO
    else
        C_PROTO = ''
    endif

    ; 4列目の後ろに余分なカンマ・コメントがあれば切り捨て
    strscan C_PROTO ','
    if result > 0 then
        PC_CUT = result - 1
        if PC_CUT > 0 then
            strcopy C_PROTO 1 PC_CUT C_PROTO
        else
            C_PROTO = ''
        endif
    endif
    strscan C_PROTO '#'
    if result > 0 then
        PC_CUT = result - 1
        if PC_CUT > 0 then
            strcopy C_PROTO 1 PC_CUT C_PROTO
        else
            C_PROTO = ''
        endif
    endif
    strscan C_PROTO ';'
    if result > 0 then
        PC_CUT = result - 1
        if PC_CUT > 0 then
            strcopy C_PROTO 1 PC_CUT C_PROTO
        else
            C_PROTO = ''
        endif
    endif

    :parse_cred_assign
    TRIM_VAL = C_USER
    call trim_string
    C_USER = TRIM_VAL

    TRIM_VAL = C_PASS
    call trim_string
    C_PASS = TRIM_VAL

    TRIM_VAL = C_ENPASS
    call trim_string
    C_ENPASS = TRIM_VAL

    TRIM_VAL = C_PROTO
    call trim_string
    C_PROTO = TRIM_VAL
return


; ==============================================================================
; サブルーチン5: プロトコル文字列の小文字正規化 ('ssh' / 'telnet' / '')
; 入力/出力: NORM_PROTO
; ==============================================================================
:normalize_proto
    strcompare NORM_PROTO 'SSH'
    if result = 0 then
        NORM_PROTO = 'ssh'
        return
    endif
    strcompare NORM_PROTO 'Ssh'
    if result = 0 then
        NORM_PROTO = 'ssh'
        return
    endif
    strcompare NORM_PROTO 'sSh'
    if result = 0 then
        NORM_PROTO = 'ssh'
        return
    endif
    strcompare NORM_PROTO 'ssh2'
    if result = 0 then
        NORM_PROTO = 'ssh'
        return
    endif
    strcompare NORM_PROTO 'SSH2'
    if result = 0 then
        NORM_PROTO = 'ssh'
        return
    endif
    strcompare NORM_PROTO 'TELNET'
    if result = 0 then
        NORM_PROTO = 'telnet'
        return
    endif
    strcompare NORM_PROTO 'Telnet'
    if result = 0 then
        NORM_PROTO = 'telnet'
        return
    endif
return
