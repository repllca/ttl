; ==============================================================================
; Tera Term 4.0x系 完全互換 TTLマクロ (マルチベンダー自動ログ収集・高信頼版)
; ==============================================================================
;
; 【このマクロの概要】
;   1. 踏み台サーバ（Linux等）へSSH接続します（既に接続済みのウィンドウからの実行も自動判別）。
;   2. CSVファイル（device.csv等）から機器一覧（IPアドレス・認証情報等）を1行ずつ読み込みます。
;   3. 踏み台サーバを経由して各対象機器（Cisco, Yamaha, Juniper, Linux, Telnet等）へ接続します。
;   4. 機種に応じたログイン・特権昇格（enable/administrator）・ページャー無効化を自動判別します。
;   5. 機器固有のプロンプト文字列（例: RT-CISCO-01#）を自動取得し、出力途中の '#' や '>' による
;      誤判定（コマンド暴走）を完全に防止します。
;   6. コマンド定義ファイル（commands_*.txt）の内容を順次投入し、個別ログに記録します。
;   7. 相手機器からの離脱時、踏み台復帰マーカー（__BASTION_RETURN__）によって踏み台シェルへの
;      誤った 'exit' 送信（踏み台の巻き添え切断）を100%防止します。
;   8. 実行結果のサマリ（成功/失敗/詳細理由）をCSV（summary_YYYYMMDD_HHMMSS.csv）に出力します。
;
; 【Tera Term 4.02 厳格互換性保証】
;   - 新しいバージョン（4.53+）専用のコマンド（strsplit, break, continue, sprintf2,
;     filenamebox, dirnamebox 等）を一切使用せず、Tera Term 4.02 でも確実に動作します。
;   - すべての wait / waitln コマンドの引数を「最大10個」以内に厳格制限しています。
;   - logopen 直後の result 未更新仕様（4.02固有）に対応しています。
;
; ------------------------------------------------------------------------------
; 【プログラムの目次】
;   1. 基準ディレクトリの設定 (相対パスのズレを完全防止)
;   2. ★【ユーザー設定エリア】 (環境に合わせて初期値を変更できます)
;   3. ★【対話ポップアップ】 (踏み台接続情報・CSVファイル・ログ保存先の選択)
;   4. ログ保存先フォルダ作成 & サマリCSVの準備
;   5. 踏み台サーバへのSSH接続 (未接続時のみ接続・既接続時はそのまま利用)
;   6. CSVファイルの順次読み込みループ
;   7. 踏み台から対象機器への接続コマンド発行 (SSH / Telnet + 復帰マーカー付与)
;   8. 2段階ログイン交渉ループ (バナー誤検知防止・パスワード誤り即検知)
;   9. 特権モード(管理者昇格)の自動適応 (Cisco enable / Yamaha administrator)
;  10. ページ送り抑止コマンド送信 & 機器プロンプト文字列の自動取得
;  11. クリーンログ取得開始 (logopen)
;  12. コマンドファイルの順次実行 (ページャー自動検知・途中切断検知)
;  13. 対象機器からの安全切断 (復帰マーカーによる踏み台セッション完全保護)
;  14. サマリCSVへの結果書き込み
;  15. 全機器終了処理 & 成功/失敗件数サマリ通知
;  サブルーチン1: CSV行パーサー (カンマ区切り解析 & 前後空白除去)
;  サブルーチン2: 文字列前後トリム処理 (空白・タブ・改行・クォート除去)
; ==============================================================================


; ==============================================================================
; 1. 基準ディレクトリの設定 (相対パス解決)
; ==============================================================================
; Tera Term起動時の作業フォルダが「C:\Program Files (x86)\teraterm」等に
; なっている場合でも、このマクロと同じフォルダを基準に動作するよう固定します。
getdir BASE_DIR
setdir BASE_DIR


; ==============================================================================
; 2. ★【ユーザー設定エリア】
;    ご利用の環境に合わせて、以下の初期値を自由に変更してください。
;    （※そのままでも起動時のポップアップ画面で変更・入力が可能です）
; ==============================================================================

; --- 踏み台サーバの接続設定（ポップアップの初期値になります） ---
BASTION_HOST   = '192.168.1.1'      ; 踏み台サーバのIPアドレスまたはホスト名
BASTION_PORT   = '22'               ; 踏み台サーバのSSHポート番号 (通常は 22)
BASTION_USER   = 'bastion_user'     ; 踏み台サーバのログインユーザ名
BASTION_PROMPT = '$'                ; 踏み台サーバのシェルプロンプト記号 ($, #, % 等)

; --- 古い機器向けのSSH追加オプション ---
; 【変更のポイント】古いCiscoやスイッチ等で「no matching key exchange method found」等の
; エラーが出る場合は、下のコメントアウト(;)を外して有効化してください。
SSH_EXTRA_OPTS = '-o ConnectTimeout=10'
; SSH_EXTRA_OPTS = '-o ConnectTimeout=10 -o KexAlgorithms=+diffie-hellman-group1-sha1,diffie-hellman-group14-sha1 -o HostKeyAlgorithms=+ssh-rsa'

; --- デフォルトのファイル・フォルダ名 ---
DEF_CSV_NAME   = 'device.csv'             ; 読み込む機器一覧CSVファイル名
DEF_LOG_NAME   = 'logs'                   ; ログを保存するフォルダ名
DEF_CMD_NAME   = 'commands_universal.txt' ; CSV側でコマンド未指定時の汎用コマンドファイル
DEF_CRED_NAME         = 'credentials.csv' ; 外部パスワード一覧CSVファイル名 (ユーザー名,PW,enPW)
FALLBACK_TO_CRED_FILE = 0                 ; 0: device.csv 固有パスワード失敗時は次機器へ (安全)
                                          ; 1: device.csv 固有パスワード失敗時も外部CSVの候補を追加試行

; --- タイムアウト設定 (単位: 秒) ---
LOGIN_TIMEOUT  = 15                 ; 機器へのログイン応答を待つ最大秒数
CMD_TIMEOUT    = 30                 ; 各コマンドの実行結果を待つ最大秒数

; --- 全機器共通のフォールバック認証候補プール（オプション） ---
; 【変更のポイント】
; CSV側で指定したユーザー名・パスワードがすべて認証失敗した時、またはCSVで空欄の時に、
; 追加で自動試行させたい (ユーザー名, パスワード) 候補があれば設定できます。
; パイプ (|) または セミコロン (;) 区切りで複数指定可能です（空欄 '' の場合は試行しません）。
; 例: GLOBAL_CRED_USERS  = 'admin|cisco|root'
;     GLOBAL_CRED_PASSES = 'admin|cisco|default'
GLOBAL_CRED_USERS  = ''
GLOBAL_CRED_PASSES = ''


; ==============================================================================
; 3. ★【対話ポップアップ】(接続先・ファイル・フォルダの選択と入力)
; ==============================================================================

; 共通パスの初期値を組み立て
sprintf '%s\%s' BASE_DIR DEF_CSV_NAME
DEF_CSV_PATH = inputstr

sprintf '%s\%s' BASE_DIR DEF_LOG_NAME
DEF_LOG_PATH = inputstr

sprintf '%s\%s' BASE_DIR DEF_CMD_NAME
DEFAULT_CMD = inputstr

sprintf '%s\%s' BASE_DIR DEF_CRED_NAME
DEF_CRED_PATH = inputstr
CRED_FILE = ''

; デフォルトの外部パスワードCSV (credentials.csv) が存在するか確認
fileopen f_chk DEF_CRED_PATH 0 1
if f_chk <> -1 then
    fileclose f_chk
    CRED_FILE = DEF_CRED_PATH
endif

; すでにTera Termウィンドウで踏み台サーバに接続済みかどうかを確認
; (result = 2 の場合は、手動で踏み台にログインした状態からマクロが実行されたと判断)
ALREADY_CONNECTED = 0
testlink
if result = 2 then
    ALREADY_CONNECTED = 1
endif

; コマンドライン引数の有無をチェック
; 引数なし(通常実行): ポップアップダイアログを表示して対話的に選択
; 引数あり(自動テスト/CI): ポップアップを省略して自動実行
if paramcnt >= 3 then
    ALREADY_CONNECTED = 0
    LOG_DIR = param2
    BASTION_PASS = param3
    if paramcnt >= 4 then
        CSV_FILE = param4
    else
        CSV_FILE = DEF_CSV_PATH
    endif
    if paramcnt >= 5 then
        CRED_FILE = param5
    endif
else
    ; ----------------------------------------------------
    ; 踏み台に未接続の場合のみ、踏み台の接続先情報をポップアップで確認
    ; ----------------------------------------------------
    if ALREADY_CONNECTED = 0 then
        ; ポップアップ①: 踏み台サーバのIP / ホスト名
        inputbox '踏み台サーバのIPアドレス（またはホスト名）を入力してください:' '① 踏み台サーバ接続先' BASTION_HOST
        BASTION_HOST = inputstr
        strlen BASTION_HOST
        if result = 0 then
            messagebox '踏み台サーバの接続先が入力されなかったため、処理を中断します。' '中断'
            end
        endif

        ; ポップアップ②: 踏み台サーバのログインユーザー名
        inputbox '踏み台サーバのログインユーザー名を入力してください:' '② 踏み台ユーザー名' BASTION_USER
        BASTION_USER = inputstr
        strlen BASTION_USER
        if result = 0 then
            messagebox '踏み台サーバのユーザー名が入力されなかったため、処理を中断します。' '中断'
            end
        endif

        ; ポップアップ③: 踏み台サーバのログインパスワード
        sprintf '踏み台サーバ [%s@%s] のパスワードを入力してください:' BASTION_USER BASTION_HOST
        passwordbox inputstr '③ 踏み台パスワード'
        BASTION_PASS = inputstr
        strlen BASTION_PASS
        if result = 0 then
            messagebox 'パスワードが入力されなかったため、処理を中断します。' '中断'
            end
        endif
    else
        ; すでに踏み台に接続済みの場合は、CSV内でパスワード省略時に使う共通パスワードのみ確認
        passwordbox '現在接続中の踏み台セッションをそのまま使用します。\nCSVでパスワード省略時に使う共通パスワードを入力してください（不要なら空欄のままOK）:' '共通パスワード確認（省略可）'
        BASTION_PASS = inputstr
    endif

    ; ----------------------------------------------------
    ; ポップアップ④: 機器一覧CSVファイルの選択
    ; ----------------------------------------------------
    inputbox '読み込む機器一覧CSVファイル名（またはフルパス）を入力してください:' '機器一覧CSVの選択' DEF_CSV_PATH
    CSV_FILE = inputstr

    strlen CSV_FILE
    if result = 0 then
        CSV_FILE = DEF_CSV_PATH
    endif

    ; 相対パス（\ や / や : を含まない場合）は BASE_DIR を補完
    strscan CSV_FILE '\'
    if result = 0 then
        strscan CSV_FILE '/'
        if result = 0 then
            strscan CSV_FILE ':'
            if result = 0 then
                sprintf '%s\%s' BASE_DIR CSV_FILE
                CSV_FILE = inputstr
            endif
        endif
    endif

    ; CSVファイルが存在するか事前にチェック（存在しない場合はエラー表示して終了）
    fileopen f_chk CSV_FILE 0 1
    if f_chk = -1 then
        sprintf '指定された機器一覧CSVファイルが見つかりません:\n%s\n\nファイル名や配置場所をご確認ください。' CSV_FILE
        messagebox inputstr 'エラー: CSVファイル不存在'
        end
    endif
    fileclose f_chk

    ; ----------------------------------------------------
    ; ポップアップ⑤: ログ保存先フォルダの指定
    ; ----------------------------------------------------
    inputbox 'ログ保存先フォルダのパスを入力してください（存在しない場合は自動作成されます）:' 'ログ保存先フォルダ設定' DEF_LOG_PATH
    LOG_DIR = inputstr

    strlen LOG_DIR
    if result = 0 then
        LOG_DIR = DEF_LOG_PATH
    endif

    ; 相対パスなら BASE_DIR を補完
    strscan LOG_DIR '\'
    if result = 0 then
        strscan LOG_DIR '/'
        if result = 0 then
            strscan LOG_DIR ':'
            if result = 0 then
                sprintf '%s\%s' BASE_DIR LOG_DIR
                LOG_DIR = inputstr
            endif
        endif
    endif

    ; ----------------------------------------------------
    ; ポップアップ⑥: 外部パスワード一覧CSVファイル (省略可)
    ; ----------------------------------------------------
    inputbox '外部パスワードCSVファイル名（ユーザー名,パスワード,管理者PW）を入力してください:\n（使用しない場合は空欄のままOK）' '外部パスワードCSV選択（省略可）' CRED_FILE
    CRED_FILE = inputstr

    strlen CRED_FILE
    if result > 0 then
        ; 相対パスなら BASE_DIR を補完
        strscan CRED_FILE '\'
        if result = 0 then
            strscan CRED_FILE '/'
            if result = 0 then
                strscan CRED_FILE ':'
                if result = 0 then
                    sprintf '%s\%s' BASE_DIR CRED_FILE
                    CRED_FILE = inputstr
                endif
            endif
        endif

        fileopen f_chk CRED_FILE 0 1
        if f_chk <> -1 then
            fileclose f_chk
        else
            sprintf '指定された外部パスワードCSVが見つかりません:\n%s\n\nパスワードCSVを使用せずに処理を続行します。' CRED_FILE
            messagebox inputstr 'パスワードCSV不存在'
            CRED_FILE = ''
        endif
    endif
endif

; パス末尾の余分なスラッシュ/バックスラッシュを除去して正規化
strlen LOG_DIR
DIR_LEN = result
strcopy LOG_DIR DIR_LEN 1 LAST_CHAR
strcompare LAST_CHAR '\'
if result = 0 then
    CUT_LEN = DIR_LEN - 1
    strcopy LOG_DIR 1 CUT_LEN LOG_DIR
endif
strcompare LAST_CHAR '/'
if result = 0 then
    CUT_LEN = DIR_LEN - 1
    strcopy LOG_DIR 1 CUT_LEN LOG_DIR
endif


; ==============================================================================
; 4. ログ保存先フォルダ作成 & サマリCSVの準備
; ==============================================================================
; ログフォルダが存在しない場合は自動作成
sprintf 'cmd.exe /c if not exist "%s" mkdir "%s"' LOG_DIR LOG_DIR
exec inputstr 'hide'
mpause 500

; 実行開始時刻をサフィックスにしたサマリCSVファイルを準備
getdate RUN_ID '%Y%m%d_%H%M%S'
sprintf '%s\summary_%s.csv' LOG_DIR RUN_ID
SUMMARY_FILE = inputstr

; サマリCSVを開いて書き込みテスト（書き込めない場合はマクロ直下に自動退避）
fileopen f_sum SUMMARY_FILE 0
if f_sum = -1 then
    LOG_DIR = BASE_DIR
    sprintf '%s\summary_%s.csv' LOG_DIR RUN_ID
    SUMMARY_FILE = inputstr
    fileopen f_sum SUMMARY_FILE 0
    if f_sum = -1 then
        messagebox 'ログ保存先フォルダへの書き込み権限がありません。実行権限を確認してください。' 'エラー'
        end
    endif
endif
; サマリCSVのヘッダ行を出力
filewriteln f_sum 'Timestamp,Hostname,IP,Protocol,Prompt,Status,Detail,Auth_User'
fileclose f_sum

; ログイン成功アカウント一覧CSVの準備 (どの機器にどのアカウントで入れたかを保存)
sprintf '%s\resolved_accounts_%s.csv' LOG_DIR RUN_ID
RESOLVED_FILE = inputstr
fileopen f_res RESOLVED_FILE 0
if f_res <> -1 then
    filewriteln f_res 'Hostname,IP,User,Protocol,Status'
    fileclose f_res
endif


; ==============================================================================
; 5. 踏み台サーバへのSSH接続
; ==============================================================================
if ALREADY_CONNECTED = 0 then
    ; BASTION_HOST にポート番号(:22等)が含まれているか確認
    strscan BASTION_HOST ':'
    if result = 0 then
        sprintf '%s:%s /ssh /2 /auth=password /user=%s /passwd=%s' BASTION_HOST BASTION_PORT BASTION_USER BASTION_PASS
    else
        sprintf '%s /ssh /2 /auth=password /user=%s /passwd=%s' BASTION_HOST BASTION_USER BASTION_PASS
    endif
    connect inputstr

    ; connect コマンドの戻り値判定 (2 = 接続成功)
    if result <> 2 then
        sprintf '踏み台サーバ (%s) へのSSH接続に失敗しました。\n\n【確認項目】:\n1. 踏み台サーバのIPアドレス(%s)とポート番号(%s)が正しいか\n2. ユーザー名(%s)とパスワードが正しいか\n3. PCから踏み台サーバへネットワークが繋がっているか' BASTION_HOST BASTION_HOST BASTION_PORT BASTION_USER
        messagebox inputstr '踏み台SSH接続エラー'
        end
    endif

    ; 踏み台サーバのログインプロンプト待機
    timeout = 30
    wait BASTION_PROMPT '$' '#' '>' '%' ']'
    if result = 0 then
        sprintf '踏み台サーバへの接続後、プロンプト待機がタイムアウトしました。\n\n【確認項目】:\n1. パスワードが間違っていないか（画面上で再入力待ちになっていないか）\n2. 踏み台サーバのログインバナー等でEnter待ちになっていないか'
        messagebox inputstr 'プロンプト待機タイムアウト'
        disconnect 0
        end
    endif

    ; 踏み台サーバの実際のプロンプト記号を自動認識して更新
    if result = 2 then
        BASTION_PROMPT = '$'
    elseif result = 3 then
        BASTION_PROMPT = '#'
    elseif result = 4 then
        BASTION_PROMPT = '>'
    elseif result = 5 then
        BASTION_PROMPT = '%'
    elseif result = 6 then
        BASTION_PROMPT = ']'
    endif
else
    ; すでに接続済みの場合はEnterを1回送って現在のプロンプトを確認
    flushrecv
    sendln ''
    timeout = 10
    wait BASTION_PROMPT '$' '#' '>' '%' ']'
    if result = 2 then
        BASTION_PROMPT = '$'
    elseif result = 3 then
        BASTION_PROMPT = '#'
    elseif result = 4 then
        BASTION_PROMPT = '>'
    elseif result = 5 then
        BASTION_PROMPT = '%'
    elseif result = 6 then
        BASTION_PROMPT = ']'
    endif
endif

; 初期状態の機器情報・集計カウンタをセット
DEV_NAME = '(1台目の接続前)'
DEV_IP = '未接続'
DEV_PROTO = '-'
DEV_STATUS = '未実行'
DEV_DETAIL = '-'
TOTAL_COUNT = 0
OK_COUNT = 0
NG_COUNT = 0


; ==============================================================================
; 6. CSVファイルの順次読み込みループ
; ==============================================================================
fileopen f_csv CSV_FILE 0 1
if f_csv = -1 then
    messagebox 'CSVファイルを開くことができませんでした。' 'エラー'
    if ALREADY_CONNECTED = 0 then
        sendln 'exit'
        disconnect 0
    endif
    end
endif

:read_csv_loop
; 踏み台との通信セッションが正常に継続しているかチェック (2 = 正常接続中)
testlink
if result <> 2 goto bastion_disconnected

; 機器一覧CSVから1行読み込み
filereadln f_csv line
if result = 1 goto end_csv_loop     ; ファイル終端(EOF)に達したら終了

; 行の前後の空白・改行をトリム
TRIM_VAL = line
call trim_string
line = TRIM_VAL

strlen line
if result = 0 goto read_csv_loop    ; 空行はスキップ

; コメント行(# または ; で始まる行)はスキップ
strcopy line 1 1 first_char
strcompare first_char '#'
if result = 0 goto read_csv_loop
strcompare first_char ';'
if result = 0 goto read_csv_loop

; CSV行パーサーサブルーチンを呼び出して各列に分解（各列の前後空白も自動除去）
call parse_csv_line

; CSVのタイトル行(ホスト名, IP等のヘッダ)はスキップ
strcompare DEV_NAME 'ホスト名'
if result = 0 goto read_csv_loop
strcompare DEV_NAME 'hostname'
if result = 0 goto read_csv_loop
strcompare DEV_NAME 'Hostname'
if result = 0 goto read_csv_loop

; IPアドレスが未入力の行はスキップ
strlen DEV_IP
if result = 0 goto read_csv_loop

; 処理対象台数をカウントアップ
TOTAL_COUNT = TOTAL_COUNT + 1

; --- CSV内の空欄（欠損値）に対する自動フォールバック補完 ---
; 1) ホスト名未指定時: IPアドレスで代替
strlen DEV_NAME
if result = 0 then
    DEV_NAME = DEV_IP
endif

; 2) プロトコル未記載時: デフォルトは ssh
strlen DEV_PROTO
if result = 0 then
    DEV_PROTO = 'ssh'
endif

; 3) コマンドファイル未指定時: 汎用コマンドファイル(commands_universal.txt)を使用
strlen DEV_CMD
if result = 0 then
    DEV_CMD = DEFAULT_CMD
endif

; コマンドファイルの相対パス解決
strscan DEV_CMD '\'
if result = 0 then
    strscan DEV_CMD '/'
    if result = 0 then
        strscan DEV_CMD ':'
        if result = 0 then
            sprintf '%s\%s' BASE_DIR DEV_CMD
            DEV_CMD = inputstr
        endif
    endif
endif

; 機器処理用の管理変数を初期化
DEV_STATUS = 'NG'
DEV_DETAIL = 'Unknown'
FINAL_PROMPT = '?'
PROMPT_SYMBOL = '?'
IS_LOG_OPEN = 0
IS_DEVICE_LOGGED_IN = 0
AUTH_ATTEMPT = 0
F_CRED_OPEN = 0
F_CRED_TRIED = 0
ACTIVE_USER = ''
ACTIVE_PASS = ''
ACTIVE_ENPASS = ''

; ------------------------------------------------------
; ★【認証情報の優先順位判定】
;   1. device.csv に固有の認証情報（ユーザー名/パスワード）があれば最優先で試行
;   2. device.csv が空欄、または1が失敗した場合は外部パスワードCSV (credentials.csv) を順次試行
;   3. それでもログインできない場合は踏み台の認証情報でフォールバック試行
; ------------------------------------------------------
HAS_DEV_CRED = 0
strlen DEV_USER
if result > 0 then
    HAS_DEV_CRED = 1
endif
strlen DEV_PASS
if result > 0 then
    HAS_DEV_CRED = 1
endif

; インラインパイプ指定用のキュー初期化
REMAIN_USERS = DEV_USER
REMAIN_PASS  = DEV_PASS
LAST_USER    = ''
LAST_PASS    = ''

; グローバル候補プールが指定されていればキュー末尾に連結
strlen GLOBAL_CRED_USERS
if result > 0 then
    strlen REMAIN_USERS
    if result > 0 then
        strconcat REMAIN_USERS '|'
        strconcat REMAIN_USERS GLOBAL_CRED_USERS
    else
        REMAIN_USERS = GLOBAL_CRED_USERS
    endif
endif
strlen GLOBAL_CRED_PASSES
if result > 0 then
    strlen REMAIN_PASS
    if result > 0 then
        strconcat REMAIN_PASS '|'
        strconcat REMAIN_PASS GLOBAL_CRED_PASSES
    else
        REMAIN_PASS = GLOBAL_CRED_PASSES
    endif
endif

; device.csv に固有指定（またはパイプ指定）があればまずそれを試行
if HAS_DEV_CRED = 1 then
    goto try_inline_credential
endif

; device.csv が空欄で外部パスワードCSVが有効なら、直接外部CSVから試行開始
strlen CRED_FILE
if result > 0 then
    goto open_cred_csv_file
endif

; 外部CSVもなければ踏み台認証情報フォールバック
ACTIVE_USER = BASTION_USER
ACTIVE_PASS = BASTION_PASS
ACTIVE_ENPASS = BASTION_PASS
AUTH_ATTEMPT = 1
goto issue_connect_cmd


; ==============================================================================
; 7. 対象機器への接続試行ループ
; ==============================================================================

; --- A) device.csv 側の指定（単一指定またはパイプ複数指定）から候補を取り出し ---
:try_inline_credential
call pop_next_credential
if HAS_CRED = 0 then
    ; インライン候補が尽きた場合、外部パスワードCSVがあれば外部ファイルへ移行
    strlen CRED_FILE
    if result > 0 and F_CRED_TRIED = 0 then
        goto open_cred_csv_file
    endif
    DEV_STATUS = 'NG'
    if AUTH_ATTEMPT > 1 then
        sprintf 'All %d Auth Attempts Failed' AUTH_ATTEMPT
        DEV_DETAIL = inputstr
    endif
    goto record_result
endif

AUTH_ATTEMPT = AUTH_ATTEMPT + 1
ACTIVE_USER = CURR_USER
ACTIVE_PASS = CURR_PASS
ACTIVE_ENPASS = DEV_ENPASS
strlen ACTIVE_ENPASS
if result = 0 then
    ACTIVE_ENPASS = ACTIVE_PASS
endif
goto issue_connect_cmd


; --- B) 外部パスワードCSVファイル (credentials.csv) から候補を取り出し ---
:open_cred_csv_file
F_CRED_TRIED = 1
fileopen f_cred CRED_FILE 0 1
if f_cred = -1 then
    if AUTH_ATTEMPT > 0 then
        DEV_STATUS = 'NG'
        goto record_result
    endif
    ACTIVE_USER = BASTION_USER
    ACTIVE_PASS = BASTION_PASS
    ACTIVE_ENPASS = BASTION_PASS
    AUTH_ATTEMPT = 1
    goto issue_connect_cmd
endif
F_CRED_OPEN = 1

:read_cred_csv_loop
filereadln f_cred cred_line
if result = 1 then
    ; 外部パスワードCSVの末尾(EOF)到達（全候補失敗）
    fileclose f_cred
    F_CRED_OPEN = 0
    DEV_STATUS = 'NG'
    if AUTH_ATTEMPT > 1 then
        sprintf 'All %d Auth Attempts Failed (Password CSV exhausted)' AUTH_ATTEMPT
        DEV_DETAIL = inputstr
    else
        DEV_DETAIL = 'Auth Failed'
    endif
    goto record_result
endif

; 行トリム
TRIM_VAL = cred_line
call trim_string
cred_line = TRIM_VAL

strlen cred_line
if result = 0 goto read_cred_csv_loop

; コメント行スキップ (# または ;)
strcopy cred_line 1 1 fc_cred
strcompare fc_cred '#'
if result = 0 goto read_cred_csv_loop
strcompare fc_cred ';'
if result = 0 goto read_cred_csv_loop

; パスワードCSV行のパース (ユーザー名, パスワード, 管理者PW)
PARSE_CRED_STR = cred_line
call parse_cred_line

; ヘッダ行スキップ
strcompare C_USER 'ユーザー名'
if result = 0 goto read_cred_csv_loop
strcompare C_USER 'username'
if result = 0 goto read_cred_csv_loop
strcompare C_USER 'Username'
if result = 0 goto read_cred_csv_loop

; 空行スキップ
strlen C_USER
CU_LEN = result
strlen C_PASS
CP_LEN = result
if CU_LEN = 0 and CP_LEN = 0 goto read_cred_csv_loop

if CU_LEN = 0 then
    C_USER = BASTION_USER
endif
if CP_LEN = 0 then
    C_PASS = BASTION_PASS
endif
strlen C_ENPASS
if result = 0 then
    C_ENPASS = C_PASS
endif

; もし直前の device.csv 固有認証と全く同一なら二重試行をスキップ
if HAS_DEV_CRED = 1 and AUTH_ATTEMPT = 1 then
    strcompare C_USER DEV_USER
    if result = 0 then
        strcompare C_PASS DEV_PASS
        if result = 0 goto read_cred_csv_loop
    endif
endif

AUTH_ATTEMPT = AUTH_ATTEMPT + 1
ACTIVE_USER = C_USER
ACTIVE_PASS = C_PASS
ACTIVE_ENPASS = C_ENPASS
goto issue_connect_cmd


; --- C) 接続コマンド発行 (SSH / Telnet + 踏み台復帰マーカー) ---
:issue_connect_cmd
flushrecv

strcompare DEV_PROTO 'telnet'
if result = 0 goto do_telnet
strcompare DEV_PROTO 'TELNET'
if result = 0 goto do_telnet

; --- SSH接続コマンド発行 ---
sprintf 'ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null %s ' SSH_EXTRA_OPTS
SEND_CMD = inputstr
strlen ACTIVE_USER
if result > 0 then
    strconcat SEND_CMD ACTIVE_USER
    strconcat SEND_CMD '@'
endif
strconcat SEND_CMD DEV_IP
strconcat SEND_CMD ' ; echo "__BAS""TION_RETURN__"'
testlink
if result <> 2 goto bastion_disconnected
sendln SEND_CMD
goto login_negotiate_loop

; --- Telnet接続コマンド発行 ---
:do_telnet
SEND_CMD = 'telnet '
strconcat SEND_CMD DEV_IP
strconcat SEND_CMD ' ; echo "__BAS""TION_RETURN__"'
testlink
if result <> 2 goto bastion_disconnected
sendln SEND_CMD


; ==============================================================================
; 8. 2段階ログイン交渉ループ (バナー誤検知防止・パスワード誤り即検知)
; ==============================================================================
:login_negotiate_loop
LOGIN_SUCCESS = 0
INIT_PROMPT_IDX = 0

; ------------------------------------------------------
; 【第1段階】パスワード送信前の待機
;   ログイン前バナーに含まれる '#' や '>' や ']' をプロンプトと誤認しないよう、
;   ここでは認証要求（yes/no, login:, Password:）または接続失敗マーカーのみを待ちます。
; ------------------------------------------------------
:login_stage1_loop
timeout = LOGIN_TIMEOUT
; wait引数(9個):
; 1:yes/no, 2:ogin:, 3:ser:, 4:assword:, 5:__BASTION_RETURN__,
; 6:no matching, 7:Unable to negotiate, 8:refused, 9:unreachable
wait 'yes/no' 'ogin:' 'ser:' 'assword:' '__BASTION_RETURN__' 'no matching' 'Unable to negotiate' 'refused' 'unreachable'

if result = 1 then
    ; 初回SSH接続時のフィンガープリント確認 (yes/no)
    testlink
    if result <> 2 goto bastion_disconnected
    sendln 'yes'
    goto login_stage1_loop
endif

if result = 2 or result = 3 then
    ; ユーザー名入力要求 (login: / Username:)
    testlink
    if result <> 2 goto bastion_disconnected
    sendln ACTIVE_USER
    goto login_stage1_loop
endif

if result = 4 then
    ; パスワード入力要求 (Password:) -> パスワードを送信して【第2段階】へ進む
    testlink
    if result <> 2 goto bastion_disconnected
    sendln ACTIVE_PASS
    goto login_stage2_wait
endif

if result = 5 then
    ; SSH/Telnetが即座に終了して踏み台に戻った（接続拒否・ホスト不在等）
    ; ※機器IP自体に接続できない場合は、無駄なPW候補リトライをせず即座にNG記録して次へ進む
    DEV_STATUS = 'NG'
    DEV_DETAIL = 'Connection Failed / Closed by Host'
    goto record_result
endif

if result = 6 or result = 7 then
    ; 古い機器でSSH鍵交換アルゴリズム等が不一致の場合
    timeout = 5
    wait '__BASTION_RETURN__'
    DEV_DETAIL = 'SSH Algorithm Mismatch (Check SSH_EXTRA_OPTS)'
    goto record_result
endif

if result = 8 or result = 9 then
    ; Connection refused / Network is unreachable
    timeout = 5
    wait '__BASTION_RETURN__'
    DEV_DETAIL = 'Connection Refused / Unreachable'
    goto record_result
endif

if result = 0 then
    ; タイムアウト時: 公開鍵認証等でパスワードなしログイン済みか、バナーでEnter待ちの可能性
    testlink
    if result <> 2 goto bastion_disconnected
    sendln ''
    timeout = 5
    ; 1:__BASTION_RETURN__, 2:assword:, 3:invalid, 4:ogin:, 5:ser:, 6:>, 7:#, 8:$, 9:]
    wait '__BASTION_RETURN__' 'assword:' 'invalid' 'ogin:' 'ser:' '>' '#' '$' ']'
    if result = 1 then
        DEV_DETAIL = 'Connection Timed Out / Closed'
        goto check_next_credential
    endif
    if result = 2 or result = 3 then
        testlink
        if result <> 2 goto bastion_disconnected
        sendln ACTIVE_PASS
        goto login_stage2_wait
    endif
    if result = 4 or result = 5 then
        testlink
        if result <> 2 goto bastion_disconnected
        sendln ACTIVE_USER
        goto login_stage1_loop
    endif
    if result >= 6 and result <= 9 then
        LOGIN_SUCCESS = 1
        if result = 6 then
            INIT_PROMPT_IDX = 1
        elseif result = 7 then
            INIT_PROMPT_IDX = 2
        elseif result = 8 then
            INIT_PROMPT_IDX = 3
        else
            INIT_PROMPT_IDX = 5
        endif
        IS_DEVICE_LOGGED_IN = 1
        goto login_success_exit
    endif

    ; 応答がないため Ctrl+C (#3) で接続試行を中断し、踏み台へ安全に復帰
    send #3
    mpause 300
    testlink
    if result <> 2 goto bastion_disconnected
    sendln 'echo "__BAS""TION_RETURN__"'
    timeout = 5
    wait '__BASTION_RETURN__'
    DEV_DETAIL = 'Login Timeout'
    goto check_next_credential
endif

; ------------------------------------------------------
; 【第2段階】パスワード送信後のプロンプト待機
;   パスワード送信後にもう一度 Password: や Login invalid や denied が返ってきた場合は、
;   「パスワード誤り」と判定し、別候補があれば次の候補を試行します。
;   ★重要設計:
;     Ciscoのエラーメッセージ（例: '% Login invalid'）の先頭にある '%' を
;     プロンプトと誤認しないよう、認証失敗キーワード (assword:, invalid, denied等) を
;     プロンプト記号よりも先に優先判定します。
; ------------------------------------------------------
:login_stage2_wait
timeout = LOGIN_TIMEOUT
; wait引数(10個):
; 1:__BASTION_RETURN__, 2:assword:, 3:invalid, 4:denied, 5:ogin:, 6:ser:, 7:>, 8:#, 9:$, 10:]
wait '__BASTION_RETURN__' 'assword:' 'invalid' 'denied' 'ogin:' 'ser:' '>' '#' '$' ']'

if result = 1 then
    ; パスワード送信直後に切断されて踏み台へ戻った
    DEV_DETAIL = 'Auth Rejected / Closed by Host'
    goto check_next_credential
endif

if result >= 2 and result <= 6 then
    ; 認証失敗 (Password再要求、Invalid、Denied、Login要求等) -> パスワード誤りとして次候補へ
    send #3
    mpause 300
    testlink
    if result <> 2 goto bastion_disconnected
    sendln 'echo "__BAS""TION_RETURN__"'
    timeout = 5
    wait '__BASTION_RETURN__'
    DEV_DETAIL = 'Auth Failed (Wrong Password)'
    goto check_next_credential
endif

if result >= 7 and result <= 10 then
    ; ログイン成功！対象機器のプロンプトに到達
    LOGIN_SUCCESS = 1
    if result = 7 then
        ; 一般モード (>)
        INIT_PROMPT_IDX = 1
    elseif result = 8 then
        ; 特権モード (#)
        INIT_PROMPT_IDX = 2
    elseif result = 9 then
        ; シェルモード ($)
        INIT_PROMPT_IDX = 3
    else
        ; 特権ブラケット (])
        INIT_PROMPT_IDX = 5
    endif
    IS_DEVICE_LOGGED_IN = 1
    goto login_success_exit
endif

if result = 0 then
    ; パスワード送信後にタイムアウトした場合、Enterを1回送って再確認
    testlink
    if result <> 2 goto bastion_disconnected
    sendln ''
    timeout = 5
    ; 1:__BASTION_RETURN__, 2:assword:, 3:invalid, 4:denied, 5:>, 6:#, 7:$, 8:]
    wait '__BASTION_RETURN__' 'assword:' 'invalid' 'denied' '>' '#' '$' ']'
    if result = 1 then
        DEV_DETAIL = 'Auth Rejected / Closed by Host'
        goto check_next_credential
    endif
    if result >= 2 and result <= 4 then
        send #3
        mpause 300
        testlink
        if result <> 2 goto bastion_disconnected
        sendln 'echo "__BAS""TION_RETURN__"'
        timeout = 5
        wait '__BASTION_RETURN__'
        DEV_DETAIL = 'Auth Failed (Wrong Password)'
        goto check_next_credential
    endif
    if result >= 5 and result <= 8 then
        LOGIN_SUCCESS = 1
        if result = 5 then
            INIT_PROMPT_IDX = 1
        elseif result = 6 then
            INIT_PROMPT_IDX = 2
        elseif result = 7 then
            INIT_PROMPT_IDX = 3
        else
            INIT_PROMPT_IDX = 5
        endif
        IS_DEVICE_LOGGED_IN = 1
        goto login_success_exit
    endif

    send #3
    mpause 300
    testlink
    if result <> 2 goto bastion_disconnected
    sendln 'echo "__BAS""TION_RETURN__"'
    timeout = 5
    wait '__BASTION_RETURN__'
    DEV_DETAIL = 'Post-Auth Timeout'
    goto check_next_credential
endif

; ------------------------------------------------------
; ★【認証失敗時の次候補判定】
; ------------------------------------------------------
:check_next_credential
; 1) 外部パスワードCSVファイルがすでに開いている場合は、次の行を読む
if F_CRED_OPEN = 1 then
    mpause 300
    flushrecv
    goto read_cred_csv_loop
endif

; 2) インライン指定キューに残候補があれば次を取り出す
strlen REMAIN_USERS
REM_U_LEN = result
strlen REMAIN_PASS
REM_P_LEN = result
if REM_U_LEN > 0 or REM_P_LEN > 0 then
    mpause 300
    flushrecv
    goto try_inline_credential
endif

; 3) インライン指定が尽き、外部パスワードCSVがあり、かつフォールバック許可時なら外部ファイルを開く
strlen CRED_FILE
if result > 0 and F_CRED_TRIED = 0 then
    if HAS_DEV_CRED = 0 or FALLBACK_TO_CRED_FILE = 1 then
        mpause 300
        flushrecv
        goto open_cred_csv_file
    endif
endif

; すべての認証候補が尽きた場合はNGとして結果記録へ
DEV_STATUS = 'NG'
if AUTH_ATTEMPT > 1 then
    sprintf 'All %d Auth Attempts Failed' AUTH_ATTEMPT
    DEV_DETAIL = inputstr
endif
goto record_result

:login_success_exit
if LOGIN_SUCCESS = 0 then
    DEV_DETAIL = 'Login Failed'
    goto cleanup_device
endif

; 外部パスワードファイルが開いていれば即座にクローズ
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif

; 認証に成功したユーザー名・パスワードを変数に確定
DEV_USER = ACTIVE_USER
DEV_PASS = ACTIVE_PASS

; 管理者(enable)パスワードの設定
; 外部パスワードCSV側で ACTIVE_ENPASS が指定されていればそれを優先
strlen ACTIVE_ENPASS
if result > 0 then
    DEV_ENPASS = ACTIVE_ENPASS
else
    ; 未記載時は、認証成功した通常パスワードを流用
    strlen DEV_ENPASS
    if result = 0 then
        DEV_ENPASS = ACTIVE_PASS
    endif
endif


; ==============================================================================
; 9. 特権モード(管理者昇格)の自動適応
; ==============================================================================
; 初期プロンプトが既に特権(#, ], $, %)の場合は昇格処理をスキップ
if INIT_PROMPT_IDX >= 2 and INIT_PROMPT_IDX <= 5 goto disable_paging

; 踏み台との通信セッションが正常に継続しているかチェック
testlink
if result <> 2 goto bastion_disconnected

; 初期プロンプトが一般モード (>) の場合のみ特権昇格を試行
sendln 'enable'
timeout = 5
; 引数1:__BASTION_RETURN__, 2:assword:, 3:#, 4:], 5:Invalid, 6:Unknown, 7:not found, 8:Error, 9:syntax, 10:>
wait '__BASTION_RETURN__' 'assword:' '#' ']' 'Invalid' 'Unknown' 'not found' 'Error' 'syntax' '>'

if result = 1 then
    ; 昇格試行中に相手機器から切断されて踏み台に戻った場合
    IS_DEVICE_LOGGED_IN = 0
    DEV_STATUS = 'NG'
    DEV_DETAIL = 'Disconnected During Enable'
    goto cleanup_done
elseif result = 2 then
    ; Cisco等: 管理者パスワード入力要求
    testlink
    if result <> 2 goto bastion_disconnected
    sendln DEV_ENPASS
    timeout = 5
    ; 1:__BASTION_RETURN__, 2:#, 3:], 4:>, 5:assword:, 6:denied, 7:Bad
    wait '__BASTION_RETURN__' '#' ']' '>' 'assword:' 'denied' 'Bad'
    if result = 1 then
        IS_DEVICE_LOGGED_IN = 0
        DEV_STATUS = 'NG'
        DEV_DETAIL = 'Disconnected During Enable Password'
        goto cleanup_done
    elseif result >= 5 and result <= 7 then
        ; 管理者パスワード誤り
        DEV_DETAIL = 'Enable Password Failed'
    endif
elseif result >= 5 and result <= 9 then
    ; enable コマンドが拒否された場合 (Yamahaルータ等の可能性があるため administrator を試行)
    testlink
    if result <> 2 goto bastion_disconnected
    sendln 'administrator'
    timeout = 5
    ; 1:__BASTION_RETURN__, 2:assword:, 3:#, 4:>, 5:$
    wait '__BASTION_RETURN__' 'assword:' '#' '>' '$'
    if result = 1 then
        IS_DEVICE_LOGGED_IN = 0
        DEV_STATUS = 'NG'
        DEV_DETAIL = 'Disconnected During Administrator Cmd'
        goto cleanup_done
    elseif result = 2 then
        testlink
        if result <> 2 goto bastion_disconnected
        sendln DEV_ENPASS
        timeout = 5
        wait '__BASTION_RETURN__' '#' '>' '$'
        if result = 1 then
            IS_DEVICE_LOGGED_IN = 0
            DEV_STATUS = 'NG'
            DEV_DETAIL = 'Disconnected During Administrator Password'
            goto cleanup_done
        endif
    endif
endif


; ==============================================================================
; 10. ページ送り抑止コマンド送信 & 機器プロンプト文字列の自動取得
; ==============================================================================
; 【変更のポイント】新しい機種に対応させたい場合は、ここにページング無効化コマンドを追加できます。
:disable_paging
testlink
if result <> 2 goto bastion_disconnected
timeout = 2

; Cisco / Allied Telesis / Alaxala / Fortinet 用
sendln 'terminal length 0'
wait '#' '>' '$' '%' ']'

; Juniper JunOS 用
sendln 'set cli screen-length 0'
wait '#' '>' '$' '%' ']'

; Huawei VRP 用
sendln 'screen-length 0 temporary'
wait '#' '>' '$' '%' ']'

; Yamaha RTX 用
sendln 'console lines infinity'
wait '#' '>' '$' '%' ']'

; Cisco WLC 用
sendln 'config paging disable'
wait '#' '>' '$' '%' ']'

; ------------------------------------------------------
; 【プロンプト文字列の精密取得】
;   単なる1文字（'#' や '>'）だけを待つと、コマンド出力内の '#101-Ubuntu' や
;   '<LOOPBACK>' に反応してコマンドが暴走してしまいます。
;   そのため、空改行を送って機器固有のプロンプト行全体（例: 'RT-CISCO-01#'）を取得します。
; ------------------------------------------------------
mpause 200
flushrecv
testlink
if result <> 2 goto bastion_disconnected
sendln ''
mpause 200
testlink
if result <> 2 goto bastion_disconnected
sendln ''
timeout = 5
waitln '#' '>' '$' '%' ']'
if result = 1 then
    PROMPT_SYMBOL = '#'
elseif result = 2 then
    PROMPT_SYMBOL = '>'
elseif result = 3 then
    PROMPT_SYMBOL = '$'
elseif result = 4 then
    PROMPT_SYMBOL = '%'
elseif result = 5 then
    PROMPT_SYMBOL = ']'
else
    PROMPT_SYMBOL = '#'
endif

if result >= 1 and result <= 5 then
    TRIM_VAL = inputstr
    call trim_string
    FINAL_PROMPT = TRIM_VAL
else
    FINAL_PROMPT = PROMPT_SYMBOL
endif

strlen FINAL_PROMPT
if result = 0 then
    FINAL_PROMPT = PROMPT_SYMBOL
endif

; ログ開始前にバッファ内の残存プロンプトをクリア
mpause 200
flushrecv


; ==============================================================================
; 11. クリーンログ取得開始 (logopen)
; ==============================================================================
; ログイン・昇格・ページャー無効化の完了直後にログを開くことで、
; 認証パスワード等の機微情報が含まれない「コマンド実行結果のみ」の綺麗なログを作成します。
getdate DATE_STR '%Y%m%d_%H%M%S'
; ログファイル名形式: ホスト名_YYYYMMDD_HHMMSS.log
sprintf '%s\%s_%s.log' LOG_DIR DEV_NAME DATE_STR
LOG_FILE = inputstr

; 既存ログがあれば閉じてから新規オープン
; （※Tera Term 4.02 では logopen 直後の result が更新されないため、無条件で成功フラグを立てます）
logclose
logopen LOG_FILE 0 0
IS_LOG_OPEN = 1

; ログの先頭にログイン成功アカウントと機器情報を記録
logwrite #13#10
logwrite '=================================================='#13#10
sprintf '# Host: %s (%s) / Protocol: %s / Logged-in User: %s' DEV_NAME DEV_IP DEV_PROTO DEV_USER
logwrite inputstr
logwrite #13#10
logwrite '=================================================='#13#10


; ==============================================================================
; 12. コマンドファイルの順次実行 (ページャー自動検知・スペース送信)
; ==============================================================================
fileopen f_cmd DEV_CMD 0 1
if f_cmd = -1 then
    DEV_DETAIL = 'Command File Not Found'
    goto cleanup_device
endif

:read_cmd_loop
filereadln f_cmd cmd_line
if result = 1 goto end_cmd_loop     ; コマンド定義ファイルの末尾(EOF)到達

; コマンド行の前後空白をトリム
TRIM_VAL = cmd_line
call trim_string
cmd_line = TRIM_VAL

strlen cmd_line
if result = 0 goto read_cmd_loop    ; 空行スキップ

; コメント行 (セミコロン ; または シャープ #) はスキップ
strcopy cmd_line 1 1 c_char
strcompare c_char ';'
if result = 0 goto read_cmd_loop
strcompare c_char '#'
if result = 0 goto read_cmd_loop

; ログ内に実行コマンドの見出しをわかりやすく記録
logwrite #13#10
logwrite '==================== [ '
logwrite cmd_line
logwrite ' ] ===================='
logwrite #13#10

; コマンドを機器に送信
testlink
if result <> 2 goto bastion_disconnected
sendln cmd_line

; コマンド実行結果の待機ループ (ページング表示 --More-- の自動解除 & 途中切断検知)
:wait_cmd_prompt
timeout = CMD_TIMEOUT
; wait 最大10引数厳守 (9個):
; 1:FINAL_PROMPT, 2:--More--, 3:-- More --, 4:---(more, 5:More:, 6:続く, 7:RETURN, 8:any key, 9:__BASTION_RETURN__
wait FINAL_PROMPT '--More--' '-- More --' '---(more' 'More:' '続く' 'RETURN' 'any key' '__BASTION_RETURN__'

if result = 1 goto read_cmd_loop    ; 機器プロンプトに戻ったので次のコマンドへ

if result >= 2 and result <= 6 then
    ; ページャー表示(--More--等)が出現したため、スペースキーを送信して続きを表示
    send ' '
    goto wait_cmd_prompt
endif

if result >= 7 and result <= 8 then
    ; RETURN / any key 表示が出現したため、Enterキーを送信
    sendln ''
    goto wait_cmd_prompt
endif

if result = 9 then
    ; コマンド実行中に相手機器から切断されて踏み台に戻った場合
    fileclose f_cmd
    IS_DEVICE_LOGGED_IN = 0
    DEV_DETAIL = 'Disconnected During Command'
    goto cleanup_done
endif

; タイムアウト時は次のコマンドへ進む
goto read_cmd_loop

:end_cmd_loop
fileclose f_cmd
DEV_STATUS = 'OK'
if AUTH_ATTEMPT > 1 then
    sprintf 'Success (Candidate #%d matched)' AUTH_ATTEMPT
    DEV_DETAIL = inputstr
else
    DEV_DETAIL = 'Success'
endif


; ==============================================================================
; 13. 対象機器からの安全切断 (踏み台セッション完全保護)
; ==============================================================================
; 【重要設計】
;   以前は '>' や ']' を wait していたため、コマンド出力の残り文字に反応して
;   2回目の exit が踏み台シェルに誤送信され、踏み台ごと切断される原因になっていました。
;   本バージョンでは踏み台復帰マーカー '__BASTION_RETURN__' のみを判定基準とするため、
;   踏み台シェルに対して誤って exit を送ることは絶対にありません。
; ==============================================================================
:cleanup_device
; コマンド収集完了後、ログアウト操作がログに混入しないよう先にログをクローズ
if IS_LOG_OPEN = 1 then
    logclose
    IS_LOG_OPEN = 0
endif

if IS_DEVICE_LOGGED_IN = 1 then
    ; 踏み台との通信セッションが正常に継続しているかチェック
    testlink
    if result <> 2 goto bastion_disconnected

    ; コマンド出力の残骸を完全にフラッシュ
    mpause 300
    flushrecv

    ; 1) 対象機器へのログアウトコマンド (exit) を送信
    sendln 'exit'
    timeout = 7
    ; 引数(5個): 1:__BASTION_RETURN__, 2:Save new configuration ? (y/n), 3:Save? [yes/no], 4:(y/n), 5:[y/n]
    wait '__BASTION_RETURN__' 'Save new configuration ? (y/n)' 'Save? [yes/no]' '(y/n)' '[y/n]'
    if result = 1 goto cleanup_done
    if result >= 2 and result <= 5 then
        testlink
        if result <> 2 goto bastion_disconnected
        sendln 'n'
        timeout = 7
        wait '__BASTION_RETURN__'
        if result = 1 goto cleanup_done
    endif

    ; 2) exit で戻らなかった場合（Yamaha / Juniper / Huawei 等）、quit コマンドを試行
    ; ※踏み台シェルを巻き添え切断しないよう、2回目の exit は絶対に送信しません
    testlink
    if result <> 2 goto bastion_disconnected
    sendln 'quit'
    timeout = 5
    wait '__BASTION_RETURN__'
    if result = 1 goto cleanup_done

    ; 3) それでも戻らない場合、Ctrl+C (#3) で安全に中断しマーカーで同期
    send #3
    mpause 300
    testlink
    if result <> 2 goto bastion_disconnected
    sendln 'echo "__BAS""TION_RETURN__"'
    timeout = 5
    wait '__BASTION_RETURN__'
endif

:cleanup_done
IS_DEVICE_LOGGED_IN = 0
; 外部パスワードファイルが開いていればクローズ
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif

; 次の機器の処理に影響しないよう、踏み台プロンプトの残存バッファをクリア
mpause 200
flushrecv

; 異常系ジャンプ等で万一ログが開いたままならクローズ
if IS_LOG_OPEN = 1 then
    logclose
    IS_LOG_OPEN = 0
endif


; ==============================================================================
; 14. サマリCSVへの追記
; ==============================================================================
:record_result
; 外部パスワードファイルが開いていればクローズ
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif

strcompare DEV_STATUS 'OK'
if result = 0 then
    OK_COUNT = OK_COUNT + 1
    ; ログイン成功時は解決済みアカウント一覧CSVに追記
    fileopen f_res RESOLVED_FILE 1
    if f_res <> -1 then
        sprintf '%s,%s,%s,%s,%s' DEV_NAME DEV_IP DEV_USER DEV_PROTO DEV_STATUS
        filewriteln f_res inputstr
        fileclose f_res
    endif
else
    NG_COUNT = NG_COUNT + 1
    DEV_USER = '-'
endif

getdate TS '%Y/%m/%d %H:%M:%S'
fileopen f_sum SUMMARY_FILE 1
if f_sum <> -1 then
    sprintf '%s,%s,%s,%s,%s,%s,%s,%s' TS DEV_NAME DEV_IP DEV_PROTO PROMPT_SYMBOL DEV_STATUS DEV_DETAIL DEV_USER
    filewriteln f_sum inputstr
    fileclose f_sum
endif

; 次の機器へ進む前にウェイトを挿入
mpause 300
goto read_csv_loop


; ==============================================================================
; 15. 全機器終了処理 & 完了サマリ通知
; ==============================================================================
:end_csv_loop
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif
fileclose f_csv

; マクロ側で新規に踏み台へ接続した場合のみログアウト（既存接続利用時は画面を残す）
if ALREADY_CONNECTED = 0 then
    sendln 'exit'
    disconnect 0
endif

; 手動実行時のみ完了ポップアップを表示 (自動実行時はサイレント終了)
if paramcnt < 3 then
    if NG_COUNT = 0 then
        sprintf 'すべての機器のログ収集が正常に完了しました！\n\n■ 実行結果: 全 %d 台中  成功: %d 台 / 失敗: %d 台\n\n■ サマリCSV:\n%s\n\n■ ログ保存先フォルダ:\n%s' TOTAL_COUNT OK_COUNT NG_COUNT SUMMARY_FILE LOG_DIR
        messagebox inputstr 'ログ収集完了 (全件成功)'
    else
        sprintf 'ログ収集処理が完了しました（一部または全件で接続エラーがあります）。\n\n■ 実行結果: 全 %d 台中  成功: %d 台 / 失敗: %d 台\n\n■ 失敗がある場合のチェックポイント:\n  1. device.csv 内のIPアドレス・ユーザー名・パスワードが実機と合っているか\n     （初期状態ではサンプル用の架空IPが記載されています）\n  2. サマリCSVの「Detail」列に記載された失敗理由をご確認ください:\n     - Connection Failed / Unreachable : IP誤り・電源断・経路なし\n     - Auth Failed (Wrong Password) : パスワード誤り\n     - SSH Algorithm Mismatch : 古い機器のため SSH_EXTRA_OPTS の有効化が必要\n\n■ サマリCSV:\n%s' TOTAL_COUNT OK_COUNT NG_COUNT SUMMARY_FILE
        messagebox inputstr 'ログ収集完了 (要確認あり)'
    endif
endif
end


; ==============================================================================
; 【異常系ハンドラ】踏み台サーバとの通信セッション切断時
; ==============================================================================
:bastion_disconnected
if IS_LOG_OPEN = 1 then
    logclose
    IS_LOG_OPEN = 0
endif
if F_CRED_OPEN = 1 then
    fileclose f_cred
    F_CRED_OPEN = 0
endif
fileclose f_csv

sprintf '【踏み台サーバとの接続が切断されました】'#13#10#13#10
ERROR_MSG = inputstr
sprintf '■ 発生状況:'#13#10'  処理中だった機器: %s (IP: %s)'#13#10'  プロトコル: %s / ステータス: %s (%s)'#13#10#13#10 DEV_NAME DEV_IP DEV_PROTO DEV_STATUS DEV_DETAIL
strconcat ERROR_MSG inputstr
strconcat ERROR_MSG '--------------------------------------------------'#13#10
strconcat ERROR_MSG '【エラーの原因と確認・対処いただきたいポイント】'#13#10#13#10
strconcat ERROR_MSG '1. device.csv のIPアドレスが実在し、到達可能か確認'#13#10
strconcat ERROR_MSG '   サンプルの架空IP (192.168.10.x) のまま実行している場合、'#13#10
strconcat ERROR_MSG '   接続待ちでタイムアウトが連続し、踏み台セッションが切断されます。'#13#10
strconcat ERROR_MSG '   実在する対象機器のIPアドレスに変更してください。'#13#10#13#10
strconcat ERROR_MSG '2. 踏み台サーバ側の自動切断設定 (TMOUT / ClientAlive)'#13#10
strconcat ERROR_MSG '   踏み台サーバ側の環境変数 TMOUT や sshd の設定により、'#13#10
strconcat ERROR_MSG '   一定時間の無通信や待機で自動ログアウトされた可能性があります。'#13#10#13#10
strconcat ERROR_MSG '3. ネットワーク・VPN接続の健全性'#13#10
strconcat ERROR_MSG '   PCから踏み台サーバへのネットワークやVPN接続が切れていないか'#13#10
strconcat ERROR_MSG '   ご確認ください。'#13#10
strconcat ERROR_MSG '--------------------------------------------------'#13#10
sprintf '※切断直前までの実行結果は以下に保存されています:'#13#10'%s' SUMMARY_FILE
strconcat ERROR_MSG inputstr

messagebox ERROR_MSG '踏み台通信切断エラー (原因と対処方法)'
end


; ==============================================================================
; サブルーチン1: 4.0x互換 CSV行パーサー (7列対応・strsplit完全代替・前後空白除去)
; ==============================================================================
:parse_csv_line
    COL1 = ''
    COL2 = ''
    COL3 = ''
    COL4 = ''
    COL5 = ''
    COL6 = ''
    COL7 = ''
    PARSE_STR = line

    ; 1列目 (ホスト名)
    strscan PARSE_STR ','
    if result = 0 goto parse_col1_only
    POS = result
    if POS = 1 then
        COL1 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL1
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 2列目 (IPアドレス)
    strscan PARSE_STR ','
    if result = 0 goto parse_col2_only
    POS = result
    if POS = 1 then
        COL2 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL2
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 3列目 (ユーザー名)
    strscan PARSE_STR ','
    if result = 0 goto parse_col3_only
    POS = result
    if POS = 1 then
        COL3 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL3
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 4列目 (パスワード)
    strscan PARSE_STR ','
    if result = 0 goto parse_col4_only
    POS = result
    if POS = 1 then
        COL4 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL4
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 5列目 (管理者パスワード)
    strscan PARSE_STR ','
    if result = 0 goto parse_col5_only
    POS = result
    if POS = 1 then
        COL5 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL5
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 6列目 (プロトコル: ssh / telnet)
    strscan PARSE_STR ','
    if result = 0 goto parse_col6_only
    POS = result
    if POS = 1 then
        COL6 = ''
    else
        COPY_LEN = POS - 1
        strcopy PARSE_STR 1 COPY_LEN COL6
    endif
    START_POS = POS + 1
    strlen PARSE_STR
    REM_LEN = result - POS
    strcopy PARSE_STR START_POS REM_LEN PARSE_STR

    ; 7列目 (コマンドファイル名)
    COL7 = PARSE_STR
    goto parse_assign

    :parse_col1_only
    COL1 = PARSE_STR
    goto parse_assign

    :parse_col2_only
    COL2 = PARSE_STR
    goto parse_assign

    :parse_col3_only
    COL3 = PARSE_STR
    goto parse_assign

    :parse_col4_only
    COL4 = PARSE_STR
    goto parse_assign

    :parse_col5_only
    COL5 = PARSE_STR
    goto parse_assign

    :parse_col6_only
    COL6 = PARSE_STR

    :parse_assign
    ; 各列の前後の空白・タブ・クォートを綺麗に除去
    TRIM_VAL = COL1
    call trim_string
    DEV_NAME = TRIM_VAL

    TRIM_VAL = COL2
    call trim_string
    DEV_IP = TRIM_VAL

    TRIM_VAL = COL3
    call trim_string
    DEV_USER = TRIM_VAL

    TRIM_VAL = COL4
    call trim_string
    DEV_PASS = TRIM_VAL

    TRIM_VAL = COL5
    call trim_string
    DEV_ENPASS = TRIM_VAL

    TRIM_VAL = COL6
    call trim_string
    DEV_PROTO = TRIM_VAL

    TRIM_VAL = COL7
    call trim_string
    DEV_CMD = TRIM_VAL
return


; ==============================================================================
; サブルーチン2: 文字列前後トリム処理 (空白・タブ・CR・LF・ダブルクォート除去)
; ==============================================================================
:trim_string
    :trim_lead_loop
    strlen TRIM_VAL
    T_LEN = result
    if T_LEN = 0 goto trim_str_done
    strcopy TRIM_VAL 1 1 T_CHAR
    strcompare T_CHAR ' '
    if result = 0 goto cut_lead
    strcompare T_CHAR #9
    if result = 0 goto cut_lead
    strcompare T_CHAR #13
    if result = 0 goto cut_lead
    strcompare T_CHAR #10
    if result = 0 goto cut_lead
    strcompare T_CHAR '"'
    if result = 0 goto cut_lead
    goto trim_tail_str_loop

    :cut_lead
    if T_LEN = 1 then
        TRIM_VAL = ''
        goto trim_str_done
    endif
    T_REM = T_LEN - 1
    strcopy TRIM_VAL 2 T_REM TRIM_VAL
    goto trim_lead_loop

    :trim_tail_str_loop
    strlen TRIM_VAL
    T_LEN = result
    if T_LEN = 0 goto trim_str_done
    strcopy TRIM_VAL T_LEN 1 T_CHAR
    strcompare T_CHAR ' '
    if result = 0 goto cut_tail
    strcompare T_CHAR #9
    if result = 0 goto cut_tail
    strcompare T_CHAR #13
    if result = 0 goto cut_tail
    strcompare T_CHAR #10
    if result = 0 goto cut_tail
    strcompare T_CHAR '"'
    if result = 0 goto cut_tail
    goto trim_str_done

    :cut_tail
    if T_LEN = 1 then
        TRIM_VAL = ''
        goto trim_str_done
    endif
    T_REM = T_LEN - 1
    strcopy TRIM_VAL 1 T_REM TRIM_VAL
    goto trim_tail_str_loop

    :trim_str_done
return


; ==============================================================================
; サブルーチン3: 認証情報キューから次の (ユーザー名, パスワード) ペアを取り出す
; 入力: REMAIN_USERS, REMAIN_PASS, LAST_USER, LAST_PASS
; 出力: CURR_USER, CURR_PASS, LAST_USER, LAST_PASS, HAS_CRED (0:なし, 1:あり)
; ==============================================================================
:pop_next_credential
    HAS_CRED = 0
    NEXT_U = ''
    NEXT_P = ''

    ; --- ユーザー名キューから1件取り出し ---
    strlen REMAIN_USERS
    if result > 0 then
        strscan REMAIN_USERS '|'
        if result = 0 then
            strscan REMAIN_USERS ';'
        endif
        if result > 0 then
            POP_POS = result
            POP_CUT = POP_POS - 1
            if POP_CUT > 0 then
                strcopy REMAIN_USERS 1 POP_CUT NEXT_U
            else
                NEXT_U = ''
            endif
            strlen REMAIN_USERS
            POP_REM = result - POP_POS
            POP_START = POP_POS + 1
            if POP_REM > 0 then
                strcopy REMAIN_USERS POP_START POP_REM REMAIN_USERS
            else
                REMAIN_USERS = ''
            endif
        else
            NEXT_U = REMAIN_USERS
            REMAIN_USERS = ''
        endif
    endif

    ; --- パスワードキューから1件取り出し ---
    strlen REMAIN_PASS
    if result > 0 then
        strscan REMAIN_PASS '|'
        if result = 0 then
            strscan REMAIN_PASS ';'
        endif
        if result > 0 then
            POP_POS = result
            POP_CUT = POP_POS - 1
            if POP_CUT > 0 then
                strcopy REMAIN_PASS 1 POP_CUT NEXT_P
            else
                NEXT_P = ''
            endif
            strlen REMAIN_PASS
            POP_REM = result - POP_POS
            POP_START = POP_POS + 1
            if POP_REM > 0 then
                strcopy REMAIN_PASS POP_START POP_REM REMAIN_PASS
            else
                REMAIN_PASS = ''
            endif
        else
            NEXT_P = REMAIN_PASS
            REMAIN_PASS = ''
        endif
    endif

    ; トリム処理
    TRIM_VAL = NEXT_U
    call trim_string
    NEXT_U = TRIM_VAL

    TRIM_VAL = NEXT_P
    call trim_string
    NEXT_P = TRIM_VAL

    ; ユーザー名・パスワードが共に空なら候補終了
    strlen NEXT_U
    U_LEN = result
    strlen NEXT_P
    P_LEN = result
    if U_LEN = 0 and P_LEN = 0 then
        HAS_CRED = 0
        return
    endif

    ; NEXT_U 内に "user:pass" または "user/pass" 形式のペアが含まれているか判定
    HAS_PAIR = 0
    strscan NEXT_U ':'
    if result > 0 then
        POP_POS = result
        POP_CUT = POP_POS - 1
        if POP_CUT > 0 then
            strcopy NEXT_U 1 POP_CUT CURR_USER
        else
            CURR_USER = ''
        endif
        strlen NEXT_U
        POP_REM = result - POP_POS
        POP_START = POP_POS + 1
        if POP_REM > 0 then
            strcopy NEXT_U POP_START POP_REM CURR_PASS
        else
            CURR_PASS = ''
        endif
        HAS_PAIR = 1
    else
        strscan NEXT_U '/'
        if result > 0 then
            POP_POS = result
            POP_CUT = POP_POS - 1
            if POP_CUT > 0 then
                strcopy NEXT_U 1 POP_CUT CURR_USER
            else
                CURR_USER = ''
            endif
            strlen NEXT_U
            POP_REM = result - POP_POS
            POP_START = POP_POS + 1
            if POP_REM > 0 then
                strcopy NEXT_U POP_START POP_REM CURR_PASS
            else
                CURR_PASS = ''
            endif
            HAS_PAIR = 1
        endif
    endif

    if HAS_PAIR = 0 then
        CURR_USER = NEXT_U
        CURR_PASS = NEXT_P
    endif

    ; 各要素のトリム
    TRIM_VAL = CURR_USER
    call trim_string
    CURR_USER = TRIM_VAL

    TRIM_VAL = CURR_PASS
    call trim_string
    CURR_PASS = TRIM_VAL

    ; ユーザー名が未指定の場合は前回のユーザー名を流用（初回なら踏み台ユーザー名）
    strlen CURR_USER
    if result = 0 then
        strlen LAST_USER
        if result > 0 then
            CURR_USER = LAST_USER
        else
            CURR_USER = BASTION_USER
        endif
    else
        LAST_USER = CURR_USER
    endif

    ; パスワードが未指定の場合は前回のパスワードを流用（初回なら踏み台パスワード）
    strlen CURR_PASS
    if result = 0 then
        strlen LAST_PASS
        if result > 0 then
            CURR_PASS = LAST_PASS
        else
            CURR_PASS = BASTION_PASS
        endif
    else
        LAST_PASS = CURR_PASS
    endif

    HAS_CRED = 1
return


; ==============================================================================
; サブルーチン4: 外部パスワードCSV行パーサー (ユーザー名, パスワード, 管理者パスワード)
; 入力: PARSE_CRED_STR
; 出力: C_USER, C_PASS, C_ENPASS
; ==============================================================================
:parse_cred_line
    C_USER = ''
    C_PASS = ''
    C_ENPASS = ''

    ; 1列目 (ユーザー名) の切り出し
    strscan PARSE_CRED_STR ','
    if result = 0 then
        C_USER = PARSE_CRED_STR
        goto parse_cred_assign
    endif
    PC_POS = result
    PC_CUT = PC_POS - 1
    if PC_CUT > 0 then
        strcopy PARSE_CRED_STR 1 PC_CUT C_USER
    else
        C_USER = ''
    endif
    strlen PARSE_CRED_STR
    PC_REM = result - PC_POS
    PC_START = PC_POS + 1
    if PC_REM > 0 then
        strcopy PARSE_CRED_STR PC_START PC_REM PARSE_CRED_STR
    else
        PARSE_CRED_STR = ''
    endif

    ; 2列目 (パスワード) と 3列目 (管理者パスワード) の切り出し
    strscan PARSE_CRED_STR ','
    if result = 0 then
        C_PASS = PARSE_CRED_STR
        goto parse_cred_assign
    endif
    PC_POS = result
    PC_CUT = PC_POS - 1
    if PC_CUT > 0 then
        strcopy PARSE_CRED_STR 1 PC_CUT C_PASS
    else
        C_PASS = ''
    endif
    strlen PARSE_CRED_STR
    PC_REM = result - PC_POS
    PC_START = PC_POS + 1
    if PC_REM > 0 then
        strcopy PARSE_CRED_STR PC_START PC_REM C_ENPASS
    else
        C_ENPASS = ''
    endif

    :parse_cred_assign
    TRIM_VAL = C_USER
    call trim_string
    C_USER = TRIM_VAL

    TRIM_VAL = C_PASS
    call trim_string
    C_PASS = TRIM_VAL

    TRIM_VAL = C_ENPASS
    call trim_string
    C_ENPASS = TRIM_VAL
return
